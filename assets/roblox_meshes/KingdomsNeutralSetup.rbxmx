<roblox version="4"><Item class="Model" referent="RBXKingdomsNeutralSetup"><Properties><string name="Name">KingdomsNeutralSetup</string></Properties><Item class="ModuleScript" referent="RBXNeutralInstaller"><Properties><string name="Name">NeutralInstaller</string><ProtectedString name="Source">-- Studio-only incremental repair. Existing uploaded meshes keep their IDs.
local Setup={}
function Setup.Install()
    local Run=game:GetService('RunService')
    assert(Run:IsStudio()and not Run:IsRunning(),'Stop the playtest before installing models.')
    local root=game:GetService('ReplicatedStorage'):FindFirstChild('Kingdoms')
    local templates=root and root:FindFirstChild('MeshTemplates')
    assert(templates and templates:GetAttribute('Complete'),'Install the main mesh catalogue first.')
    local runtime=script.Parent.Runtime
    local catalog=require(runtime.MeshCatalog)
    local expected={};local count=0
    local function uploaded(part)
        if not part or not part:IsA('MeshPart')then return false end
        local id=part.MeshId:match('rbxassetid://(%d+)')or part.MeshId:match('[?&amp;]id=(%d+)')
        return id and tonumber(id)&gt;0
    end
    for name,data in catalog.Models do
        local keys={name};if data.Team then table.insert(keys,name..'__Blue');table.insert(keys,name..'__Red')end
        for _,key in keys do assert(uploaded(templates:FindFirstChild(key)),'Existing mesh missing: '..key);count+=1 end
        if data.Neutral then expected[name..'__Neutral']=data;count+=1 end
    end
    local found={};local roots={}
    for _,part in workspace:GetDescendants()do
        if part:IsA('MeshPart')and expected[part.Name]then
            assert(not found[part.Name],'Duplicate neutral mesh: '..part.Name)
            assert(not templates:FindFirstChild(part.Name),'Neutral mesh already installed: '..part.Name)
            assert(uploaded(part),'Neutral mesh not uploaded: '..part.Name)
            found[part.Name]=part
            local ancestor=part:FindFirstAncestor('KingdomsMeshCatalogue');if ancestor then roots[ancestor]=true end
        end
    end
    for key in expected do assert(found[key],'Missing neutral mesh: '..key)end
    local names={'Art','MeshCatalog'};local old={};local copies={}
    for i,name in names do old[i]=root:FindFirstChild(name);assert(old[i]and runtime:FindFirstChild(name),'Missing game module: '..name)end
    local attributes={CatalogSignature=templates:GetAttribute('CatalogSignature'),Complete=templates:GetAttribute('Complete'),MeshCount=templates:GetAttribute('MeshCount')}
    local backup=Instance.new('Folder');backup.Name='KingdomsBeforeNeutralFix_'..game:GetService('HttpService'):GenerateGUID(false)
    local stage=Instance.new('Folder');local parts={}
    local function vector(v)return Vector3.new(v[1],v[2],v[3])end
    local moved=false
    local ok,reason=pcall(function()
        for key,data in expected do
            local source=found[key];local part=source:Clone();part.Parent=stage;table.insert(parts,part)
            part.Size=vector(data.Maximum)-vector(data.Minimum)
            part:SetAttribute('Center',(vector(data.Minimum)+vector(data.Maximum))/2)
            part:SetAttribute('Minimum',vector(data.Minimum));part:SetAttribute('Maximum',vector(data.Maximum))
            part:SetAttribute('Joint',vector(data.Joint));part:SetAttribute('Tint',data.Tint)
            part:SetAttribute('MeshKey',key);part:SetAttribute('MeshRotation',source.CFrame.Rotation)
            part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
            part.Transparency=0;part.Color=Color3.new(1,1,1);part.Material=Enum.Material.SmoothPlastic;part.CFrame=CFrame.identity
        end
        for i,name in names do copies[i]=runtime[name]:Clone();copies[i].Parent=stage end
        backup.Parent=game:GetService('ServerStorage');moved=true
        for i,item in old do item.Parent=backup;copies[i].Parent=root end
        for _,part in parts do part.Parent=templates end
        templates:SetAttribute('CatalogSignature',catalog.Signature);templates:SetAttribute('Complete',true);templates:SetAttribute('MeshCount',count)
    end)
    if not ok then
        if moved then
            for _,item in old do item.Parent=root end
            for key,value in attributes do templates:SetAttribute(key,value)end
        end
        for _,copy in copies do copy:Destroy()end
        for _,part in parts do part:Destroy()end
        stage:Destroy();backup:Destroy();error(reason)
    end
    stage:Destroy()
    for ancestor in roots do ancestor.Parent=backup end
    script.Parent.Parent=backup
    print('Neutral repair installed: '..#parts..' new meshes; '..count..' total. Backup: ServerStorage.'..backup.Name)
    return {Added=#parts,Models=count,Backup=backup.Name,Signature=catalog.Signature}
end
return Setup
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXRuntime"><Properties><string name="Name">Runtime</string></Properties><Item class="ModuleScript" referent="RBXArt"><Properties><string name="Name">Art</string><ProtectedString name="Source">-- Ordinary uploaded MeshParts; geometry is never generated during gameplay.
local Styles=require(script.Parent.SkinStyles)
local Catalog=require(script.Parent.MeshCatalog)
local Config=require(script.Parent.Config)
local Art={Cache={},Modules=Catalog.Models,Clones={},BoundsCache={}}
local function vector(v)return Vector3.new(v[1],v[2],v[3])end
local function hex(s)return Color3.fromRGB(tonumber(s:sub(2,3),16),tonumber(s:sub(4,5),16),tonumber(s:sub(6,7),16))end
function Art.Prepare()
    local templates=script.Parent:FindFirstChild('MeshTemplates')
    assert(templates and templates:GetAttribute('CatalogSignature')==Catalog.Signature and templates:GetAttribute('Complete')==true,
        'Imported models are not installed. Run KingdomsMeshSetup.Installer in Studio before publishing.')
    Art.Templates=templates
end
function Art.TeamKey(name,color)
    if not Catalog.Models[name].Team then return name end
    for i,label in {'Blue','Red','Neutral'}do
        local team=Config.Colors[i]
        if (i&lt;3 or Catalog.Models[name].Neutral)and math.abs(color.R-team.R)&lt;.0001 and math.abs(color.G-team.G)&lt;.0001 and math.abs(color.B-team.B)&lt;.0001 then return name..'__'..label end
    end
    error('Unsupported army team colour for '..name)
end
function Art.Ensure(name,skin,teamColor,unitSkin)
    local data=Catalog.Models[name];assert(data,'Missing model metadata: '..name)
    local key=unitSkin and teamColor and Art.TeamKey(name,teamColor)or name
    if Art.Cache[key]then return Art.Cache[key]end
    if not Art.Templates then Art.Prepare()end
    local part=Art.Templates:FindFirstChild(key)
    assert(part and part:IsA('MeshPart'),'Missing imported model: '..key)
    assert(part.MeshId~='','Mesh has not been uploaded: '..key)
    Art.Cache[key]=part;Art.Clones[key]={}
    return part
end
function Art.Bounds(name)
    if Art.BoundsCache[name]then return Art.BoundsCache[name]end
    local data=Catalog.Models[name];assert(data,'Missing model metadata: '..name)
    local result={Minimum=vector(data.Minimum),Maximum=vector(data.Maximum)}
    Art.BoundsCache[name]=result;return result
end
function Art.Prune()
    -- Templates stay intact; Roblox shares their uploaded meshes across clones.
    for key in Art.Cache do
        local used=false
        for clone in Art.Clones[key]or {}do
            if clone.Parent then used=true else Art.Clones[key][clone]=nil end
        end
        if not used then Art.Cache[key]=nil;Art.Clones[key]=nil end
    end
end
function Art.Clone(name,parent,root,teamColor,skin,unitSkin)
    local template=Art.Ensure(name,skin,teamColor,unitSkin)
    local part=template:Clone();local key=template.Name
    Art.Clones[key][part]=true
    part.CFrame=(root or CFrame.identity)*CFrame.new(part:GetAttribute('Joint')+part:GetAttribute('Center'))*(part:GetAttribute('MeshRotation')or CFrame.identity)
    if teamColor and part:GetAttribute('Tint')then part.Color=teamColor end
    if skin and skin~='Default'then part.Color=hex(Styles.Get(skin).Cloth):Lerp(Color3.new(1,1,1),.45)end
    part.Name=name;part.Parent=parent
    return part
end
function Art.Unit(kind,parent,color,skin)
    local model=Instance.new('Model');model.Name=kind
    local ok,reason=pcall(function()
        for _,limb in {'Torso','Head','LeftArm','RightArm','LeftLeg','RightLeg'}do
            local prefix=skin and skin~='Default'and skin..'_'or ''
            local name=prefix..kind..'_'..limb
            if not Art.Modules[name]then name=kind..'_'..limb end
            local part=Art.Clone(name,model,CFrame.identity,color,nil,skin or 'Default');part.Name=limb
        end
        local badgeName=(skin and skin~='Default'and skin..'_'or '')..kind..'_Insignia'
        if Art.Modules[badgeName]then local badge=Art.Clone(badgeName,model,CFrame.identity,color);badge.Name='Insignia'end
    end)
    if not ok then model:Destroy();Art.Prune();error(reason)end
    model.Parent=parent;return model
end
function Art.Pose(model,root,phase,moving,attacking)
    root*=CFrame.Angles(0,math.pi,0)
    for _,part in model:GetChildren()do
        if not part:IsA('BasePart')then continue end
        local angle=0
        if moving then
            if part.Name=='LeftLeg'or part.Name=='RightArm'then angle=math.sin(phase)*.38
            elseif part.Name=='RightLeg'or part.Name=='LeftArm'then angle=-math.sin(phase)*.38 end
        end
        if attacking and part.Name=='RightArm'then angle=-1.1+math.sin(phase*2)*.5 end
        part.CFrame=root*CFrame.new(part:GetAttribute('Joint'))*CFrame.Angles(angle,0,0)*CFrame.new(part:GetAttribute('Center'))*(part:GetAttribute('MeshRotation')or CFrame.identity)
    end
end
return Art
