        local v=workspace.CurrentCamera.ViewportSize;local short=v.Y&lt;480
        local w=math.min(420,v.X-32);local height=short and math.min(276,v.Y-80) or (u.Page=='Settings' and 490 or u.Return.Visible and 440 or 402)
