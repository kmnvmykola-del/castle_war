<roblox version="4"><Item class="Model" referent="RBXKingdomsReleaseSetup"><Properties><string name="Name">KingdomsReleaseSetup</string></Properties><Item class="ModuleScript" referent="RBXInstaller"><Properties><string name="Name">Installer</string><ProtectedString name="Source">-- Guarded, reversible source update. Uploaded meshes and remotes stay in place.
local Setup={}
function Setup.Install()
    local run=game:GetService('RunService')
    assert(run:IsStudio()and not run:IsRunning(),'Stop the playtest before installing the release.')
    local root=game:GetService('ReplicatedStorage'):FindFirstChild('Kingdoms')
    assert(root and root:FindFirstChild('MeshTemplates')and root.MeshTemplates:GetAttribute('Complete')==true,'Install the uploaded mesh catalogue first.')
    local server=game:GetService('ServerScriptService'):FindFirstChild('KingdomsServer')
    local client=game:GetService('StarterPlayer').StarterPlayerScripts:FindFirstChild('KingdomsClient')
    assert(server and client,'Missing active script containers.')
    local payload=script.Parent:FindFirstChild('Runtime');assert(payload,'Missing release source payload.')
    local changes={};local seen={}
    for _,source in payload:GetChildren()do
        assert(source:IsA('LuaSourceContainer')and not seen[source.Name],'Invalid or duplicate release module.')
        seen[source.Name]=true
        local parent=source.Name=='Server'and server or source.Name=='Client'and client or root
        local name=source.Name
        local previous=parent:FindFirstChild(name)
        if previous then assert(previous.ClassName==source.ClassName,'Source type mismatch: '..name)end
        local copy=source:Clone();copy.Name=name
        if copy:IsA('Script')or copy:IsA('LocalScript')then copy.Disabled=true end
        local wasDisabled=nil
        if previous and (previous:IsA('Script')or previous:IsA('LocalScript'))then wasDisabled=previous.Disabled end
        table.insert(changes,{Parent=parent,Previous=previous,Copy=copy,Disabled=wasDisabled})
    end
    assert(seen.Server and seen.Client and seen.BattleGuide and seen.Progression and seen.SkinStyles and seen.AudioCatalog,'Incomplete release source payload.')
    local backup=Instance.new('Folder');backup.Name='KingdomsBeforeRelease_'..game:GetService('HttpService'):GenerateGUID(false);backup.Parent=game:GetService('ServerStorage')
    local ok,reason=pcall(function()
        for _,change in changes do
            if change.Previous then
                if change.Previous:IsA('Script')or change.Previous:IsA('LocalScript')then change.Previous.Disabled=true end
                change.Previous.Parent=backup
            end
            change.Copy.Parent=change.Parent
        end
        for _,change in changes do if change.Copy:IsA('Script')or change.Copy:IsA('LocalScript')then change.Copy.Disabled=false end end
    end)
    if not ok then
        for _,change in changes do
            change.Copy:Destroy()
            if change.Previous then
                change.Previous.Parent=change.Parent
                if change.Disabled~=nil then change.Previous.Disabled=change.Disabled end
            end
        end
        backup:Destroy();error(reason)
    end
    root:SetAttribute('ReleaseVersion','0.15')
    script.Parent.Parent=backup
    print('KINGDOMS_RELEASE_INSTALLED '..#changes..' sources; uploaded meshes preserved. Backup: ServerStorage.'..backup.Name)
end
return Setup
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXRuntime"><Properties><string name="Name">Runtime</string></Properties><Item class="ModuleScript" referent="RBXAccountServer"><Properties><string name="Name">AccountServer</string><ProtectedString name="Source">local Players=game:GetService('Players')
local DSS=game:GetService('DataStoreService')
local Market=game:GetService('MarketplaceService')
local Run=game:GetService('RunService')
local P=require(script.Parent.Progression)
local Data=require(script.Parent.PlayerData)
local Account={};Account.__index=Account
function Account.new(root,notify)
    local function remote(name)local r=root:FindFirstChild(name)or Instance.new('RemoteEvent');r.Name=name;r.Parent=root;return r end
    local self=setmetatable({Changed=remote('Account'),Actions=remote('AccountAction'),Notify=notify,Pending={},Loading={},Owners={},Cooldown={},Names={},ChestEligibility={},PassPrompt={}},Account)
    local stores={}
    if not Run:IsStudio()then
        stores.Store=DSS:GetDataStore('KingdomsMapsV1');stores.Wins=DSS:GetOrderedDataStore('KingdomsWinsV1');stores.Rank=DSS:GetOrderedDataStore('KingdomsRankV1');stores.Inbox=DSS:GetDataStore('KingdomsResultInboxV1')
    end
    self.Data=Data.new(stores)
    self.Actions.OnServerEvent:Connect(function(player,action,payload)
        if typeof(action)~='string'or typeof(payload)~='table'then return end
        local now=os.clock();self.Cooldown[player]=self.Cooldown[player]or {}
        local cooldownKey=action=='Board'and action..tostring(payload.Kind)or action
        local previous=self.Cooldown[player][cooldownKey]or 0
        if now-previous&lt;(action=='Board'and 5 or .4)then return end;self.Cooldown[player][cooldownKey]=now
        local d=self:Profile(player);if not d then self.Notify(player,'Your profile is still loading.');if action=='OpenChest'then self.Changed:FireClient(player,{ChestDone=true})end;return end
        if action=='Board'then
            local board,reason=self.Data:Board(payload.Kind,player.UserId)
            if board then
                local ids={};for _,entry in board.Entries do if entry.UserId&gt;0 and not self.Names[entry.UserId]then table.insert(ids,entry.UserId)end end
                if #ids&gt;0 then
                    local found,users=pcall(function()return game:GetService('UserService'):GetUserInfosByUserIdsAsync(ids)end)
                    if found then for _,user in users do self.Names[user.Id]=user.DisplayName end end
                end
                for _,entry in board.Entries do
                    local p=Players:GetPlayerByUserId(entry.UserId);entry.Name=p and p.DisplayName or self.Names[entry.UserId]or tostring(entry.UserId)
                end
                self.Changed:FireClient(player,{Board=board})
            else self.Notify(player,reason)end
        elseif action=='OpenChest'then
            local ok,result=self:OpenChest(player,payload)
            if ok then self:Publish(player,nil,result)else self.Notify(player,result);self:Publish(player);self.Changed:FireClient(player,{ChestDone=true})end
        elseif action=='Premium'then
            local ok,message=self:BuyPremium(player,payload.Skin);self.Notify(player,message)
        elseif action=='Buy'or action=='Equip'then
            if typeof(payload.Skin)~='string'then return end
            local ok,message
            if action=='Buy'then ok,message=self.Data:Buy(player.UserId,payload.Skin)else ok,message=self.Data:Equip(player.UserId,payload.Skin)end
            self.Notify(player,message);if ok then self:Publish(player)end
        elseif action=='Coins'then
            local product=P.Product(payload.Product)
            if not product or product.ProductId&lt;=0 or Run:IsStudio()then self.Notify(player,'Robux purchases become available after the game is published.');return end
            local ok=pcall(function()Market:PromptProductPurchase(player,product.ProductId)end)
            if not ok then self.Notify(player,'The purchase window is temporarily unavailable.')end
        elseif action=='Refresh'then self:Publish(player);task.spawn(function()self:ReconcilePasses(player)end)end
    end)
    Market.PromptGamePassPurchaseFinished:Connect(function(player,passId,purchased)
        if self.PassPrompt[player]==passId then self.PassPrompt[player]=nil end
        if not purchased then return end
        for _,skin in P.Skins do if skin.GamePassId and skin.GamePassId&gt;0 and skin.GamePassId==passId then
            task.spawn(function()
                for attempt=1,4 do
                    if not self:Profile(player)then return end
                    local ok=self:VerifyPass(player,skin.Id)
                    if ok then return end
                    task.wait(attempt*2)
                end
                if player.Parent then self.Notify(player,'Roblox saved your purchase. Refresh your profile to receive the set.')end
            end)
            break
        end end
    end)
    Market.ProcessReceipt=function(receipt)return self:ProcessReceipt(receipt)end
    game:BindToClose(function()local untilTime=os.clock()+25;while next(self.Pending)and os.clock()&lt;untilTime do task.wait(.1)end end)
    return self
end
function Account:VerifyPass(player,skinId)
    local skin=P.Skin(skinId)
    if not skin or not skin.GamePassId or skin.GamePassId&lt;=0 then return false,'This set will be available for purchase soon.'end
    if not self:Profile(player)then return false,'Your profile is still loading.'end
    local market=self.Market or Market
    local ok,owned=pcall(function()return market:UserOwnsGamePassAsync(player.UserId,skin.GamePassId)end)
    if not ok then return false,'Could not verify your Roblox purchase. Please try again.'end
    if not owned then return false,'Roblox has not confirmed this purchase yet.'end
    if not self:Profile(player)then return false,'Your profile is still loading.'end
    local saved,result=self.Data:GrantPass(player.UserId,skinId)
    if saved then self:Publish(player);if not result.AlreadyApplied then self.Notify(player,'Full set unlocked: '..skin.Name)end end
    return saved,result
end
function Account:ReconcilePasses(player)
    for _,skin in P.Skins do
        local d=self:Profile(player);if not d then return end
        if skin.GamePassId and skin.GamePassId&gt;0 and not d.Skins[skin.Id]then self:VerifyPass(player,skin.Id)end
    end
end
function Account:BuyPremium(player,skinId)
    local skin=P.Skin(skinId);local d=self:Profile(player)
    if not skin or not skin.RobuxPrice or not d then return false,'Select a premium set.'end
    if d.Skins[skinId]then return false,'This set is already in your inventory.'end
    if self.PassPrompt[player]then return false,'Finish the current purchase first.'end
    if Run:IsStudio()or not skin.GamePassId or skin.GamePassId&lt;=0 then return false,'Robux purchases are coming soon. You can already unlock this set from a chest.'end
    local ok,owned=pcall(function()return Market:UserOwnsGamePassAsync(player.UserId,skin.GamePassId)end)
    if not ok then return false,'Could not verify your Roblox purchase.'end
    if owned then local saved=self:VerifyPass(player,skinId);return saved,saved and 'Set added to your inventory.'or 'Your purchase is waiting to be saved. Refresh your profile.'end
    if not self:Profile(player)or self:Profile(player).Skins[skinId]then return false,'This set is already unlocked or your profile is unavailable.'end
    self.PassPrompt[player]=skin.GamePassId
    local prompted=pcall(function()Market:PromptGamePassPurchase(player,skin.GamePassId)end)
    if not prompted then self.PassPrompt[player]=nil;return false,'The purchase window is temporarily unavailable.'end
    return true,'Confirm your purchase in the Roblox window.'
end
function Account:OpenChest(player,payload)
    if self.PassPrompt and self.PassPrompt[player]then return false,'Finish the Roblox purchase first.'end
    if self.ChestEligibility[player]~=true then return false,'Random purchases are unavailable for this account.'end
    if not self:Profile(player)then return false,'Your profile is still loading.'end
    return self.Data:OpenChest(player.UserId,payload.RequestId,payload.Signature)
end
function Account:ProcessReceipt(receipt)
    local product
    for _,item in P.Products do if item.ProductId&gt;0 and item.ProductId==receipt.ProductId then product=item;break end end
    local player=self.FindPlayer and self.FindPlayer(receipt.PlayerId)or Players:GetPlayerByUserId(receipt.PlayerId)
    if not product or not player or not self.Data.Profiles[receipt.PlayerId]or self.Owners and self.Owners[receipt.PlayerId]~=player or not self.Data.S.Store then return Enum.ProductPurchaseDecision.NotProcessedYet end
    local ok,result=self.Data:Receipt(receipt.PlayerId,tostring(receipt.PurchaseId),product.Coins)
    if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
    self:Publish(player);if not result.AlreadyApplied then self.Notify(player,'Coins added: '..product.Coins)end
    return Enum.ProductPurchaseDecision.PurchaseGranted
end
function Account:Load(player)
    if self.Loading[player]then return nil end;self.Loading[player]=true
    local d,reason=self.Data:Load(player.UserId,true)
    if d then
        if self.Data:Recover(player.UserId)then d=self.Data.Profiles[player.UserId]
        else d=nil;reason='Could not restore your rewards. Select Refresh Profile.'end
    end
    self.Loading[player]=nil
    if d then
        self.Owners[player.UserId]=player
        if Run:IsStudio()then self.ChestEligibility[player]=true
        else
            self.ChestEligibility[player]=nil
            task.spawn(function()
                local ok,policy=pcall(function()return game:GetService('PolicyService'):GetPolicyInfoForPlayerAsync(player)end)
                self.ChestEligibility[player]=ok and policy.ArePaidRandomItemsRestricted==false
                self:Publish(player)
            end)
        end
        self:Publish(player);task.spawn(function()self.Data:Project(player.UserId)end);task.spawn(function()self:ReconcilePasses(player)end)
    else self.Notify(player,reason)end
    return d
end
function Account:Profile(player)
    return self.Owners[player.UserId]==player and not self.Loading[player]and self.Data.Profiles[player.UserId]or nil
end
function Account:Publish(player,reward,chest)
    if not player.Parent then return end
    local d=self.Data.Profiles[player.UserId];if not d then return end
    local leader=player:FindFirstChild('leaderstats')or Instance.new('Folder');leader.Name='leaderstats';leader.Parent=player
    for name,value in {['Level']=d.Level,['Rank']=d.Rank,['Wins']=d.Wins}do
        local item=leader:FindFirstChild(name)or Instance.new('IntValue');item.Name=name;item.Value=value;item.Parent=leader
    end
    player:SetAttribute('KingdomLevel',d.Level);player:SetAttribute('KingdomRank',d.Rank)
    local pool,signature=P.ChestPool(d);local rewards=P.ChestRewards(d)
    self.Changed:FireClient(player,{Profile=P.Public(d),Reward=reward,Persistent=self.Data.S.Store~=nil,Chest=chest,ChestDone=chest~=nil,ChestInfo={Allowed=self.ChestEligibility[player]==true,Pending=self.ChestEligibility[player]==nil,Pool=pool,Rewards=rewards,Signature=signature,Price=P.ChestPrice,Complete=P.CollectionCount(d)==#P.Skins}})
end
function Account:Complete(session)
    for player,side in session.Participants do
        local result={Id=session.Id,At=os.time(),Won=session.State.Winner==side,Mode=session.Mode,Difficulty=session.State.Difficulty,Forfeit=session.Forfeits[side]==true}
        local key=player.UserId..':'..result.Id;self.Pending[key]=player.UserId
        task.spawn(function()
            local delay=1
            while self.Pending[key]do
                local ok,reward=self.Data:Deliver(player.UserId,result)
                if ok then
                    self.Pending[key]=nil;self:Publish(Players:GetPlayerByUserId(player.UserId)or player,reward);self.Data:Project(player.UserId)
                    if not Players:GetPlayerByUserId(player.UserId)then self:Release(player)end
                    break
                end
                if player.Parent then self.Notify(player,'Saving your reward. Retrying…')end
                task.wait(delay);delay=math.min(delay*2,30)
            end
        end)
    end
end
function Account:Release(player)
    for _,id in self.Pending do if id==player.UserId then return end end
    if Players:GetPlayerByUserId(player.UserId)then return end
    self.Data.Profiles[player.UserId]=nil;self.Owners[player.UserId]=nil;self.Cooldown[player]=nil
    self.ChestEligibility[player]=nil;self.PassPrompt[player]=nil
end
function Account:Await(player)
    local untilTime=os.clock()+10
    repeat
        local pending=false;for _,id in self.Pending do if id==player.UserId then pending=true;break end end
        if not pending then return true end;task.wait(.1)
    until os.clock()&gt;=untilTime
    return false
end
return Account
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXArt"><Properties><string name="Name">Art</string><ProtectedString name="Source">-- Ordinary uploaded MeshParts; geometry is never generated during gameplay.
local Styles=require(script.Parent.SkinStyles)
local Catalog=require(script.Parent.MeshCatalog)
local Config=require(script.Parent.Config)
local Art={Cache={},Modules=Catalog.Models,Clones={},BoundsCache={}}
local function vector(v)return Vector3.new(v[1],v[2],v[3])end
-- glTF import changes the handedness of Z; retain authored pivots and origins.
local function importedOffset(v)return Vector3.new(v.X,v.Y,-v.Z)end
local function hex(s)return Color3.fromRGB(tonumber(s:sub(2,3),16),tonumber(s:sub(4,5),16),tonumber(s:sub(6,7),16))end
function Art.Prepare()
    local templates=script.Parent:FindFirstChild('MeshTemplates')
    assert(templates and templates:GetAttribute('CatalogSignature')==Catalog.Signature and templates:GetAttribute('Complete')==true,
        'Imported models are not installed. Run KingdomsMeshSetup.Installer in Studio before publishing.')
    Art.Templates=templates
end
function Art.TeamKey(name,color)
    if not Catalog.Models[name].Team then return name end
    for i,label in {'Blue','Red','Neutral'}do
        local team=Config.Colors[i]
        if (i&lt;3 or Catalog.Models[name].Neutral)and math.abs(color.R-team.R)&lt;.0001 and math.abs(color.G-team.G)&lt;.0001 and math.abs(color.B-team.B)&lt;.0001 then return name..'__'..label end
    end
    error('Unsupported army team colour for '..name)
end
function Art.Ensure(name,skin,teamColor,unitSkin)
    local data=Catalog.Models[name];assert(data,'Missing model metadata: '..name)
    local key=unitSkin and teamColor and Art.TeamKey(name,teamColor)or name
    if Art.Cache[key]then return Art.Cache[key]end
    if not Art.Templates then Art.Prepare()end
    local part=Art.Templates:FindFirstChild(key)
    assert(part and part:IsA('MeshPart'),'Missing imported model: '..key)
    assert(part.MeshId~='','Mesh has not been uploaded: '..key)
    Art.Cache[key]=part;Art.Clones[key]={}
    return part
end
function Art.Bounds(name)
    if Art.BoundsCache[name]then return Art.BoundsCache[name]end
    local data=Catalog.Models[name];assert(data,'Missing model metadata: '..name)
    local low,high=vector(data.Minimum),vector(data.Maximum)
    local result={Minimum=Vector3.new(low.X,low.Y,-high.Z),Maximum=Vector3.new(high.X,high.Y,-low.Z)}
    Art.BoundsCache[name]=result;return result
end
function Art.Prune()
    -- Templates stay intact; Roblox shares their uploaded meshes across clones.
    for key in Art.Cache do
        local used=false
        for clone in Art.Clones[key]or {}do
            if clone.Parent then used=true else Art.Clones[key][clone]=nil end
        end
        if not used then Art.Cache[key]=nil;Art.Clones[key]=nil end
    end
end
function Art.Clone(name,parent,root,teamColor,skin,unitSkin)
    local template=Art.Ensure(name,skin,teamColor,unitSkin)
    local part=template:Clone();local key=template.Name
    Art.Clones[key][part]=true
    part:SetAttribute('Center',importedOffset(part:GetAttribute('Center')))
    part:SetAttribute('Joint',importedOffset(part:GetAttribute('Joint')))
    part.CFrame=(root or CFrame.identity)*CFrame.new(part:GetAttribute('Joint')+part:GetAttribute('Center'))*(part:GetAttribute('MeshRotation')or CFrame.identity)
    if teamColor and part:GetAttribute('Tint')then part.Color=teamColor end
    if skin and skin~='Default'and not name:match('^'..skin..'_')then part.Color=hex(Styles.Get(skin).Cloth):Lerp(Color3.new(1,1,1),.45)end
    part.Name=name;part.Parent=parent
    return part
end
function Art.Unit(kind,parent,color,skin)
    local model=Instance.new('Model');model.Name=kind
    local ok,reason=pcall(function()
        for _,limb in {'Torso','Head','LeftArm','RightArm','LeftLeg','RightLeg'}do
            local prefix=skin and skin~='Default'and skin..'_'or ''
            local name=prefix..kind..'_'..limb
            if not Art.Modules[name]then name=kind..'_'..limb end
            local part=Art.Clone(name,model,CFrame.identity,color,nil,skin or 'Default');part.Name=limb
        end
        local badgeName=(skin and skin~='Default'and skin..'_'or '')..kind..'_Insignia'
        if Art.Modules[badgeName]then local badge=Art.Clone(badgeName,model,CFrame.identity,color);badge.Name='Insignia'end
    end)
    if not ok then model:Destroy();Art.Prune();error(reason)end
    model.Parent=parent;return model
end
function Art.Pose(model,root,phase,moving,attacking)
    -- Studio's imported characters face -Z, the direction of CFrame.lookAt.
    for _,part in model:GetChildren()do
        if not part:IsA('BasePart')then continue end
        local angle=0
        if moving then
            if part.Name=='LeftLeg'or part.Name=='RightArm'then angle=math.sin(phase)*.38
            elseif part.Name=='RightLeg'or part.Name=='LeftArm'then angle=-math.sin(phase)*.38 end
        end
        if attacking and part.Name=='RightArm'then angle=-1.1+math.sin(phase*2)*.5 end
        part.CFrame=root*CFrame.new(part:GetAttribute('Joint'))*CFrame.Angles(angle,0,0)*CFrame.new(part:GetAttribute('Center'))*(part:GetAttribute('MeshRotation')or CFrame.identity)
    end
end
return Art
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXAudioCatalog"><Properties><string name="Name">AudioCatalog</string><ProtectedString name="Source">-- Original WAV files: assets/audio/original. Set Id after uploading to Roblox.
-- Public fallback assets keep audio working while the originals await IDs.
return {
    Music={
        Menu={Id=119718967994975,Name='Frontier Dawn',File='menu.wav',FallbackId=1847223666,Gain=.68},
        Battle={Id=124112194729458,Name='March of the Banners',File='battle.wav',FallbackId=9045862008,Gain=.58},
    },
    FallbackMusic=93176902923482,
    Effects={
        Click={Id=120162779880223,File='click.wav',FallbackId=113397864512278,Gain=.30,Speed=1,Gap=.09},
        Select={Id=124159972087187,File='select.wav',FallbackId=113397864512278,Gain=.42,Speed=.86,Gap=.10},
        Order={Id=123835389545068,File='order.wav',FallbackId=113397864512278,Gain=.38,Speed=1.13,Gap=.12},
        Place={Id=112056872756115,File='place.wav',FallbackId=113397864512278,Gain=.38,Speed=.72,Gap=.10},
        Error={Id=82716831723745,File='error.wav',FallbackId=113397864512278,Gain=.30,Speed=.65,Gap=.30},
        Chest={Id=123191148517154,File='chest.wav',FallbackId=113397864512278,Gain=.45,Speed=1.2,Gap=.50},
        Victory={Id=83900946007025,File='victory.wav',FallbackId=113397864512278,Gain=.48,Speed=1.15,Gap=1},
        Defeat={Id=115137529677758,File='defeat.wav',FallbackId=113397864512278,Gain=.40,Speed=.7,Gap=1},
    },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBattleGuide"><Properties><string name="Name">BattleGuide</string><ProtectedString name="Source">-- Client-only onboarding observes real actions without changing the match.
local Guide={};Guide.__index=Guide
function Guide.new()
    return setmetatable({Active=false,Step=1,Target=nil,Baseline={}},Guide)
end
function Guide:Begin(snapshot)
    if self.Active then return end
    self.Active=true;self.Step=1;self.Target=nil;self.Side=snapshot.ViewerSide
    self.Baseline={};for id,site in snapshot.Sites do self.Baseline[id]=site.Owner end
end
function Guide:Select(owner)
    if self.Active and self.Step==1 and owner==self.Side then self.Step=2 end
end
function Guide:Order(id,owner)
    if self.Active and self.Step==2 and owner~=self.Side then self.Target=id end
end
function Guide:Observe(snapshot)
    if not self.Active then return false end
    if self.Target and self.Step==2 then
        for _,unit in snapshot.Units do if unit[3]==self.Side then self.Step=3;break end end
    end
    if self.Target and self.Baseline[self.Target]~=self.Side and snapshot.Sites[self.Target]and snapshot.Sites[self.Target].Owner==self.Side then
        self.Active=false;return true
    end
    return false
end
function Guide:Close()self.Active=false;self.Target=nil end
return Guide
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXClient"><Properties><string name="Name">Client</string><ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local Debris=game:GetService('Debris')
local GuiService=game:GetService('GuiService')
local player=Players.LocalPlayer
local root=RS:WaitForChild('Kingdoms')
local Config=require(root.Config)
local Network=require(root.MapNetwork)
local Default=require(root.MapData)
local Catalog=require(root.MapCatalog)
local Scene=require(root.Scene)
local Art=require(root.Art)
local UI=require(root.UI)
local Editor=require(root.MapEditor)
local Music=require(root.Music)
local Meta=require(root.MetaUI)
local Progression=require(root.Progression)
local BattleGuide=require(root.BattleGuide)
local command=root:WaitForChild('Command')
local camera=workspace.CurrentCamera
local state,scene,editor=nil,nil,nil
local function viewSide()local side=state and state.ViewerSide or player:GetAttribute('KingdomSide');return side==2 and 2 or 1 end
local editorActive,loaded,custom=false,false,false
local editorRenderBusy,pendingEditorRender=false,nil
local renderedEditor,renderedEditorRevision=nil,-1
local tutorialShown=false
local savedMap,revision=nil,-1
local chosenMap='TwoBridges'
local selected,primary={},nil
local percent,orderMode=50,false
local prefs={Music=.22,Effects=.55,Camera=1,Zoom=1,Grid=false,Labels=true,BattleTutorialDone=false}
local guide=BattleGuide.new()
local preferencesLoaded=false
local center,targetCenter=Vector3.zero,Vector3.zero
local zoom,targetZoom=300,300
local visuals,highlights,labels,previews={},{},{},{}
local ghost,previewUntil,toastUntil=nil,0,0
local hooks={}
local u=UI.Build(player,hooks)
local meta=Meta.Build(u,hooks)
if Run:IsStudio()then _G.KingdomsMeta=meta end
local accountAction=root:WaitForChild('AccountAction')
local sound=Music.Start()
UI.PlaySound=sound.PlayEffect
local world=Instance.new('ScreenGui');world.Name='KingdomsWorldLabels';world.ResetOnSpawn=false;world.DisplayOrder=-1;world.Parent=player.PlayerGui
local function playing()return state and (state.Phase=='Preparation' or state.Phase=='Battle')end
local function canControl()return loaded and not editorRenderBusy and not u.Menu.Visible and not u.Code.Visible and not u.Tutorial.Visible and (playing() or editorActive)end
local function notify(text)u.ToastText.Text=tostring(text);u.Toast.Visible=true;toastUntil=os.clock()+5 end
local function clearPreviews()for _,p in previews do p:Destroy()end;previews={}end
local function clearHighlights()for _,h in highlights do h:Destroy()end;highlights={}end
local function mark(id,color)
    if not scene then return end
    local obj=scene.Nodes[id] and scene.Nodes[id].Model or scene.Junctions[id];if not obj then return end
    local h=Instance.new('Highlight');h.Adornee=obj;h.FillTransparency=.92;h.OutlineTransparency=.1;h.OutlineColor=color;h.Parent=world;table.insert(highlights,h)
end
local function selectionMarks()
    clearHighlights()
    for id in selected do mark(id,Config.Colors[1])end
    if primary and not selected[primary]then mark(primary,UI.Colors.Gold)end
    if editorActive and editor then if editor.From then mark(editor.From,UI.Colors.Gold)end;if editor.Moving then mark(editor.Moving,UI.Colors.Gold)end end
end
local function deselect()selected={};primary=nil;orderMode=false;u.Panel.Visible=false;u.SyncHUD();selectionMarks()end
local function ownedSelection()
    local list={};if state then for id in selected do if state.Sites[id] and state.Sites[id].Owner==viewSide() then table.insert(list,id)end end end;table.sort(list);return list
end
local function refreshPanel()
    if not playing() or not primary or not scene.Nodes[primary] or not state.Sites[primary]then u.Panel.Visible=false;u.SyncHUD();return end
    u.Panel.Visible=not u.Menu.Visible and not (UIS.TouchEnabled and camera.ViewportSize.X&lt;550 and u.InfoExpanded)
    u.SyncHUD()
    local s=state.Sites[primary];local ids=ownedSelection();local counts={Peasant=0,Defender=0,Archer=0,Runner=0};local waiting,inside,capacity=0,0,0
    local showIds=#ids&gt;1 and ids or {primary}
    for _,id in showIds do local t=state.Sites[id];inside+=t.Population;capacity+=t.Capacity
        for _,kind in Config.Types do counts[kind]+=t.Inside[kind];waiting+=t.Counts[kind]-t.Inside[kind]end
    end
    u.Building.Text=#showIds&gt;1 and 'Buildings: '..#showIds or Config.Buildings[scene.Nodes[primary].Kind].Name..' '..({'I','II','III'})[s.Level]
    u.Building.TextSize=15
    for _,kind in Config.Types do u.Roster[kind].Text=Config.Units[kind].Name..': '..counts[kind]end
    u.Percent.Frame.Label.Text='Send · '..inside..'/'..capacity..(waiting&gt;0 and ' · waiting: '..waiting or '')
    local cost=Config.UpgradeCost[s.Level+1]
    local possible=#showIds==1 and s.Owner==viewSide() and cost and not s.Upgrade and s.Population&gt;=cost and (not s.Health or s.Health&gt;0)
    if #showIds&gt;1 then u.Upgrade.Text='Select one building to upgrade'
    elseif s.Owner~=viewSide() then u.Upgrade.Text=s.Owner==0 and 'Neutral building' or 'Enemy building'
    elseif s.Health and s.Health&lt;=0 then u.Upgrade.Text='Destroyed · send troops'
    elseif s.Upgrade then u.Upgrade.Text='Upgrading · '..math.ceil(s.Upgrade)..' s'
    elseif not cost then u.Upgrade.Text='Level III'
    else u.Upgrade.Text='Upgrade · '..cost..' troops'end
    u.Upgrade.Active=possible==true;u.Upgrade.AutoButtonColor=u.Upgrade.Active;u.Upgrade.BackgroundColor3=possible and UI.Colors.Blue or UI.Colors.Inset
    u.TouchOrder.Active=#ids&gt;0;u.TouchOrder.BackgroundColor3=orderMode and UI.Colors.Blue or UI.Colors.Inset;u.TouchOrder.Text=orderMode and 'Select a target' or 'Order →'
end
local function choose(id,add)
    if not id or not state or not state.Sites[id]then deselect();return end
    local own=state.Sites[id].Owner==viewSide()
    if not add or not own then selected={}end
    if own then if add and selected[id]then selected[id]=nil;primary=next(selected)else selected[id]=true;primary=id end else primary=id end
    sound.PlayEffect('Select')
    guide:Select(state.Sites[id].Owner);u.UpdateBattleGuide(guide.Active,guide.Step)
    orderMode=false;selectionMarks();refreshPanel()
end
local function atScreen(p)
    if not scene then return nil end
    local ray=camera:ScreenPointToRay(p.X,p.Y)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={scene.Folder}
    local hit=workspace:Raycast(ray.Origin,ray.Direction*2500,params)
    return hit and hit.Instance:GetAttribute('SiteId')
end
local function ground(p)
    local ray=camera:ScreenPointToRay(p.X,p.Y)
    if math.abs(ray.Direction.Y)&lt;.001 then return nil end
    local t=-ray.Origin.Y/ray.Direction.Y;if t&lt;0 then return nil end;return ray.Origin+ray.Direction*t
end
local function send(id)
    local sources=ownedSelection()
    if not playing() or #sources==0 or not state.Sites[id] or percent==0 then return end
    command:FireServer('Send',{Sources=sources,Target=id,Percent=percent,Filter='All',Route='Auto'})
    guide:Order(id,state.Sites[id].Owner)
    sound.PlayEffect('Order')
    clearPreviews()
    for _,source in sources do
        local points=scene.Map.Route(source,id,state.Time&gt;=Config.PrepTime,'Auto',function(via)
            return state.Sites[via] and state.Sites[via].Owner==viewSide()
        end)
        if points then for i=2,#points do
            local a,b=points[i-1],points[i]
            local p=Instance.new('Part');p.Name='Route';p.Anchored=true;p.CanQuery=false;p.CanCollide=false;p.CanTouch=false;p.Material=Enum.Material.Neon;p.Color=UI.Colors.Gold;p.Transparency=.25;p.Size=Vector3.new(.25,.08,(a-b).Magnitude)
            p.CFrame=CFrame.lookAt((a+b)/2+Vector3.new(0,.4,0),b+Vector3.new(0,.4,0));p.Parent=scene.Folder;table.insert(previews,p)
        end end
    end
    previewUntil=os.clock()+2.5;orderMode=false;selectionMarks();mark(id,UI.Colors.Gold);refreshPanel()
end
local function syncLabels()
    for id,l in labels do if not scene.Nodes[id]then l:Destroy();labels[id]=nil end end
    for id in scene.Nodes do
        if labels[id]then continue end
        local l=UI.Label(world,id,'',UDim2.fromOffset(50,22),UDim2.fromOffset(0,0),12);l.TextXAlignment=Enum.TextXAlignment.Center;l.BackgroundColor3=UI.Colors.Panel;l.BackgroundTransparency=.12
        local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,4);c.Parent=l;labels[id]=l
    end
end
local function rebuild(map)
    clearPreviews();clearHighlights();visuals={};labels={};ghost=nil
    for _,p in world:GetChildren()do p:Destroy()end
    scene=Scene.Build(workspace,map,editorActive and 1 or viewSide());Scene.GridVisible(scene,editorActive or prefs.Grid)
    syncLabels()
    selectionMarks()
end
local function previewMap()
    if custom and savedMap then return assert(Network.Create(savedMap))end
    return chosenMap=='Random' and Default or assert(Catalog.Create(chosenMap))
end
local function mapName()
    local name=chosenMap=='Random' and 'Random Map' or 'Two Crossings'
    for _,item in Catalog.Items do if item.Id==chosenMap then name=item.Name end end
    if custom and savedMap then name=savedMap.Name end
    u.MapChoice.Text='Map: '..name..'  ▾';u.MapButtons.Custom.Active=savedMap~=nil;u.MapButtons.Custom.TextColor3=savedMap and UI.Colors.Text or UI.Colors.Muted
    u.MapButtons.Custom.Text=savedMap and 'My map: '..savedMap.Name or 'No saved map'
    for id,b in u.MapButtons do b.BackgroundColor3=id==(custom and 'Custom' or chosenMap)and UI.Colors.Blue or UI.Colors.Inset end
end
local function editorUpdate(definition,hint,geometryRevision,compiled)
    u.EditorHint.Text=hint;u.MapName.Text=definition.Name or 'My Map'
    u.Owner.Text='Team: '..(editor.Owner==1 and 'Blue' or editor.Owner==2 and 'Red' or 'Neutral')
    u.Owner.BackgroundColor3=Config.Colors[editor.Owner==0 and 3 or editor.Owner]
    u.Editor.Toolbar.Tools.River.Text='River: '..(definition.River~=false and 'On' or 'Off')
    for kind,b in u.KindButtons do b.BackgroundColor3=editor.Tool=='Place' and editor.Kind==kind and UI.Colors.Blue or UI.Colors.Inset end
    for _,b in u.Editor.Toolbar.Tools:GetChildren()do if b:IsA('TextButton') and b~=u.Owner then b.BackgroundColor3=b.Name==editor.Tool and UI.Colors.Blue or UI.Colors.Inset end end
    selectionMarks()
    if renderedEditor==editor and renderedEditorRevision==geometryRevision then return end
    pendingEditorRender={Editor=editor,Definition=definition,Revision=geometryRevision,Map=compiled}
    if editorRenderBusy then return end
    -- New mesh types may yield. Coalesce requests and apply them serially.
    editorRenderBusy=true
    while pendingEditorRender do
        local job=pendingEditorRender;pendingEditorRender=nil
        if not editorActive or editor~=job.Editor or renderedEditor==editor and renderedEditorRevision==job.Revision then continue end
        local ok,reason=pcall(function()
            local map,invalid=job.Map,nil
            if not map then map,invalid=Network.Create(job.Definition,{AllowIncomplete=true})end
            if not map then error(invalid)end
            if renderedEditor~=job.Editor then rebuild(map)
            else
                local oldFolder=scene.Folder
                scene=Scene.SyncEditor(scene,map)
                if scene.Folder~=oldFolder then ghost=nil end
                Scene.GridVisible(scene,true);syncLabels();selectionMarks()
            end
            renderedEditor=job.Editor;renderedEditorRevision=job.Revision
        end)
        if not ok then warn('Kingdoms editor: '..tostring(reason));notify('Could not update the map. '..tostring(reason))end
    end
    editorRenderBusy=false
end
local function exitEditor()
    if editorRenderBusy then notify('Loading map models…');return false end
    editorActive=false;u.Editor.Visible=false;u.Code.Visible=false;u.Tutorial.Visible=false;if ghost then ghost:Destroy();ghost=nil end
    deselect();Scene.GridVisible(scene,prefs.Grid);u.Show('Main',false);mapName()
end
local function codeWindow(importing)
    u.Code.Visible=true;u.CodeApply.Visible=importing;u.CodeTitle.Text=importing and 'Import Map' or 'Map Code'
    u.CodeHint.Text=importing and 'Paste your saved map code.' or 'Copy the entire code and save it in a text file to use your map in another session.'
    u.CodeText.Text=importing and '' or editor:Export();u.Layout()
end
local function savePrefs()command:FireServer('Prefs',prefs)end
local function finishBattleGuide()
    guide:Close();u.UpdateBattleGuide(false,guide.Step);prefs.BattleTutorialDone=true;savePrefs()
end
local function beginBattleGuide()
    if preferencesLoaded and playing()and state.Mode=='AI'and not prefs.BattleTutorialDone and not guide.Active then
        guide:Begin(state);u.UpdateBattleGuide(true,guide.Step)
    end
end
local function refreshSettings()
    sound.SetVolume(prefs.Music);sound.SetEffectsVolume(prefs.Effects);u.Music.Set(prefs.Music);u.Effects.Set(prefs.Effects);u.Camera.Set((prefs.Camera-.5)/1.5);u.Zoom.Set((prefs.Zoom-.5)/1.5)
    u.Camera.Text.Text=string.format('%.1f×',prefs.Camera);u.Zoom.Text.Text=string.format('%.1f×',prefs.Zoom)
    u.Grid.Text='Grid: '..(prefs.Grid and 'On' or 'Off');u.Labels.Text='Building Counts: '..(prefs.Labels and 'On' or 'Off')
    if scene then Scene.GridVisible(scene,editorActive or prefs.Grid)end
end
hooks.Menu=function()u.Show('Main',playing());u.Panel.Visible=false;u.SyncHUD()end
hooks.Info=function()u.InfoExpanded=not u.InfoExpanded;refreshPanel();u.SyncHUD()end
hooks.TutorialClose=function()u.Tutorial.Visible=false end
hooks.BattleGuideSkip=finishBattleGuide
hooks.BattleGuideReplay=function()
    prefs.BattleTutorialDone=false;savePrefs();guide:Close()
    if playing()and state.Mode=='AI'then u.Menu.Visible=false;beginBattleGuide();refreshPanel()
    else notify('The battle guide will appear in your next AI match.')end
end
hooks.Deselect=deselect
hooks.Percent=function(v)percent=v end
hooks.Upgrade=function()if #ownedSelection()==1 and primary and u.Upgrade.Active then command:FireServer('Upgrade',{Site=primary})end end
hooks.TouchOrder=function()if #ownedSelection()&gt;0 then orderMode=not orderMode;refreshPanel();if orderMode then notify('Tap the building you want to send troops to.')end end end
hooks.MapChoice=function()if not playing()then u.Show('Maps',false);mapName()end end
hooks.SelectMap=function(id)
    if id=='Custom' and not savedMap then return end
    custom=id=='Custom';if not custom then chosenMap=id end
    mapName();rebuild(previewMap());u.Show('Difficulty',false)
end
hooks.Play=function()if not loaded then return end;if playing()then u.Menu.Visible=false;refreshPanel()elseif state and state.PrivateMatch then command:FireServer('ReturnMenu',{})else u.Show('Mode',false)end end
hooks.AI=function()if state and state.Queueing then command:FireServer('CancelPvP',{})end;u.Show('Difficulty',false);mapName()end
hooks.Online=function()if not loaded then return end;command:FireServer(state and state.Queueing and 'CancelPvP' or 'JoinPvP',{})end
hooks.Ranked=function()if not loaded then return end;command:FireServer(state and state.Queueing and 'CancelPvP'or 'JoinRanked',{})end
hooks.Profile=function()u.Show('Profile',playing())end
hooks.Inventory=function()if not loaded then return end;u.Show('Inventory',playing());meta.SelectSkin(meta.Profile and meta.Profile.Equipped or 'Default')end
hooks.Shop=function()if not loaded then return end;u.Show('Shop',playing());meta.SelectSkin(meta.SetPages.Shop.Selected)end
hooks.PreviewSkin=function(id)meta.SelectSkin(id)end
hooks.Chests=function()u.Show('Chests',playing());meta.ChestPreview();meta.RefreshChest()end
hooks.OpenChest=function()
    if not meta.ChestBuy.Active or not meta.ChestInfo then return end
    meta.ChestPending=true;meta.ChestRequest=game:GetService('HttpService'):GenerateGUID(false)
    local request=meta.ChestRequest;local signature=meta.ChestInfo.Signature
    meta.RefreshChest();accountAction:FireServer('OpenChest',{RequestId=request,Signature=signature})
    task.delay(6,function()if meta.ChestPending and meta.ChestRequest==request then accountAction:FireServer('OpenChest',{RequestId=request,Signature=signature})end end)
end
hooks.BuySkin=function(id)if meta.Buy.Active then accountAction:FireServer('Buy',{Skin=id})end end
hooks.EquipSkin=function(id)if meta.Profile and meta.Profile.Skins[id]and meta.Profile.Equipped~=id then accountAction:FireServer('Equip',{Skin=id})end end
hooks.PremiumSkin=function(id)if meta.Buy.Active then accountAction:FireServer('Premium',{Skin=id})end end
hooks.CoinPack=function(id)accountAction:FireServer('Coins',{Product=id})end
hooks.Board=function(kind)meta.BoardKind=kind;if meta.Boards[kind]then meta.Apply({Board=meta.Boards[kind]})else meta.Mine.Text='Loading leaderboard…'end;accountAction:FireServer('Board',{Kind=kind})end
hooks.Leaders=function()u.Show('Leaders',playing());hooks.Board('Rank')end
hooks.MetaBack=function()u.Show('Main',playing())end
hooks.RefreshProfile=function()command:FireServer('Ready',{});accountAction:FireServer('Refresh',{})end
root:WaitForChild('Account').OnClientEvent:Connect(function(data)
    meta.Apply(data)
    if data.Chest then sound.PlayEffect('Chest')end
    if data.Error then sound.PlayEffect('Error')end
    if data.Reward and not data.Reward.AlreadyApplied then notify('Match recorded: +'..data.Reward.XP..' XP'..(data.Reward.Coins&gt;0 and ', +'..data.Reward.Coins..' coins'or ''))end
end)
task.spawn(function()
    meta.PremiumPrices={}
    for _,skin in Progression.Skins do if skin.GamePassId and skin.GamePassId&gt;0 then
        local ok,info=pcall(function()return game:GetService('MarketplaceService'):GetProductInfoAsync(skin.GamePassId,Enum.InfoType.GamePass)end)
        meta.PremiumPrices[skin.Id]=ok and info.IsForSale and info.PriceInRobux or false
        meta.RefreshShop()
    end end
    for _,pack in Progression.Products do if pack.ProductId&gt;0 then
        local ok,info=pcall(function()return game:GetService('MarketplaceService'):GetProductInfoAsync(pack.ProductId,Enum.InfoType.Product)end)
        local button=meta.Products[pack.Id]
        if ok and info.IsForSale then button.Text=pack.Coins..' coins\n'..info.PriceInRobux..' Robux';button.Active=not Run:IsStudio();button.AutoButtonColor=button.Active else button.Active=false;button.Text=pack.Coins..' coins\nUnavailable'end
    end end
end)
hooks.Editor=function()
    if not loaded or playing()then return end
    deselect();editorActive=true;u.Menu.Visible=false;u.HUD.Visible=false;u.Editor.Visible=true
    if state and state.Queueing then command:FireServer('CancelPvP',{})end
    editor=Editor.new(previewMap().Definition,editorUpdate,notify);editor:Refresh();targetCenter=Vector3.zero;targetZoom=300
    if not tutorialShown then tutorialShown=true;u.Tutorial.Visible=true end
end
hooks.Settings=function()u.Show('Settings',playing())end
hooks.Return=function()deselect();command:FireServer('ReturnMenu',{});u.Show('Main',false)end
hooks.Start=function(difficulty)
    if not loaded then return end
    deselect();command:FireServer('Start',{Difficulty=difficulty,MapId=not custom and chosenMap or nil,Definition=custom and savedMap or nil})
end
hooks.Back=function()
    if u.Page=='Settings'then savePrefs()end
    if u.Page=='Mode'and state and state.Queueing then command:FireServer('CancelPvP',{})end
    u.Show(u.Page=='Maps'and 'Difficulty' or u.Page=='Difficulty'and 'Mode' or 'Main',playing())
end
hooks.Music=function(v,done)prefs.Music=v;sound.SetVolume(v);if done then savePrefs()end end
hooks.Effects=function(v,done)prefs.Effects=v;sound.SetEffectsVolume(v);if done then savePrefs()end end
hooks.Camera=function(v,done)prefs.Camera=v;u.Camera.Text.Text=string.format('%.1f×',v);if done then savePrefs()end end
hooks.Zoom=function(v,done)prefs.Zoom=v;u.Zoom.Text.Text=string.format('%.1f×',v);if done then savePrefs()end end
hooks.Grid=function()prefs.Grid=not prefs.Grid;refreshSettings();savePrefs()end
hooks.Labels=function()prefs.Labels=not prefs.Labels;refreshSettings();savePrefs()end
local function validatedEditor()
    editor.Definition.Name=u.MapName.Text
    local map,reason=editor:Validate();if not map then notify(reason);return nil end;return map
end
hooks.SaveMap=function()local map=validatedEditor();if map then command:FireServer('SaveMap',{Definition=map.Definition})end end
hooks.TestMap=function()
    if editorRenderBusy then notify('Loading map models…');return end
    local map=validatedEditor();if not map then return end
    savedMap=map.Definition;custom=true;exitEditor();u.Show('Difficulty',false)
end
hooks.ExitEditor=exitEditor
hooks.EditorTool=function(tool)
    editor.Definition.Name=u.MapName.Text
    if tool=='Owner'then editor:CycleOwner()
    elseif tool=='River'then editor:ToggleRiver()
    elseif tool=='New'then editor:New()
    elseif tool=='Undo'then editor:Undo()
    elseif tool=='Export'then codeWindow(false)
    elseif tool=='Import'then codeWindow(true)
    elseif tool=='Help'then u.Tutorial.Visible=true
    else editor:SetTool(tool)end
end
hooks.EditorKind=function(kind)editor.Definition.Name=u.MapName.Text;editor:SetKind(kind)end
hooks.ImportApply=function()local ok,reason=editor:Import(u.CodeText.Text);if ok then u.Code.Visible=false;notify('Map imported.')else notify(reason)end end
hooks.CodeClose=function()u.Code.Visible=false end
local function arrow(e)
    local p=Instance.new('Part');p.Name='Arrow';p.Size=Vector3.new(.07,.07,1.1);p.Material=Enum.Material.Wood;p.Color=UI.Colors.Gold;p.Anchored=true;p.CanQuery=false;p.CanCollide=false;p.CanTouch=false;p.CFrame=CFrame.lookAt(e.From,e.To);p.Parent=scene.Folder
    Tween:Create(p,TweenInfo.new(.3,Enum.EasingStyle.Linear),{CFrame=CFrame.lookAt(e.To,e.To+(e.To-e.From))}):Play();Debris:AddItem(p,.33)
end
local function garrisonSwing(e)
    local blade=Instance.new('Part');blade.Name='Garrison Swing';blade.Size=Vector3.new(.09,.09,Config.MeleeContact)
    blade.Material=Enum.Material.Metal;blade.Color=Color3.fromRGB(224,228,229)
    blade.Anchored=true;blade.CanQuery=false;blade.CanCollide=false;blade.CanTouch=false
    local center=(e.From+e.To)/2;local facing=CFrame.lookAt(center,e.To)
    blade.CFrame=facing*CFrame.Angles(0,-math.pi/3,0);blade.Parent=scene.Folder
    Tween:Create(blade,TweenInfo.new(Config.MeleeImpactDelay),{CFrame=facing*CFrame.Angles(0,math.pi/3,0),Transparency=1}):Play()
    Debris:AddItem(blade,Config.MeleeImpactDelay+.1)
end
local function applySnapshot(snapshot)
    local previous=state and state.Phase;state=snapshot;if not loaded then return end
    u.InPrivate=state.PrivateMatch;u.Connecting=state.Connecting
    local active=playing()
    sound.SetContext(state.Phase=='Battle'and 'Battle'or 'Menu')
    if active and revision~=state.MapRevision then
        local map,reason=Network.Create(state.Map);if not map then notify(reason);return end
        revision=state.MapRevision;rebuild(map);deselect()
        local castle=scene.Nodes[map.Castles[viewSide()]];targetCenter=castle.Position+Vector3.new(viewSide()==1 and 45 or -45,0,0);targetZoom=UIS.TouchEnabled and 210 or 180
    end
    if active and previous~='Preparation' and previous~='Battle'then meta.HidePreviews();u.Menu.Visible=false;u.Editor.Visible=false;editorActive=false;u.Code.Visible=false end
    u.HUD.Visible=active and not editorActive
    if active then
        beginBattleGuide()
        if guide:Observe(state)then finishBattleGuide();notify('Great work! Capture the enemy castle to win.')end
        u.UpdateBattleGuide(guide.Active,guide.Step)
        Scene.Update(scene,state)
        local alive={}
        for _,d in state.Units do
            local id,kind,side,x,z=d[1],d[2],d[3],d[4],d[5];alive[id]=true
            local skin=state.Skins and state.Skins[side]or 'Default'
            local color=Config.TeamColor(side,viewSide())
            if not visuals[id] or visuals[id].Kind~=kind or visuals[id].Skin~=skin or visuals[id].Color~=color then if visuals[id]then visuals[id].Model:Destroy()end;visuals[id]={Kind=kind,Skin=skin,Color=color,Model=Art.Unit(kind,scene.Units,color,skin),Position=Vector3.new(x,.25,z)}end
            local v=visuals[id];local y=d[11]or .25
            for _,b in scene.Map.Bridges do if math.abs(x)&lt;17 and math.abs(z-b.Position.Z)&lt;4 then y=.7;break end end
            v.Goal=Vector3.new(x,y,z);v.Heading=Vector3.new(d[7],0,d[8]);v.Attacking=d[9]
        end
        for id,v in visuals do if not alive[id]then v.Model:Destroy();visuals[id]=nil end end
        for _,e in state.Events do if e.Type=='Arrow'then arrow(e)elseif e.Type=='GarrisonSwing'then garrisonSwing(e)elseif e.Type=='Capture'and e.Side==viewSide() and scene.Nodes[e.Site]then notify('Captured: '..Config.Buildings[scene.Nodes[e.Site].Kind].Name)end end
        for id,s in state.Sites do local l=labels[id];if l then l.Text=tostring(s.Population);l.TextColor3=Config.TeamColor(s.Owner,viewSide())end end
        local total=state.Totals[viewSide()];local time=string.format('%02d:%02d',math.floor(state.Time/60),math.floor(state.Time%60))
        u.Summary.Text='Food: '..math.floor(state.Food[viewSide()])..'\nPeasants: '..total.Peasant..'\nTime: '..time..'\n'..(scene.Map.River and (state.Time&lt;60 and 'Bridges: '..math.ceil(60-state.Time)..' s' or 'Bridges open')or 'No river')
    elseif previous=='Preparation' or previous=='Battle'then
        guide:Close();u.UpdateBattleGuide(false,guide.Step)
        deselect();for _,v in visuals do v.Model:Destroy()end;visuals={};u.Show('Main',false)
        u.Result.Text=state.Phase=='Ended'and (state.Winner==0 and 'Draw' or state.Winner==viewSide() and 'Victory' or 'Defeat') or ''
        if state.Phase=='Ended'and state.Winner~=0 then sound.PlayEffect(state.Winner==viewSide()and 'Victory'or 'Defeat')end
        targetCenter=Vector3.zero;targetZoom=300
    end
    meta.QueueMode=state.Queueing and state.QueueMode or nil
    u.Online.Text=state.Connecting and 'Connecting…' or state.Queueing and state.QueueMode~='Ranked'and 'Cancel Search' or 'Casual · 1v1'
    u.Online.Active=not state.Connecting
    u.Ranked.Active=not state.Connecting
    u.Ranked.Text=state.Queueing and state.QueueMode=='Ranked'and 'Cancel Ranked Search'or 'Ranked · '..(meta.Profile and meta.Profile.Rank or 0)
    u.QueueStatus.Text=state.Connecting and 'Connecting to a dedicated match server…' or state.Queueing and (state.Studio and 'Studio: waiting for a second test player.'or state.QueueMode=='Ranked'and 'Finding an opponent of a similar rank across all lobbies…'or 'Finding an opponent of a similar level…') or 'PvP matches use a random map.'
    if state.PrivateMatch and not active then u.Play.Text='Back to Lobby';u.EditorButton.Active=false;u.EditorButton.TextColor3=UI.Colors.Muted
        if state.Phase=='Waiting'then u.Result.Text='Waiting for match players to connect…'end
    end
