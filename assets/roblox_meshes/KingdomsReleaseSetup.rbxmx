        m.SetPages[name]=view
        view.Balance=label(p,'Balance','',0,25,15);view.Balance.Font=Enum.Font.GothamMedium;view.Balance.TextColor3=accent;view.Balance.Size=UDim2.new(.5,-8,0,25)
        view.Subtitle=label(p,'Subtitle',name=='Inventory'and 'Your sets, ready for the next match' or 'Give your kingdom a complete new look',27,20,11);view.Subtitle.TextColor3=T.Muted;view.Subtitle.Size=UDim2.new(.5,-8,0,20)
        local other=button(p,'Other',name=='Inventory'and 'Visit Shop →'or 'Inventory →',function()call(name=='Inventory'and 'Shop'or 'Inventory')end)
        other.Size=UDim2.new(.26,-6,0,34);other.Position=UDim2.new(.5,0,0,4)
        local cases=button(p,'Cases','Chests →',function()call('Chests')end);cases.Size=UDim2.new(.24,-8,0,34);cases.Position=UDim2.new(.76,0,0,4);cases.TextColor3=T.Gold
        view.Catalog=panel(p,'Catalog');view.Detail=panel(p,'SelectedSet')
        view.List=Instance.new('ScrollingFrame');view.List.Name='Sets';view.List.Active=true;view.List.BackgroundTransparency=1;view.List.BorderSizePixel=0;view.List.ScrollBarThickness=3;view.List.ScrollBarImageColor3=T.Muted;view.List.ScrollingDirection=Enum.ScrollingDirection.Y;view.List.Parent=view.Catalog
        view.Empty=label(view.List,'Empty','',12,76,13);view.Empty.TextColor3=T.Muted;view.Empty.Visible=false
        view.Name=label(view.Detail,'SetName','',14,46,20);view.Name.Position=UDim2.fromOffset(16,14);view.Name.Size=UDim2.new(1,-32,0,46);view.Name.Font=Enum.Font.GothamMedium
        view.Rarity=label(view.Detail,'Rarity','',62,22,11);view.Rarity.Position=UDim2.fromOffset(16,62);view.Rarity.Size=UDim2.new(1,-32,0,22)
        view.View,view.Camera,view.World=viewport(view.Detail,'Preview',94,190)
        view.Loading=label(view.View,'Loading','',0,28,12);view.Loading.TextXAlignment=Enum.TextXAlignment.Center;view.Loading.Size=UDim2.new(1,0,1,0)
        for i,item in {{'Army','Army'},{'Buildings','Buildings'},{'Roads','Roads'}}do
            local b=button(view.Detail,item[1],item[2],function()view.Mode=item[1];m.SelectSkin(view.Selected)end);b.TextSize=11;view.Tabs[item[1]]=b
        end
        view.Description=label(view.Detail,'Contents','Army, buildings and roads in one set',0,34,11);view.Description.TextColor3=T.Muted
        view.Hint=label(view.Detail,'Hint','',0,26,10);view.Hint.TextColor3=T.Muted;view.Hint.TextXAlignment=Enum.TextXAlignment.Center
        return view
    end
    local function filters(view,items,y)
        local row=UI.Frame(view.Catalog,'Filters',UDim2.new(1,-28,0,28),UDim2.fromOffset(14,y));row.BackgroundTransparency=1
        for i,item in items do
            local b=button(row,item[1],item[2],function()view.Filter=item[1];view.List.CanvasPosition=Vector2.new(0,0);m.RefreshShop()end)
            b.TextSize=11;b.Size=UDim2.new(1/#items,-6,0,28);b.Position=UDim2.new((i-1)/#items,0,0,0);view.Filters[item[1]]=b
        end
    end
    -- Inventory contains owned sets only and has a single equipment action.
    local inventory=shell('Inventory',T.Mint,'Default')
    label(inventory.Catalog,'Heading','MY SETS',14,22,12).Position=UDim2.fromOffset(14,14)
    filters(inventory,{{'All','All Owned'},{'Rare','Rare +'},{'Mythic','Mythic'}},46)
    inventory.Progress=UI.Frame(inventory.Page,'Progress',UDim2.new(.47,0,0,2),UDim2.fromOffset(0,53),T.Inset)
    inventory.ProgressFill=UI.Frame(inventory.Progress,'Fill',UDim2.fromScale(0,1),UDim2.new(),T.Mint)
    inventory.Equip=button(inventory.Detail,'Equip','Equip Set',function()if inventory.Equip.Active then call('EquipSkin',inventory.Selected)end end)
    inventory.Hint.Text='Your new look applies from the next match'
    m.Equip=inventory.Equip
    -- Shop is a sales catalogue: currency filters, mythic offers and purchases.
    local shop=shell('Shop',T.Gold,'Storm')
    shop.Featured=panel(shop.Catalog,'MythicCollection');gradient(shop.Featured,Color3.fromRGB(66,49,45),Color3.fromRGB(34,34,49))
    local featuredTitle=label(shop.Featured,'Title','MYTHIC COLLECTION',6,20,11);featuredTitle.Position=UDim2.fromOffset(10,6);featuredTitle.TextColor3=T.Gold
    shop.FeaturedButtons={}
    for i,item in {{'Storm','Storm'},{'Dragon','Dragon'},{'Oracle','Stars'}}do
        local b=button(shop.Featured,item[1],item[2]..' · '..P.Skin(item[1]).RobuxPrice..' R$',function()shop.Filter='Robux';m.SelectSkin(item[1])end)
        b.Size=UDim2.new(1/3,-8,0,32);b.Position=UDim2.new((i-1)/3,6,0,30);b.TextSize=11;shop.FeaturedButtons[item[1]]=b
    end
    filters(shop,{{'All','All'},{'Coins','Coins'},{'Robux','Robux'},{'Available','Unowned'}},96)
    shop.Buy=button(shop.Detail,'Buy','',function()
        if not shop.Buy.Active then return end
        if P.Skin(shop.Selected).RobuxPrice then call('PremiumSkin',shop.Selected)else call('BuySkin',shop.Selected)end
    end)
    shop.ToInventory=button(shop.Detail,'ToInventory','View in Inventory →',function()
        local id=shop.Selected;if owns(id)then call('Inventory');m.SelectSkin(id)end
    end);shop.ToInventory.Visible=false
    m.Buy=shop.Buy;m.Balance=shop.Balance;m.SkinName=shop.Name;m.World=shop.World;m.SkinButtons=shop.Buttons
    shop.Coins=panel(shop.Page,'CoinPacks')
    local coinsTitle=label(shop.Coins,'Title','GET MORE COINS',8,22,11);coinsTitle.Position=UDim2.fromOffset(14,8);coinsTitle.TextColor3=T.Gold
    m.Products={}
    for i,product in P.Products do
        local b=button(shop.Coins,product.Id,product.Coins..' coins · '..(product.ProductId&gt;0 and 'Loading…'or 'Coming Soon'),function()if m.Products[product.Id].Active then call('CoinPack',product.Id)end end)
        b.Size=UDim2.new(1/3,-18,0,36);b.Position=UDim2.new((i-1)/3,14,0,34);b.TextSize=11;b.TextWrapped=true;enabled(b,false,T.Gold);m.Products[product.Id]=b
    end
    local function card(view,skin)
        local b=button(view.List,skin.Id,'',function()call('PreviewSkin',skin.Id)end);b.Text=''
        local tint=color(P.Rarities[skin.Rarity].Color);local line=stroke(b,tint)
        local strip=UI.Frame(b,'RarityLine',UDim2.new(1,-16,0,2),UDim2.fromOffset(8,0),tint);round(strip,2)
        local emblem=UI.Frame(b,'Emblem',UDim2.fromOffset(26,32),UDim2.fromOffset(12,12),color(skin.Cloth));round(emblem,7);stroke(emblem,color(skin.Trim))
        UI.Frame(emblem,'Cross',UDim2.fromOffset(3,20),UDim2.fromOffset(12,6),color(skin.Trim))
        UI.Frame(emblem,'Crossbar',UDim2.fromOffset(16,3),UDim2.fromOffset(5,13),color(skin.Armor))
        local title=label(b,'Name',skin.Name,7,40,12);title.Position=UDim2.fromOffset(48,7);title.Size=UDim2.new(1,-56,0,40);title.Font=Enum.Font.GothamMedium
        local rarity=label(b,'Tier',P.Rarities[skin.Rarity].Name,48,18,10);rarity.Position=UDim2.fromOffset(12,48);rarity.Size=UDim2.new(1,-24,0,18);rarity.TextColor3=tint
        local status=label(b,'Status','',68,20,11);status.Position=UDim2.fromOffset(12,68);status.Size=UDim2.new(1,-24,0,20);status.Font=Enum.Font.GothamMedium
        view.Buttons[skin.Id]=b;view.Cards[skin.Id]={Button=b,Status=status,Stroke=line};return b
    end
    for _,skin in P.Skins do if skin.Id~='Default'then card(shop,skin)end end
    local function inventoryMatch(view,skin)
        return view.Filter=='All'or view.Filter=='Mythic'and skin.Rarity=='Mythic'or view.Filter=='Rare'and (skin.Rarity=='Rare'or skin.Rarity=='Epic'or skin.Rarity=='Mythic')
    end
    local function shopMatch(view,skin)
        return view.Filter=='All'or view.Filter=='Coins'and not skin.RobuxPrice or view.Filter=='Robux'and skin.RobuxPrice~=nil or view.Filter=='Available'and not owns(skin.Id)
    end
    local function grid(view)
        local width=u.Card.Size.X.Offset
        local columns=width&gt;=700 and 2 or width&gt;=450 and 3 or 2
        local index=0
        for _,skin in P.Skins do
            local b=view.Buttons[skin.Id]
            if b then
                b.Visible=view==inventory and owns(skin.Id)and inventoryMatch(view,skin)or view==shop and shopMatch(view,skin)
                local selected=skin.Id==view.Selected;local entry=view.Cards[skin.Id]
                b.BackgroundColor3=selected and Color3.fromRGB(41,64,82)or T.Inset
                entry.Stroke.Transparency=selected and 0 or .55;entry.Stroke.Thickness=selected and 2 or 1
                entry.Status.Text=view==inventory and (m.Profile and m.Profile.Equipped==skin.Id and '✓ Equipped' or 'In your collection')or owns(skin.Id)and '✓ Owned'or coinPrice(skin)
                entry.Status.TextColor3=view==inventory and T.Mint or owns(skin.Id)and T.Mint or T.Gold
                if b.Visible then
                    b.Size=UDim2.new(1/columns,-8,0,96);b.Position=UDim2.new(index%columns/columns,0,0,math.floor(index/columns)*104);index+=1
                end
            end
        end
        view.List.CanvasSize=UDim2.fromOffset(0,math.ceil(index/columns)*104)
        view.Empty.Visible=index==0;view.Empty.Text=view==inventory and 'No sets of this rarity yet.\nFind new sets in the shop and chests.'or 'You already own every set in this category.'
        for key,b in view.Filters do b.BackgroundColor3=key==view.Filter and view.Accent or T.Inset;b.TextColor3=key==view.Filter and T.Panel or T.Muted end
    end
    function m.RefreshShop()
        local d=m.Profile
        for _,skin in P.Skins do
            if owns(skin.Id)and not inventory.Buttons[skin.Id]then card(inventory,skin)
            elseif not owns(skin.Id)and inventory.Buttons[skin.Id]then inventory.Buttons[skin.Id]:Destroy();inventory.Buttons[skin.Id]=nil;inventory.Cards[skin.Id]=nil end
        end
        if not owns(inventory.Selected)then inventory.Selected=d and d.Equipped or 'Default'end
        local count=d and P.CollectionCount(d)or 0
        inventory.Balance.Text='Your collection · '..count..' / '..#P.Skins
        inventory.ProgressFill.Size=UDim2.fromScale(count/#P.Skins,1)
        shop.Balance.Text='Wallet · '..(d and d.Coins or '—')..' coins'
        for _,view in {inventory,shop}do
            local skin=P.Skin(view.Selected);local equipped=d and d.Equipped==skin.Id;local tint=color(P.Rarities[skin.Rarity].Color)
            view.Name.Text=skin.Name;view.Rarity.Text=P.Rarities[skin.Rarity].Name..'  /  COMPLETE SET';view.Rarity.TextColor3=tint
            view.Description.Text='4 unit types · all buildings and levels\nHeraldry, roof crests and matching roads'
            grid(view)
            for key,b in view.Tabs do b.BackgroundColor3=key==view.Mode and view.Accent or T.Inset;b.TextColor3=key==view.Mode and T.Panel or T.Muted end
            if u.Page==view.Page.Name then m.Skin=view.Selected end
            if view==inventory then
                view.Equip.Text=equipped and '✓ Set Equipped'or 'Equip Set';enabled(view.Equip,owns(skin.Id)and not equipped,T.Mint)
            else
                local has=owns(skin.Id);local action=view.Buy
                view.ToInventory.Visible=has;action.Visible=not has
                if has then action.Text='Already owned';enabled(action,false,T.Gold);view.Hint.Text='Already unlocked — equip this set in your inventory'
                elseif skin.RobuxPrice then
                    local price=m.PremiumPrices[skin.Id]
                    action.Text=typeof(price)=='number'and ('Buy · '..price..' Robux')or (coinPrice(skin)..' · '..(skin.GamePassId&gt;0 and 'Checking…'or 'Coming Soon'))
                    enabled(action,d~=nil and typeof(price)=='number'and not game:GetService('RunService'):IsStudio(),T.Gold)
                    local _,_,total=P.ChestPool();view.Hint.Text='Chest chance: '..string.format('%.1f',skin.Weight/total*100)..'% · cosmetic only'
                else
                    action.Text='Buy · '..skin.Price..' coins';enabled(action,d~=nil and d.Coins&gt;=skin.Price,T.Gold)
                    local needed=skin.Price-(d and d.Coins or 0)
                    view.Hint.Text=d and needed&gt;0 and ('Need '..needed..' more '..(needed==1 and 'coin'or 'coins'))or 'Also available from a Kingdom Chest'
                end
            end
        end
        for id,b in shop.FeaturedButtons do b.BackgroundColor3=id==shop.Selected and Color3.fromRGB(100,77,48)or T.Inset;b.TextColor3=id==shop.Selected and T.Gold or T.Text end
    end
    function m.CollectionLayout()
        local width=u.Card.Size.X.Offset;local height=u.Card.Size.Y.Offset-134
        local wide=width&gt;=700
        local body=math.max(360,height-68)
        for _,view in {inventory,shop}do
            local catalogHeight=wide and body or (view==shop and 340 or 280)
            local detailHeight=wide and body or 440
            view.Catalog.Size=wide and UDim2.new(.53,-10,0,catalogHeight)or UDim2.new(1,-8,0,catalogHeight)
            view.Catalog.Position=UDim2.fromOffset(0,66)
            view.Detail.Size=wide and UDim2.new(.47,-6,0,detailHeight)or UDim2.new(1,-8,0,detailHeight)
            view.Detail.Position=wide and UDim2.new(.53,2,0,66)or UDim2.fromOffset(0,78+catalogHeight)
            local start=view==inventory and 84 or 136
            view.List.Position=UDim2.fromOffset(14,start);view.List.Size=UDim2.new(1,-28,0,catalogHeight-start-14)
            if view==shop then shop.Featured.Size=UDim2.new(1,-28,0,72);shop.Featured.Position=UDim2.fromOffset(14,12)end
            local previewHeight=detailHeight-256
            view.View.Position=UDim2.fromOffset(14,92);view.View.Size=UDim2.new(1,-28,0,previewHeight)
            for i,key in {'Army','Buildings','Roads'}do local b=view.Tabs[key];b.Size=UDim2.new(1/3,-16,0,28);b.Position=UDim2.new((i-1)/3,14-(i-1)*28/3,0,100+previewHeight)end
            view.Description.Position=UDim2.fromOffset(16,134+previewHeight);view.Description.Size=UDim2.new(1,-32,0,34)
            local action=view==inventory and view.Equip or view.Buy
            action.Position=UDim2.new(0,14,1,-76);action.Size=UDim2.new(1,-28,0,42)
            if view==shop then view.ToInventory.Position=action.Position;view.ToInventory.Size=action.Size end
            view.Hint.Position=UDim2.new(0,14,1,-29);view.Hint.Size=UDim2.new(1,-28,0,26)
            local endY=wide and 66+body or 78+catalogHeight+detailHeight
            view.Page.CanvasSize=UDim2.fromOffset(0,endY+6)
            if view==shop then
                shop.Coins.Position=UDim2.fromOffset(0,endY+14);shop.Coins.Size=UDim2.new(1,-8,0,84)
                shop.Page.CanvasSize=UDim2.fromOffset(0,endY+106)
            end
            grid(view)
        end
    end
    function m.SelectSkin(id)
        local view=m.SetPages[u.Page];if not view or not P.Skin(id)then return end
        if view==inventory and not owns(id)or view==shop and id=='Default'then return end
        view.Selected=id;m.Skin=id;m.RefreshShop()
        view.Serial+=1;local serial=view.Serial;local mode=view.Mode
        for _,child in view.World:GetChildren()do child:Destroy()end;Art.Prune();view.Loading.Text='Loading set…'
        local temp=Instance.new('Model');temp.Name=id..'_Preview'
        local ok,reason=pcall(function()
            if mode=='Army'then army(temp,id)
            elseif mode=='Buildings'then
                local bounds=Art.Bounds('Castle_Upgrade3');local ground=-bounds.Minimum.Y;local height=bounds.Maximum.Y+ground
                local facing=CFrame.Angles(0,Config.BuildingYaw,0)
                Art.Clone('Castle_Upgrade3',temp,CFrame.new(0,ground,0)*facing,nil,id)
                Art.Clone(id..'_Herald',temp,CFrame.new(0,3,9.75)*facing);Art.Clone(id..'_RoofCrest',temp,CFrame.new(0,height-.1,0)*facing)
                if Art.Modules[id..'_Gateway']then Art.Clone(id..'_Gateway',temp,CFrame.new(0,.12,9.28)*facing)end
            else
                for i=-1,1 do Art.Clone(id..'_RoadTile',temp,CFrame.new(0,0,i*4))end
            end
        end)
        if serial~=view.Serial then temp:Destroy();return end
        if not ok then temp:Destroy();view.Loading.Text='Could not load the preview.\nSelect the set again.';warn(reason);Art.Prune();return end
        for _,child in view.World:GetChildren()do child:Destroy()end;temp.Parent=view.World;view.Loading.Text=''
        if mode=='Army'then armyCamera(view.Camera)
        elseif mode=='Buildings'then view.Camera.CFrame=CFrame.lookAt(Vector3.new(28,29,47),Vector3.new(0,8,0));view.Camera.FieldOfView=36
        else view.Camera.CFrame=CFrame.lookAt(Vector3.new(6,8,11),Vector3.new(0,.15,0));view.Camera.FieldOfView=42 end
    end
    local chest=page('Chests')
    m.ChestBalance=label(chest,'Balance','',0,30,15);m.ChestBalance.Size=UDim2.new(.5,0,0,30);m.ChestBalance.TextColor3=C.Gold
    UI.Button(chest,'Inventory','Inventory →',UDim2.new(.5,-8,0,30),UDim2.fromScale(.5,0),function()call('Inventory')end)
    label(chest,'CaseName','Kingdom Chest · complete cosmetic set',40,28,17)
    local chestView,chestCam,chestWorld=viewport(chest,'Preview',78,150)
    m.ChestResult=label(chest,'Result','Army, buildings and roads in one set.',235,44,14);m.ChestResult.TextColor3=C.Gold
    m.ChestOdds=label(chest,'Odds','',283,55,12)
    m.ChestBuy=UI.Button(chest,'Open','Buy &amp; Open · 300 coins',UDim2.new(1,-8,0,44),UDim2.fromOffset(0,346),function()call('OpenChest')end)
    label(chest,'Duplicates','Odds stay fixed. Duplicates refund 100 / 150 / 200 / 250 coins, depending on rarity.',398,44,11).TextColor3=C.Muted
    m.ChestSkin=UI.Button(chest,'ViewReward','View Set in Inventory',UDim2.new(1,-8,0,34),UDim2.fromOffset(0,450),function()if m.LastChestSkin then call('Inventory');m.SelectSkin(m.LastChestSkin)end end);m.ChestSkin.Visible=false
    m.ChestRewards=label(chest,'Rewards','',496,50,12);m.ChestRewards.TextYAlignment=Enum.TextYAlignment.Top
    function m.ChestPreview(id)
        m.ChestPreviewSerial=(m.ChestPreviewSerial or 0)+1;local serial=m.ChestPreviewSerial
        for _,child in chestWorld:GetChildren()do child:Destroy()end;Art.Prune();local temp=Instance.new('Model')
        local ok,reason=pcall(function()if id then army(temp,id)else Art.Clone('CollectionChest',temp,CFrame.identity)end end)
        if serial~=m.ChestPreviewSerial or not ok then temp:Destroy();if not ok then warn(reason)end;return end
        for _,child in chestWorld:GetChildren()do child:Destroy()end;temp.Parent=chestWorld
        if id then armyCamera(chestCam)else chestCam.CFrame=CFrame.lookAt(Vector3.new(2.9,2.2,4),Vector3.new(0,.7,0));chestCam.FieldOfView=36 end
    end
    function m.RefreshChest()
        local info=m.ChestInfo;local d=m.Profile
        m.ChestBalance.Text='Coins: '..(d and d.Coins or '—')
        m.ChestBuy.Active=info~=nil and info.Allowed==true and not info.Complete and d~=nil and d.Coins&gt;=info.Price and not m.ChestPending
        m.ChestBuy.AutoButtonColor=m.ChestBuy.Active;m.ChestBuy.BackgroundColor3=m.ChestBuy.Active and C.Blue or C.Inset
        m.ChestBuy.Text=m.ChestPending and 'Opening…'or info and info.Complete and 'Collection Complete'or 'Buy &amp; Open · '..(info and info.Price or P.ChestPrice)..' coins'
        if not info or info.Pending then m.ChestOdds.Text='Checking chest availability…'
        elseif not info.Allowed then m.ChestOdds.Text='Random purchases are unavailable for this Roblox account.'
        elseif info.Complete then m.ChestOdds.Text='All 25 sets are already in your inventory.'
        else m.ChestOdds.Text='Common: 60% · Rare: 30%\nEpic: 9% · Mythic: 1%'end
        local rewards=info and info.Rewards or P.ChestRewards(P.Normalize());local lines={'All possible rewards and exact odds:'}
        for _,r in rewards do
            local skin=P.Skin(r.Id)
            table.insert(lines,skin.Name..' · '..P.Rarities[skin.Rarity].Name..' — '..string.format('%.6f',r.Chance)..'% ('..r.Weight..'/'..r.Total..')'..(r.Owned and ' · duplicate: +'..r.Refund..' coins'or ''))
        end
        m.ChestRewards.Text=table.concat(lines,'\n');m.ChestRewards.Size=UDim2.new(1,-8,0,28+#rewards*44);chest.CanvasSize=UDim2.fromOffset(0,540+#rewards*44)
    end
    function m.HidePreviews()
        m.ChestPreviewSerial=(m.ChestPreviewSerial or 0)+1
        for _,view in m.SetPages do view.Serial+=1;for _,child in view.World:GetChildren()do child:Destroy()end end
        for _,child in chestWorld:GetChildren()do child:Destroy()end;Art.Prune()
    end
    local show=u.Show
    function u.Show(name,inGame)m.HidePreviews();show(name,inGame)end
    local apply=m.Apply
    function m.Apply(data)
        local active=m.SetPages[u.Page];local previous=active and active.Selected
        apply(data)
        if data.Profile and active and previous~=active.Selected then m.SelectSkin(active.Selected)end
        if data.ChestInfo then m.ChestInfo=data.ChestInfo end
        if data.ChestDone then m.ChestPending=false;m.ChestRequest=nil end
        m.RefreshChest()
        if data.Chest then
            local result=data.Chest;local skin=P.Skin(result.Skin);m.LastChestSkin=skin.Id;m.ChestSkin.Visible=true
            m.ChestResult.Text=(result.Duplicate and 'Duplicate: 'or 'Set unlocked: ')..skin.Name..(result.Duplicate and '\nRefunded: '..result.Refund..' coins'or '')
            m.ChestResult.TextColor3=color(P.Rarities[skin.Rarity].Color)
            if u.Page=='Chests'then
                Tween:Create(chestView,TweenInfo.new(.3),{BackgroundColor3=color(P.Rarities[skin.Rarity].Color)}):Play()
                local resultSerial=m.ChestPreviewSerial
                task.delay(.3,function()if u.Page=='Chests'and m.ChestPreviewSerial==resultSerial then m.ChestPreview(skin.Id);Tween:Create(chestView,TweenInfo.new(.4),{BackgroundColor3=C.Inset}):Play()end end)
            end
        end
    end
    m.RefreshShop();m.RefreshChest();u.Layout()
end
return Collection
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXConfig"><Properties><string name="Name">Config</string><ProtectedString name="Source">local Config = {}
Config.PrepTime=60
Config.Step=.1
Config.SnapshotInterval=.25
Config.VillageInterval={5,3,2}
Config.RecruitInterval={20,15,12}
Config.UpgradeCost={0,50,100}
Config.UpgradeDuration={0,6,10}
Config.Defense={0,.1,.2}
Config.Capacity={80,160,260}
Config.CastleCapacity={120,240,400}
Config.TowerCapacity={60,140,220}
Config.TowerRange={26,32,38}
Config.TowerInterval={2,1.8,1.6}
Config.TowerRoofHeight={9.915,11.187,12.374}
Config.Food={Initial=100,FarmInterval=5,Production={10,15,20},ConsumptionInterval=30}
Config.BotInterval={Easy=7,Normal=4,Hard=2.5}
Config.FormationColumns=4
Config.FormationSpacing=1.15
Config.RankSpacing=1.4
Config.MeleeContact=.85
Config.MeleeInterval=1
Config.MeleeImpactDelay=.25
Config.ArcherInterval=2
Config.TowerHealth=100
Config.TowerRadius=3.2
Config.SwordTowerDamage=5
Config.ArrowTowerDamage=2
Config.Types={'Peasant','Defender','Archer','Runner'}
Config.Units={
    Peasant={Name='Peasants',Health=30,Damage=3,Interval=1.5,Speed=8,Range=2,Priority=3},
    Defender={Name='Defenders',Health=100,Damage=12,Interval=1.2,Speed=6,Range=2,Shield=.35,Priority=1},
    Archer={Name='Archers',Health=45,Damage=25,Interval=1.5,Speed=7,Range=22,Priority=4},
    Runner={Name='Runners',Health=60,Damage=8,Interval=1,Speed=12,Range=2,Priority=2},
}
Config.Buildings={
    Castle={Name='Castle',Recruit='Defender',Height=17},
    Village={Name='Village',Recruit='Peasant',Height=8},
    Barracks={Name='Barracks',Recruit='Defender',Height=8},
    Archery={Name='Archery Range',Recruit='Archer',Height=8},
    Camp={Name='Camp',Recruit='Runner',Height=7},
    Tower={Name='Tower',Recruit='Archer',Height=13},
    Farm={Name='Farm',Height=8},
}
-- Imported buildings face the game camera (+Z). Their runtime root turns 180°.
Config.BuildingYaw=math.pi
-- Front doors after the turn; off-centre doors also move to the opposite X side.
Config.DoorOffsets={
    Castle={Vector3.new(0,0,5.13),Vector3.new(0,0,9),Vector3.new(0,0,9)},
    Village=Vector3.new(0,0,3.04),Barracks=Vector3.new(0,0,3.54),
    Archery=Vector3.new(1,0,2.04),Camp=Vector3.new(0,0,2.06),
    Tower=Vector3.new(0,0,2.5),Farm=Vector3.new(2,0,.04),
}
-- Rear Z extents of the existing Blender building meshes, by level.
Config.GarrisonRear={
    Castle={7.22739,9.55,10.65463},Village={4.16,4.68,4.68},
    Barracks={3.9,4.72,6.95},Archery={4.4,4.72,6.95},
    Camp={4,4.72,6.95},Farm={4.4,5,5.3},
}
Config.Colors={Color3.fromRGB(65,145,224),Color3.fromRGB(222,72,78),Color3.fromRGB(155,160,163)}
function Config.TeamColor(owner,viewerSide)
    if owner==0 then return Config.Colors[3] end
    return Config.Colors[owner==(viewerSide or 1) and 1 or 2]
end
return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEngine"><Properties><string name="Name">Engine</string><ProtectedString name="Source">local Config=require(script.Parent.Config)
local Map=require(script.Parent.MapData)
local Engine={}
Engine.__index=Engine
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function length(a,b) return (flat(a)-flat(b)).Magnitude end
local function direction(a,b)
    local d=flat(b-a)
    return d.Magnitude&gt;.001 and d.Unit or Vector3.new(1,0,0)
end
local function roster()
    return {Peasant=0,Defender=0,Archer=0,Runner=0}
end
local function melee(u)return u.Kind=='Defender' or u.Kind=='Runner'end
local function formation(path)
    local f={Path=path,Progress=0,Ids={},Cumulative={0},Hold=false,Columns=4,BridgeSpans={}}
    for i=2,#path do f.Cumulative[i]=f.Cumulative[i-1]+length(path[i-1],path[i])end
    f.Length=f.Cumulative[#path]
    return f
end
local function pathPoint(f,progress,offset)
    local path=f.Path
    if f.ExitLength and progress&lt;f.ExitLength then offset*=math.clamp(progress/f.ExitLength,0,1) end
    local function point(p,d)return p+Vector3.new(-d.Z,0,d.X)*offset end
    if progress&lt;=0 then local d=direction(path[1],path[2]);return point(path[1],d),2,d,false end
    for i=2,#path do if progress&lt;f.Cumulative[i]then
        local begin,finish=f.Cumulative[i-1],f.Cumulative[i];local t=(progress-begin)/(finish-begin)
        local d=direction(path[i-1],path[i]);local blended=d
        if i&gt;2 and progress-begin&lt;3 then blended=direction(path[i-2],path[i-1]):Lerp(d,.5+(progress-begin)/6)
        elseif i&lt;#path and finish-progress&lt;3 then blended=d:Lerp(direction(path[i],path[i+1]),.5-(finish-progress)/6)end
        if blended.Magnitude&gt;.01 then d=blended.Unit end
        return point(path[i-1]:Lerp(path[i],t),d),i,d,false
    end end
    local d=direction(path[#path-1],path[#path]);return point(path[#path],d),#path,d,true
end
local function formationPoint(f,u)
    return pathPoint(f,f.Progress-u.MarchRank*Config.RankSpacing,(u.MarchColumn-(f.Columns+1)/2)*Config.FormationSpacing)
end
local function door(site)
    local offset=Config.DoorOffsets[site.Kind]
    if typeof(offset)=='table' then offset=offset[site.Level] end
    return site.Position+(offset or Vector3.zero)
end
local function exitPath(site,points,useModel)
    local path=table.clone(points)
    if useModel then table.insert(path,1,door(site)) end
    return path
end
local function pathProgress(f,position)
    local best,bestGap=0,math.huge
    for i=2,#f.Path do
        local a,b=f.Path[i-1],f.Path[i];local d=direction(a,b)
        local t=math.clamp(flat(position-a):Dot(d),0,length(a,b))
        local gap=length(a+d*t,position)
        if gap&lt;bestGap then bestGap=gap;best=f.Cumulative[i-1]+t end
    end
    return best
end
local function compact(f,live,reflow)
    local soldiers,peasants={},{}
    for _,u in live do table.insert(u.Kind=='Peasant' and peasants or soldiers,u) end
    f.MeleeCount=#soldiers;f.HasMelee=#soldiers&gt;0
    local ranks=table.create(f.Columns,0)
    for i,u in soldiers do
        if reflow then u.MarchColumn=(i-1)%f.Columns+1 end
        u.MarchRank=ranks[u.MarchColumn];ranks[u.MarchColumn]+=1
    end
    local rear=0;for _,n in ranks do rear=math.max(rear,n) end
    for c=1,f.Columns do ranks[c]=rear end
    for i,u in peasants do
        if reflow then u.MarchColumn=(i-1)%f.Columns+1 end
        u.MarchRank=ranks[u.MarchColumn];ranks[u.MarchColumn]+=1
    end
    for _,u in live do u.Column=(u.MarchColumn-(f.Columns+1)/2)*Config.FormationSpacing end
    local frontColumns={}
    for _,u in soldiers do if u.MarchRank==0 then table.insert(frontColumns,u.MarchColumn) end end
    table.sort(frontColumns)
    f.FrontCount=#frontColumns;f.FrontColumns={}
    for slot,column in frontColumns do f.FrontColumns[column]=slot end
end
local function contactPoint(f,u)
    local contact=f.Contact
    local facing=contact.A==f and contact.Axis or -contact.Axis
    local center=contact.Center-facing*Config.MeleeContact*.5
    local column,columns=u.MarchColumn,f.Columns
    if u.MarchRank==0 then
        column=f.FrontColumns[u.MarchColumn]
        columns=math.max(contact.A.FrontCount,contact.B.FrontCount)
    end
    local offset=(column-(columns+1)/2)*Config.FormationSpacing
    return center-facing*u.MarchRank*Config.RankSpacing+Vector3.new(-facing.Z,0,facing.X)*offset,facing
end
local function clearContact(f)
    local contact=f.Contact
    if not contact then return end
    for _,other in {contact.A,contact.B} do
        if other.Contact==contact then other.Contact=nil;other.Reforming=true end
    end
end
function Engine.new(activeMap,options)
    local self=setmetatable({Time=0,Phase='Waiting',Sites={},Units={},Active={},NextId=0,NextSquad=0,Events={},BotClock=0,Winner=nil,LastBotTarget=nil},Engine)
    self.Map=activeMap or Map
    self.Difficulty=options and options.Difficulty or 'Hard'
    self.Food={Config.Food.Initial,Config.Food.Initial}
    self.FoodClock=0
    self.Impacts={}
    self.RowReady={}
    self.Formations={}
    for _,data in self.Map.Sites do
        local site={Id=data.Id,Kind=data.Kind,Position=data.Position,Entrance=data.Entrance,Owner=data.Owner,Zone=data.Zone,Level=1,Garrison={},RecruitClock=0,TrainClock=0,TowerClock=0,UpgradeUntil=nil,Supply=nil,Health=data.Kind=='Tower' and Config.TowerHealth or nil}
        self.Sites[site.Id]=site
        for _,kind in Config.Types do
            for _=1,(data.Initial[kind] or 0) do self:CreateUnit(kind,site.Owner,site) end
        end
    end
    return self
end
function Engine:Start()
    if self.Phase=='Waiting' then self.Phase='Preparation' end
end
function Engine:Capacity(site)
    local caps=site.Kind=='Castle' and Config.CastleCapacity or (site.Kind=='Tower' and Config.TowerCapacity or Config.Capacity)
    return caps[site.Level]
end
function Engine:CreateUnit(kind,side,site)
    self.NextId+=1
    local u={Id=self.NextId,Kind=kind,Side=side,Health=Config.Units[kind].Health,Position=site.Position,Home=site.Id,State='Garrison',Cooldown=0,Heading=Vector3.new(0,0,-1),AttackUntil=0}
    self.Units[u.Id]=u
    table.insert(site.Garrison,u.Id)
    return u
end
function Engine:Counts(site,includeOutside)
    local c=roster()
    for _,id in site.Garrison do
        local u=self.Units[id]
        if u then c[u.Kind]+=1 end
    end
    if includeOutside then
        for _,u in self.Active do if u.State=='Overflow' and u.Target==site.Id and u.Side==site.Owner then c[u.Kind]+=1 end end
    end
    return c
end
function Engine:Population(site,includeOutside)
    local c=self:Counts(site,includeOutside)
    return c.Peasant+c.Defender+c.Archer+c.Runner
end
function Engine:Detach(u)
    if u.Home and self.Sites[u.Home] then
        local list=self.Sites[u.Home].Garrison
        local index=table.find(list,u.Id)
        if index then table.remove(list,index) end
    end
    u.Home=nil
end
function Engine:TrainArrival(u,site)
    if u.Kind~='Peasant' then return end
    local kind=Config.Buildings[site.Kind].Recruit
    if not kind or kind=='Peasant' then u.PendingTraining=nil;return end
    if site.Owner~=u.Side then return end
    if u.Side~=0 and self.Food[u.Side]&lt;=0 then u.PendingTraining=site.Id;return end
    u.Kind=kind;u.Health=Config.Units[kind].Health;u.PendingTraining=nil
end
function Engine:Deposit(u,site)
    self:Detach(u)
    u.Formation=nil;u.Escort=nil;u.LoosePath=nil;u.LooseProgress=nil;u.MarchFinished=nil
    if self:Population(site)&gt;=self:Capacity(site) then
        u.State='Overflow'
        u.Target=site.Id
        u.Home=nil
        self.Active[u.Id]=u
        local waiting=0
        for _,v in self.Active do if v~=u and v.State=='Overflow' and v.Target==site.Id and v.Side==site.Owner then waiting+=1 end end
        local entry=site.Entrance or site.Position+Vector3.new(0,0,8)
        u.Position=entry+Vector3.new((waiting%4-1.5)*.95,0,2+math.floor(waiting/4)*.95)
        u.Height=.25
        return
    end
    self:TrainArrival(u,site)
    u.Home=site.Id
    u.Target=nil
    u.Path=nil
    u.State='Garrison'
    u.Position=site.Position
    self.Active[u.Id]=nil
    table.insert(site.Garrison,u.Id)
end
function Engine:Capture(site,side)
    -- Protected archers fall with the occupied building, rather than blocking capture forever.
    for _,id in table.clone(site.Garrison) do
        local guard=self.Units[id]
        if guard and guard.Side~=side then self:RemoveUnit(guard) end
    end
    site.Owner=side
    site.UpgradeUntil=nil
    site.RecruitClock=0
    site.TrainClock=0
    site.Supply=nil
    if site.Kind=='Tower' then site.Health=Config.TowerHealth end
    for _,s in self.Sites do if s.Supply and s.Supply.Target==site.Id then s.Supply=nil end end
    table.insert(self.Events,{Type='Capture',Site=site.Id,Side=side})
end
function Engine:Available(site,filter)
    local list={}
    for _,id in site.Garrison do
        local u=self.Units[id]
        if u and u.State~='Deploying' and (not filter or filter=='All' or u.Kind==filter) then table.insert(list,u) end
    end
    for _,u in self.Active do
        if u.State=='Overflow' and u.Target==site.Id and u.Side==site.Owner and (not filter or filter=='All' or u.Kind==filter) then table.insert(list,u) end
    end
    table.sort(list,function(a,b)
        local x,y=Config.Units[a.Kind].Priority,Config.Units[b.Kind].Priority
        return x==y and a.Id&lt;b.Id or x&lt;y
    end)
    return list
end
function Engine:RouteForSide(side,from,to,preferred)
    local open=self.Time&gt;=Config.PrepTime
    local points,ids=self.Map.Route(from,to,open,preferred or 'Auto',function(id)
        return self.Sites[id] and self.Sites[id].Owner==side
    end)
    if points then return points,ids end
    local _,blocked=self.Map.Route(from,to,open,preferred or 'Auto')
    for i=2,#(blocked or {})-1 do
        local s=self.Sites[blocked[i]]
        if s and s.Owner~=side then return nil,nil,'Route blocked: capture the intermediate '..Config.Buildings[s.Kind].Name..' first. No alternative route is available.' end
    end
    return nil
end
function Engine:BeginDeparture(u)
    if not u.GuardDeparture then self:Detach(u) end
    u.State=u.GuardDeparture and 'Defending' or 'Marching'
    u.DeployAt=nil;self.Active[u.Id]=u
end
function Engine:ReleaseArchers()
    for _,u in self.Units do
        if u.State=='Deploying' and not u.Formation and self.Time&gt;=(u.DeployAt or math.huge) then self:BeginDeparture(u) end
    end
end
function Engine:Send(side,sources,targetId,percent,filter,preferred)
    if self.Phase=='Waiting' or self.Phase=='Ended' then return false,'The battle has not started or has already ended.' end
    local target=self.Sites[targetId]
    if not target then return false,'Select a building on the map.' end
    if typeof(percent)~='number' or percent~=percent then return false,'Invalid troop percentage.' end
    percent=math.clamp(percent,1,100)
    if filter~='All' and not Config.Units[filter] then return false,'Invalid unit type.' end
    if preferred~='North' and preferred~='South' then preferred='Auto' end
    if typeof(sources)~='table' or #sources&gt;80 then return false,'Invalid building list.' end
    local sent=0
    local blockedReason=nil
    local seen={}
    for _,sourceId in sources do
        local source=self.Sites[sourceId]
        if source and not seen[sourceId] and source.Owner==side and source.Id~=target.Id then
            seen[sourceId]=true
            local points,routeIds,reason=self:RouteForSide(side,source.Id,target.Id,preferred)
            blockedReason=blockedReason or reason
            if points then
                local available=self:Available(source,filter)
                local selected={}
                if filter=='All' then
                    for _,kind in Config.Types do
                        local group={}
                        for _,u in available do if u.Kind==kind then table.insert(group,u) end end
                        for i=1,math.floor(#group*percent/100+1e-7) do table.insert(selected,group[i]) end
                    end
                    table.sort(selected,function(a,b) return Config.Units[a.Kind].Priority&lt;Config.Units[b.Kind].Priority end)
                else
                    for i=1,math.floor(#available*percent/100+1e-7) do table.insert(selected,available[i]) end
                end
                local n=#selected
                self.NextSquad+=1
                points=exitPath(source,points,self.Map.Sites~=nil)
                if target.Owner~=side and self.Map.Sites then
                    local finish=target.Kind=='Tower' and target.Position or door(target)
                    if length(points[#points],finish)&gt;.01 then table.insert(points,finish) end
                elseif target.Kind=='Tower' and target.Owner~=side and target.Health&gt;0 then table.insert(points,target.Position) end
                local heading=direction(points[1],points[2])
                local f=formation(points);local orderedCount,looseCount=0,0
                f.ExitLength=self.Map.Sites and length(points[1],points[2]) or nil
                f.RouteIds=routeIds;f.Side=side;f.Source=source.Id;f.Target=target.Id
                f.MeleeCount=0;for _,unit in selected do if melee(unit)then f.MeleeCount+=1 end end
                if self.Map.River then
                    for j=2,#points do
                        local a,b=points[j-1],points[j]
                        if math.abs(a.Z-b.Z)&lt;.01 and math.min(a.X,b.X)&lt;16 and math.max(a.X,b.X)&gt;-16 then
                            local begin=f.Cumulative[j-1]+math.max(0,math.min(-16,16)-math.min(a.X,b.X))
                            local finish=f.Cumulative[j]-math.max(0,math.max(a.X,b.X)-16)
                            if a.X&gt;b.X then begin=f.Cumulative[j-1]+math.max(0,a.X-16);finish=f.Cumulative[j]-math.max(0,-16-b.X)end
                            if finish&gt;begin then table.insert(f.BridgeSpans,{begin,finish})end
                        end
                    end
                end
                for i=1,n do
                    local u=selected[i]
                    local inside=u.Home==source.Id and (u.State=='Garrison' or u.State=='Defending')
                    if not inside then self:Detach(u) end
                    u.State=inside and 'Deploying' or 'Marching'
                    u.GuardDeparture=nil;u.ExitTravel=nil;u.Escort=nil;u.LoosePath=nil;u.LooseProgress=nil
                    u.Target=target.Id
                    u.Path=points
                    u.PathIndex=2
                    u.Squad=self.NextSquad
                    u.Height=.25
                    if u.Kind~='Archer'then
                        orderedCount+=1;u.Formation=f;table.insert(f.Ids,u.Id)
                        local slot=u.Kind=='Peasant'and math.ceil(f.MeleeCount/4)*4+orderedCount-f.MeleeCount or orderedCount
                        u.MarchColumn=(slot-1)%Config.FormationColumns+1;u.MarchRank=math.floor((slot-1)/Config.FormationColumns)
                        u.Column=(u.MarchColumn-(Config.FormationColumns+1)/2)*Config.FormationSpacing;u.FormationIndex=orderedCount
                        if not inside then
                            f.Progress=math.max(f.Progress,pathProgress(f,u.Position)+u.MarchRank*Config.RankSpacing)
                            f.Reforming=true
                        end
                    else
                        looseCount+=1;u.Formation=nil;u.Column=((looseCount*7)%9-4)*.35;u.FormationIndex=i
                        u.Escort=f.MeleeCount&gt;0 and f or nil
                        u.LoosePath=f;u.LooseProgress=inside and 0 or pathProgress(f,u.Position)
                        u.DeployAt=self.Time+math.floor((looseCount-1)/Config.FormationColumns)*Config.RankSpacing/Config.Units.Archer.Speed
                    end
                    if inside then u.Position=points[1];self.Active[u.Id]=nil end
                    u.Heading=heading
                    if not inside then self.Active[u.Id]=u end
                    sent+=1
                end
                if orderedCount&gt;0 then self.Formations[self.NextSquad]=f end
            end
        end
    end
    if sent==0 then return false,blockedReason or (self.Time&lt;Config.PrepTime and 'Crossings stay closed during preparation, or no selected units are available.' or 'No available units or route to the target.') end
    return true,'Units sent: '..sent
end
function Engine:UpgradeCost(site)
    if site.Level&gt;=3 then return nil end
    local result=roster()
    local remaining=Config.UpgradeCost[site.Level+1]
    local c=self:Counts(site)
    for _,kind in {'Peasant','Runner','Defender','Archer'} do
        result[kind]=math.min(c[kind],remaining)
        remaining-=result[kind]
    end
    return result,remaining==0
end
function Engine:Upgrade(side,id)
    local site=self.Sites[id]
    if not site or site.Owner~=side then return false,'You can only upgrade your own buildings.' end
    if self.Phase=='Waiting' or self.Phase=='Ended' then return false,'Upgrades are available during battle.' end
    if site.Level&gt;=3 then return false,'Maximum level reached.' end
    if site.Kind=='Tower' and site.Health&lt;=0 then return false,'Send troops to rebuild the tower.' end
    if site.UpgradeUntil then return false,'Construction is already in progress.' end
    local consume,affordable=self:UpgradeCost(site)
    if not affordable then return false,'The garrison needs '..Config.UpgradeCost[site.Level+1]..' units.' end
    local list=table.clone(site.Garrison)
    for _,kind in {'Peasant','Runner','Defender','Archer'} do
        local left=consume[kind]
        for _,unitId in list do
            local u=self.Units[unitId]
            if left&gt;0 and u and u.Kind==kind then self:RemoveUnit(u); left-=1 end
        end
    end
    site.TrainClock=0
    site.UpgradeUntil=self.Time+Config.UpgradeDuration[site.Level+1]
    return true,'Upgrading to level '..(site.Level+1)
end
function Engine:SetSupply(side,id,targetId,reserve,filter)
    local site,target=self.Sites[id],self.Sites[targetId]
    if not site or site.Owner~=side then return false,'Select one of your buildings.' end
    if not targetId then site.Supply=nil return true,'Auto-supply disabled.' end
    if not target or target.Owner~=side or target==site then return false,'Select another friendly building to supply.' end
    if typeof(reserve)~='number' or reserve~=reserve then return false,'Set a reserve amount.' end
    filter=filter or 'All'
    if filter~='All' and not Config.Units[filter] then return false,'Invalid unit type.' end
    reserve=math.clamp(math.floor(reserve),0,400)
    local clock=site.Supply and site.Supply.Clock or 0
    site.Supply={Target=target.Id,Reserve=reserve,Filter=filter,Clock=clock}
    return true,'Supply line enabled.'
end
function Engine:RemoveUnit(u)
    self:Detach(u)
    self.Active[u.Id]=nil
    self.Units[u.Id]=nil
end
function Engine:Produce(dt)
    local waiting={}
    for _,u in self.Active do if u.State=='Overflow' then table.insert(waiting,u) end end
    table.sort(waiting,function(a,b)return a.Id&lt;b.Id end)
    for _,u in waiting do
        local site=self.Sites[u.Target]
        if site and site.Owner==u.Side and self:Population(site)&lt;self:Capacity(site) then self:Deposit(u,site)
        elseif site and site.Owner~=u.Side then
            u.State='Marching';u.Path={u.Position,site.Entrance or site.Position};u.PathIndex=2;u.Column=0
            local finish=site.Kind=='Tower' and site.Position or door(site)
            if length(u.Path[#u.Path],finish)&gt;.01 then table.insert(u.Path,finish) end
        end
    end
    for _,site in self.Sites do
        if site.Owner==0 then continue end
        if site.Kind=='Tower' and site.Health&lt;=0 then site.RecruitClock=0;continue end
        if site.UpgradeUntil then
            if self.Time&gt;=site.UpgradeUntil then site.Level+=1 site.UpgradeUntil=nil end
            continue
        end
        if site.Kind=='Farm' then
            site.RecruitClock+=dt
            while site.RecruitClock+1e-7&gt;=Config.Food.FarmInterval do
                site.RecruitClock-=Config.Food.FarmInterval
                self.Food[site.Owner]+=Config.Food.Production[site.Level]
            end
        elseif self:Population(site)&lt;self:Capacity(site) and (site.Kind=='Village' or self.Food[site.Owner]&gt;0) then
            local interval=site.Kind=='Village' and Config.VillageInterval[site.Level] or Config.RecruitInterval[site.Level]
            site.RecruitClock+=dt
            while site.RecruitClock&gt;=interval and self:Population(site)&lt;self:Capacity(site) do
                site.RecruitClock-=interval
                self:CreateUnit(Config.Buildings[site.Kind].Recruit,site.Owner,site)
            end
        else site.RecruitClock=0 end
        if site.Supply then
            local s=site.Supply
            local target=self.Sites[s.Target]
            if not target or target.Owner~=site.Owner then site.Supply=nil continue end
            s.Clock+=dt
            if s.Clock&gt;=5 then
                s.Clock=0
                local list=self:Available(site,s.Filter)
                local excess=#list-s.Reserve
                if excess&gt;0 then
                    self:Send(site.Owner,{site.Id},s.Target,math.min(100,(excess+.01)/#list*100),s.Filter,'Auto')
                end
            end
        end
    end
    for _,u in self.Units do
        if u.PendingTraining then
            local site=self.Sites[u.PendingTraining]
            if site and site.Owner==u.Side and u.Home==site.Id then self:TrainArrival(u,site) end
        end
    end
    self.FoodClock+=dt
    if self.FoodClock+1e-7&gt;=Config.Food.ConsumptionInterval then
        self.FoodClock-=Config.Food.ConsumptionInterval
        local cost={0,0}
        for _,u in self.Units do if u.Side~=0 and u.Kind~='Peasant' then cost[u.Side]+=1 end end
        for side=1,2 do self.Food[side]=math.max(0,self.Food[side]-cost[side]) end
    end
end
function Engine:WakeGuards()
    for _,site in self.Sites do
        local tower=site.Kind=='Tower' and site.Health&gt;0
        if site.Kind=='Tower' and not tower then continue end
        local closest,distance=nil,tower and Config.TowerRange[site.Level] or 29
        for _,u in self.Active do
            if u.Side~=site.Owner and not u.Dying and u.State~='Defending' and (site.Owner~=0 or tower or u.Target==site.Id) then
                local d=length(u.Position,site.Position)
                if d&lt;distance then closest,distance=u,d end
            end
        end
        if closest then
            local dir=direction(site.Position,closest.Position);local archers={}
            for _,id in site.Garrison do
                local u=self.Units[id]
                if u and u.Kind=='Archer' and (u.State=='Garrison' or u.State=='Defending') then table.insert(archers,u) end
            end
            for i,u in archers do
                local column=((i-1)%Config.FormationColumns-(Config.FormationColumns-1)/2)*Config.FormationSpacing
                local row=math.floor((i-1)/Config.FormationColumns)*Config.RankSpacing
                if tower then
                    u.Position=site.Position+Vector3.new(column,0,row-1.2)
                    u.Height=Config.TowerRoofHeight[site.Level]
                else
                    -- Every incoming road ends at the front door; the rear emplacement is behind the model.
                    local rear=Config.GarrisonRear[site.Kind][site.Level]
                    u.Position=site.Position+Vector3.new(column,0,-rear-Config.RankSpacing-row)
                    u.Height=.25
                end
                u.State='Defending';u.Heading=dir;u.FormationIndex=i;u.Formation=nil;u.Squad=nil
                self.Active[u.Id]=u
            end
        else
            for _,id in site.Garrison do
                local u=self.Units[id]
                if u and u.State=='Defending' then
                    u.State='Garrison';u.Position=site.Position;u.Height=.25;u.Formation=nil;u.GuardDeparture=nil;u.ExitTravel=nil;u.DeployAt=nil;self.Active[id]=nil
                end
            end
        end
    end
end
function Engine:BuildSpatial()
    local spatial={}
    for _,u in self.Active do
        local key=math.floor(u.Position.X/24)..':'..math.floor(u.Position.Z/24)
        if not spatial[key] then spatial[key]={} end
        table.insert(spatial[key],u)
    end
    return spatial
end
function Engine:Protected(u)
    local home=u.Home and self.Sites[u.Home]
    return home and home.Owner==u.Side and u.State=='Defending' and u.Kind=='Archer'
        and (home.Kind~='Tower' or home.Health&gt;0)
end
function Engine:NearestEnemy(u,spatial,range,pending)
    local cx,cz=math.floor(u.Position.X/24),math.floor(u.Position.Z/24)
    local steps=math.ceil(range/24)
    local best,distance=nil,range
    for x=cx-steps,cx+steps do for z=cz-steps,cz+steps do
        for _,v in (spatial[x..':'..z] or {}) do
            local rearSword=melee(u) and melee(v) and v.Formation and v.MarchRank~=0
            if v.Side~=u.Side and not rearSword and not self:Protected(v) and v.Health-(v.IncomingDamage or 0)&gt;0 and not v.Dying and not pending[v.Id] then
                local d=length(u.Position,v.Position)
                if d&lt;distance then best,distance=v,d end
            end
        end
    end end
    return best,distance
end
function Engine:Damage(u,amount,arrow)
    if arrow then amount*=1-(Config.Units[u.Kind].Shield or 0) end
    if (u.State=='Defending' or u.State=='Garrison') and u.Home then
        local home=self.Sites[u.Home]
        if home and home.Owner==u.Side and length(home.Position,u.Position)&lt;=10 then amount*=1-Config.Defense[home.Level] end
    end
    return amount
end
local function sword(u) return u.Kind=='Defender' or u.Kind=='Runner' end
local function groupKey(u) return u.Side..':'..tostring(u.Squad or u.Home or u.Id) end
function Engine:OccupationBlocked(site)
    if site.Kind=='Tower' and site.Health&gt;0 then return true end
    for _,id in site.Garrison do
        local u=self.Units[id]
        if u and u.Kind~='Archer' then return true end
    end
    return false
end
function Engine:GarrisonDefenders(site)
    local guards={}
    for _,id in site.Garrison do
        local u=self.Units[id]
        if u and u.Kind~='Archer' and u.State=='Garrison' and not u.Dying
            and u.Health-(u.IncomingDamage or 0)&gt;0 then table.insert(guards,u) end
    end
    table.sort(guards,function(a,b)
        local x,y=Config.Units[a.Kind].Priority,Config.Units[b.Kind].Priority
        return x==y and a.Id&lt;b.Id or x&lt;y
    end)
    return guards
end
function Engine:GarrisonDistance(u,site)
    local f=u.Formation
    if f and f.Target==site.Id then
        return math.max(0,f.Length-f.Progress+(u.MarchRank or 0)*Config.RankSpacing-(site.Kind=='Tower' and Config.TowerRadius or 0))
    end
    local anchor=site.Kind=='Tower' and site.Position or door(site)
    return math.max(0,length(u.Position,anchor)-(site.Kind=='Tower' and Config.TowerRadius or 0))
end
function Engine:TowerTarget(u,range)
    local best,distance=nil,range+Config.TowerRadius
    for _,s in self.Sites do
        if s.Kind=='Tower' and s.Owner~=u.Side and s.Health&gt;0 then
            local d=length(u.Position,s.Position)
            if d&lt;distance then best,distance=s,d end
        end
    end
    return best,distance
end
function Engine:QueueHit(u,delay,kind,amount)
    table.insert(self.Impacts,{At=self.Time+delay,Unit=u.Id,Kind=kind,Amount=amount})
    if kind=='Kill' then u.Dying=true end
    if kind=='Damage'then u.IncomingDamage=(u.IncomingDamage or 0)+amount end
end
function Engine:ResolveImpacts()
    for i=#self.Impacts,1,-1 do
        local hit=self.Impacts[i]
        if hit.At&gt;self.Time then continue end
        table.remove(self.Impacts,i)
        if hit.Tower then
            local tower=self.Sites[hit.Tower]
            if tower and tower.Owner==hit.Owner and tower.Health&gt;0 then
                tower.Health=math.max(0,tower.Health-hit.Amount*(1-Config.Defense[tower.Level]))
                if tower.Health&lt;=0 then
                    local list=table.clone(tower.Garrison)
                    for _,id in list do if self.Units[id] then self:RemoveUnit(self.Units[id]) end end
                    tower.UpgradeUntil=nil;tower.Supply=nil
                    table.insert(self.Events,{Type='Collapse',Site=tower.Id})
                end
            end
        else
            local u=self.Units[hit.Unit]
            if u then
                if hit.Kind=='Kill' then self:RemoveUnit(u)
                else u.IncomingDamage=math.max(0,(u.IncomingDamage or 0)-hit.Amount);u.Health-=hit.Amount;if u.Health&lt;=0 then self:RemoveUnit(u) end end
            end
        end
    end
end
function Engine:MoveFormations(dt,spatial)
    for id,f in self.Formations do
        if f.Contact then
            local other=f.Contact.A==f and f.Contact.B or f.Contact.A
            local present=false
            for _,unitId in other.Ids do
                local u=self.Units[unitId]
                if u and u.Formation==other and melee(u) and not u.Dying then present=true;break end
            end
            if not present then clearContact(f) end
        end
        local live={};local speed=math.huge
        for _,unitId in f.Ids do
            local u=self.Units[unitId]
            if u and u.Formation==f and (u.State=='Marching' or u.State=='Deploying' or f.GuardHome and u.State=='Defending') and not u.Dying then
                table.insert(live,u);speed=math.min(speed,Config.Units[u.Kind].Speed)
            end
        end
        if #live==0 then
            clearContact(f)
            self.Formations[id]=nil
            if f.GuardHome and self.Sites[f.GuardHome].GuardFormation==f then self.Sites[f.GuardHome].GuardFormation=nil end
            continue
        end
        local columns=4
        for _,span in f.BridgeSpans do
            if f.Progress&gt;=span[1]-22 and f.Progress&lt;=span[2]+math.ceil(#live/2)*Config.RankSpacing+22 then columns=2;break end
        end
        local changed=columns~=f.Columns
        f.Columns=columns
        if changed or f.LiveCount~=#live or f.LayoutDirty then
            compact(f,live,changed or f.LayoutDirty)
            if f.LiveCount or changed then f.Reforming=true end
            f.LiveCount=#live;f.LayoutDirty=nil
        end
        f.Hold=false
        local advance=speed*dt
        local siegeGap=nil
        for _,u in live do
            if u.MarchRank~=0 or u.State=='Deploying' then continue end
            if f.ExitLength and f.Progress&lt;f.ExitLength then continue end
            local range=melee(u) and Config.MeleeContact or Config.Units[u.Kind].Range
            local enemy,distance=self:NearestEnemy(u,spatial,12,{})
            local tower,towerDistance=self:TowerTarget(u,12)
            if enemy and (not tower or distance&lt;=towerDistance) then
                f.Hold=true
                advance=math.min(advance,math.max(0,distance-range))
            elseif tower then
                f.Hold=true
                siegeGap=math.max(siegeGap or 0,towerDistance-range-Config.TowerRadius)
            end
        end
        if siegeGap then advance=math.min(advance,math.max(0,siegeGap)) end
        local destination=self.Sites[f.Target]
        if destination and destination.Owner~=f.Side and destination.Kind~='Tower' and self:OccupationBlocked(destination) then
            f.Hold=true
            advance=math.min(advance,math.max(0,f.Length-f.Progress-Config.MeleeContact))
        end
        if f.Contact then f.Hold=true;advance=0 end
        if f.Reforming then advance=0 end
        -- Combat closes the gap by advancing along the existing road.
        -- Every rank keeps its own position on that curved path; the army never straightens across the map.
        f.Progress+=advance
        if f.GuardHome then f.Progress=math.min(f.Progress,f.Length) end
        local center,_,heading=formationPoint(f,{MarchRank=0,MarchColumn=(columns+1)/2})
        f.RoadCenter=center;f.RoadHeading=heading
        local complete=true
        for _,u in live do
            local progress=f.Progress-u.MarchRank*Config.RankSpacing
            if u.State=='Deploying' then
                if progress&lt;0 then continue end
                self:BeginDeparture(u)
                if f.ExitLength and progress&gt;f.ExitLength then
                    local heading=direction(f.Path[1],f.Path[2])
                    u.ExitTravel=f.Path[2]+Vector3.new(-heading.Z,0,heading.X)*u.Column
                end
            end
            local target,index,facing,finished=formationPoint(f,u)
            local staging=f.Contact and melee(u) and u.MarchRank&lt;=2
            if staging then
                local contactTarget,contactFacing=contactPoint(f,u)
                local blend=u.MarchRank==0 and 1 or (u.MarchRank==1 and .6 or .3)
                target=target:Lerp(contactTarget,blend);facing=facing:Lerp(contactFacing,blend).Unit;finished=false
            end
            if u.ExitTravel then
                target=u.ExitTravel;facing=direction(u.Position,target);finished=false
                if length(u.Position,target)&lt;=Config.Units[u.Kind].Speed*dt then u.ExitTravel=nil end
            end
            if f.Reforming or u.ExitTravel or staging then
                local gap=length(u.Position,target)
                if gap&gt;.04 then complete=false;u.Position+=direction(u.Position,target)*math.min(Config.Units[u.Kind].Speed*dt,gap)end
            else u.Position=target end
            u.Heading=facing;u.PathIndex=index;u.MarchFinished=finished and not f.Reforming
        end
        if f.Reforming and complete then f.Reforming=false end
    end
end
function Engine:Advance(u,dt,spatial)
    if u.State~='Marching' or u.Dying then return end
    if u.Formation then
        if not u.MarchFinished then return end
        local site=self.Sites[u.Target]
        if site.Owner==u.Side then if site.Kind=='Tower'and site.Health&lt;=0 then site.Health=Config.TowerHealth end;self:Deposit(u,site)
        elseif not self:OccupationBlocked(site) then self:Capture(site,u.Side);self:Deposit(u,site)end
        return
    end
    if u.LoosePath then
        local path=u.LoosePath
        local progress=math.min(path.Length,u.LooseProgress+Config.Units[u.Kind].Speed*dt)
        if u.Escort then
            local f=u.Escort
            if self.Formations[u.Squad]~=f or not f.HasMelee then u.Escort=nil
            else progress=math.max(u.LooseProgress,math.min(progress,math.max(0,f.Progress-Config.RankSpacing))) end
        end
        local target,index,facing,finished=pathPoint(path,progress,u.Column)
        local gap=length(u.Position,target);local step=Config.Units[u.Kind].Speed*dt
        if gap&gt;.001 then u.Position+=direction(u.Position,target)*math.min(step,gap) end
        if gap&lt;=step+.001 then u.LooseProgress=progress end
        u.Heading=facing;u.PathIndex=index
        if finished and gap&lt;=step+.001 then
            local site=self.Sites[u.Target]
            if site.Owner==u.Side then
                if site.Kind=='Tower' and site.Health&lt;=0 then site.Health=Config.TowerHealth end
                self:Deposit(u,site)
            elseif not self:OccupationBlocked(site) then self:Capture(site,u.Side);self:Deposit(u,site) end
        end
        return
    end
    local waypoint=u.Path[u.PathIndex]
    if not waypoint then return end
    local d=direction(u.Path[u.PathIndex-1],waypoint)
    local destination=waypoint+Vector3.new(-d.Z,0,d.X)*u.Column
    local gap=length(u.Position,destination)
    u.Heading=direction(u.Position,destination)
    local step=math.min(Config.Units[u.Kind].Speed*dt,gap)
    -- A rear rank waits behind its own front rank instead of walking through it.
    local cx,cz=math.floor(u.Position.X/24),math.floor(u.Position.Z/24)
    for x=cx-1,cx+1 do for z=cz-1,cz+1 do
        for _,v in spatial[x..':'..z] or {} do
            if melee(u) and melee(v) and v~=u and v.Side==u.Side and v.Squad==u.Squad and v.State=='Marching'
                and (v.FormationIndex or v.Id)&lt;(u.FormationIndex or u.Id) and math.abs((v.Column or 0)-(u.Column or 0))&lt;.1 and v.PathIndex==u.PathIndex then
                local offset=flat(v.Position-u.Position)
                local forward=offset:Dot(u.Heading)
                local lateral=math.abs(offset:Dot(Vector3.new(-u.Heading.Z,0,u.Heading.X)))
                if forward&gt;0 and forward&lt;1.05 and lateral&lt;.45 then step=math.min(step,math.max(0,forward-.95)) end
            end
        end
    end end
    u.Position+=u.Heading*step
    if gap&lt;=step+.15 then
        if u.PathIndex&lt;#u.Path then u.PathIndex+=1
        else
            local site=self.Sites[u.Target]
            if site.Owner==u.Side then
                if site.Kind=='Tower' and site.Health&lt;=0 then site.Health=Config.TowerHealth end
                self:Deposit(u,site)
            elseif not self:OccupationBlocked(site) then self:Capture(site,u.Side);self:Deposit(u,site) end
        end
    end
end
function Engine:GarrisonSwing(site,attacker)
    local forward=attacker.Heading
    local from=attacker.Position+forward*Config.MeleeContact+Vector3.new(0,1.4,0)
    table.insert(self.Events,{Type='GarrisonSwing',Site=site.Id,From=from,To=attacker.Position+Vector3.new(0,1.4,0),Side=site.Owner})
end
function Engine:CombatGarrison(u,site,front,inFront,pending)
    local guards=self:GarrisonDefenders(site)
    if #guards==0 then return false end
    local distance=self:GarrisonDistance(u,site)
    local guardKey='garrison:'..site.Id
    if u.Kind=='Archer' then
        -- A bowman that reaches the door without an escort still loses to a melee defender immediately.
        if distance&lt;=Config.MeleeContact+.15 and melee(guards[1]) then
            if self.Time+1e-7&gt;=(self.RowReady[guardKey] or 0) then
                self.RowReady[guardKey]=self.Time+Config.MeleeInterval
                self:GarrisonSwing(site,u);self:QueueHit(u,Config.MeleeImpactDelay,'Kill');pending[u.Id]=true
            end
            return true
        end
        if site.Kind=='Tower' then return false end
        if distance&lt;=Config.Units.Archer.Range+.15 then
            if u.Cooldown&lt;=0 then
                local defender=guards[1]
                u.Cooldown=Config.ArcherInterval;u.AttackUntil=self.Time+.35
                self:QueueHit(defender,.3,'Damage',self:Damage(defender,Config.Units.Archer.Damage,true))
                table.insert(self.Events,{Type='Arrow',From=u.Position+Vector3.new(0,(u.Height or .25)+1.4,0),To=door(site)+Vector3.new(0,1.1,0),Side=u.Side})
            end
            return true
        end
        return false
    end
    if not inFront(u) or (u.Formation and u.Formation.Reforming) or distance&gt;Config.MeleeContact+.15 then return false end
    local key=groupKey(u)
    if self.Time+1e-7&lt;(self.RowReady[key] or 0) or self.Time+1e-7&lt;(self.RowReady[guardKey] or 0) then return true end
    local attackers=sword(u) and front[key] or {u};local pairs={}
    for _,attacker in attackers do
        if #pairs&gt;=#guards then break end
        if attacker.Target==site.Id and inFront(attacker) and not attacker.Dying and not pending[attacker.Id]
            and not attacker.ExitTravel and not (attacker.Formation and attacker.Formation.Reforming)
            and self:GarrisonDistance(attacker,site)&lt;=Config.MeleeContact+.15 then
            table.insert(pairs,{attacker,guards[#pairs+1]})
        end
    end
    if #pairs==0 then return true end
    self.RowReady[key]=self.Time+Config.MeleeInterval;self.RowReady[guardKey]=self.Time+Config.MeleeInterval
    for _,pair in pairs do
        local attacker,defender=pair[1],pair[2]
        attacker.Cooldown=Config.MeleeInterval;attacker.AttackUntil=self.Time+.55
        if sword(attacker) then
            self:QueueHit(defender,Config.MeleeImpactDelay,'Kill');pending[defender.Id]=true
        else
            attacker.Cooldown=Config.Units[attacker.Kind].Interval
            self:QueueHit(defender,.3,'Damage',self:Damage(defender,Config.Units[attacker.Kind].Damage,false))
        end
        if sword(defender) then
            self:GarrisonSwing(site,attacker);self:QueueHit(attacker,Config.MeleeImpactDelay,'Kill');pending[attacker.Id]=true
        elseif self.Time+1e-7&gt;=(defender.NextGuardAttack or 0) then
            defender.NextGuardAttack=self.Time+Config.Units[defender.Kind].Interval
            self:GarrisonSwing(site,attacker)
            self:QueueHit(attacker,.3,'Damage',self:Damage(attacker,Config.Units[defender.Kind].Damage,false))
        end
    end
    return true
end
function Engine:CombatAndMove(dt)
    self:ResolveImpacts()
    self:ReleaseArchers()
    local spatial=self:BuildSpatial()
    self:MoveFormations(dt,spatial);spatial=self:BuildSpatial()
    local pending={}
    local active={}
    for _,u in self.Active do table.insert(active,u) end
    table.sort(active,function(a,b)return a.Id&lt;b.Id end)
    local front={}
    local meleeTargets={}
    for _,u in active do
        if sword(u) and not u.Dying then
            local key=groupKey(u);front[key]=front[key] or {}
            table.insert(front[key],u)
        end
    end
    for _,list in front do
        table.sort(list,function(a,b)return (a.FormationIndex or a.Id)&lt;(b.FormationIndex or b.Id) end)
    end
    local function inFront(u)
        if u.Formation then return u.MarchRank==0 end
        local list=front[groupKey(u)]
        if not list then return true end
        local index=table.find(list,u)
        local columns=u.Formation and u.Formation.Columns or (self.Map.River and math.abs(u.Position.X)&lt;17 and 2 or Config.FormationColumns)
        return index and index&lt;=columns
    end
    -- Only the two front rows turn to face each other at a bend. Rear ranks keep following their road.
    for _,u in active do
        local f=u.Formation
        if not sword(u) or u.Dying or not f or f.Contact or not inFront(u) or u.ExitTravel then continue end
        if f.ExitLength and f.Progress&lt;f.ExitLength then continue end
        local foe,gap=nil,Config.MeleeContact+.4
        for _,v in active do
            local other=v.Formation
            if sword(v) and not v.Dying and other and other~=f and not other.Contact and v.Side~=u.Side
                and inFront(v) and not v.ExitTravel and not self:Protected(v)
                and (not other.ExitLength or other.Progress&gt;=other.ExitLength) then
                local d=length(u.Position,v.Position)
                if d&lt;gap then foe=v;gap=d end
            end
        end
        if foe then
            local other=foe.Formation
            local a,b=f.RoadCenter,other.RoadCenter
            local contact={A=f,B=other,Center=(a+b)*.5,Axis=direction(a,b)}
            f.Contact=contact;other.Contact=contact
            f.Hold=true;other.Hold=true
        end
    end
    local function frontReady(f,list)
        if not f or not f.Contact then return true end
        if f.Reforming then return false end
        for _,u in list do if inFront(u) and not u.Dying then
            if u.ExitTravel or length(u.Position,contactPoint(f,u))&gt;.06 then return false end
        end end
        return true
    end
    local function exchange(u,enemy)
        local a,b=groupKey(u),groupKey(enemy)
        if not inFront(enemy) or self.Time+1e-7&lt;(self.RowReady[a] or 0) or self.Time+1e-7&lt;(self.RowReady[b] or 0) then return end
        local left,right=front[a] or {},front[b] or {}
        if not frontReady(u.Formation,left) or not frontReady(enemy.Formation,right) then return end
        local pairs,claimed={},{}
        for _,v in left do if inFront(v) and not v.Dying and not pending[v.Id] then
            local target,gap=nil,Config.MeleeContact+.15
            for _,w in right do
                if inFront(w) and not w.Dying and not pending[w.Id] and not claimed[w.Id] and w.Health-(w.IncomingDamage or 0)&gt;0 then
                    local d=length(v.Position,w.Position)
                    if d&lt;=gap then target=w;gap=d end
                end
            end
            if target then table.insert(pairs,{v,target});claimed[target.Id]=true end
        end end
        if #pairs==0 then return end
        self.RowReady[a]=self.Time+Config.MeleeInterval;self.RowReady[b]=self.Time+Config.MeleeInterval
        for _,pair in pairs do for _,v in pair do
            v.AttackUntil=self.Time+.55
            self:QueueHit(v,Config.MeleeImpactDelay,'Kill');pending[v.Id]=true
        end end
    end
    for _,u in active do
        if not self.Units[u.Id] or u.Dying then continue end
        u.Cooldown=math.max(0,u.Cooldown-dt)
        local stats=Config.Units[u.Kind]
        local host=u.Home and self.Sites[u.Home]
        local mounted=host and host.Kind=='Tower' and host.Health&gt;0
        if u.ExitTravel then
            if u.Formation then continue end
            local gap=length(u.Position,u.ExitTravel);u.Heading=direction(u.Position,u.ExitTravel)
            u.Position+=u.Heading*math.min(stats.Speed*dt,gap)
            if gap&lt;=stats.Speed*dt+.04 then u.ExitTravel=nil end
            continue
        end
        if u.Formation and u.Formation.ExitLength and u.Formation.Progress-u.MarchRank*Config.RankSpacing&lt;u.Formation.ExitLength then continue end
        if mounted and u.Kind~='Archer' then continue end
        local range=mounted and Config.TowerRange[host.Level] or (sword(u) and Config.MeleeContact or stats.Range)
        local enemy,dist=self:NearestEnemy(u,spatial,math.max(12,range),pending)
        if sword(u) and inFront(u)then
            local claimed=meleeTargets[u.Side]or {};meleeTargets[u.Side]=claimed
            local separate,separateDist=self:NearestEnemy(u,spatial,math.max(12,range),claimed)
            if separate and (separateDist&lt;=range+.15 or dist&gt;range+.15) then enemy,dist=separate,separateDist end
            if enemy and dist&lt;=range+.15 then claimed[enemy.Id]=true end
        end
        local destination=u.Target and self.Sites[u.Target]
        if u.State=='Marching' and destination and destination.Owner~=u.Side
            and (not enemy or self:GarrisonDistance(u,destination)&lt;=dist)
            and self:CombatGarrison(u,destination,front,inFront,pending) then continue end
        local tower,towerDist=self:TowerTarget(u,math.max(12,range))
        if tower and (not enemy or towerDist&lt;dist) then
            u.Heading=direction(u.Position,tower.Position)
            if towerDist&lt;=range+Config.TowerRadius+.15 and (u.Kind=='Archer' or inFront(u)) then
                if u.Cooldown&lt;=0 then
                    u.Cooldown=u.Kind=='Archer' and (mounted and Config.TowerInterval[host.Level] or Config.ArcherInterval) or Config.MeleeInterval
                    u.AttackUntil=self.Time+.55
                    table.insert(self.Impacts,{At=self.Time+(u.Kind=='Archer' and .3 or Config.MeleeImpactDelay),Tower=tower.Id,Owner=tower.Owner,Amount=u.Kind=='Archer' and Config.ArrowTowerDamage or Config.SwordTowerDamage})
                    if u.Kind=='Archer' then table.insert(self.Events,{Type='Arrow',From=u.Position+Vector3.new(0,(u.Height or .25)+1.4,0),To=tower.Position+Vector3.new(0,6,0),Side=u.Side}) end
                end
                continue
            elseif not mounted and u.Kind~='Archer' and not (u.Formation and u.Formation.Hold) and not (u.Kind=='Peasant' and u.Formation and u.Formation.HasMelee) and inFront(u)then
                u.Position+=u.Heading*math.min(stats.Speed*dt,math.max(0,towerDist-range-Config.TowerRadius));continue
            end
        end
        if enemy then
            u.Heading=direction(u.Position,enemy.Position)
            if dist&lt;=range+.15 and (not sword(u) or inFront(u)) then
                if u.Cooldown&lt;=0 then
                    if u.Kind=='Archer' then
                        u.Cooldown=mounted and Config.TowerInterval[host.Level] or Config.ArcherInterval
                        u.AttackUntil=self.Time+.35
                        self:QueueHit(enemy,.3,'Damage',self:Damage(enemy,stats.Damage,true));pending[enemy.Id]=enemy.Health&lt;=(enemy.IncomingDamage or 0)
                        table.insert(self.Events,{Type='Arrow',From=u.Position+Vector3.new(0,(u.Height or .25)+1.4,0),To=enemy.Position+Vector3.new(0,(enemy.Height or .25)+1.1,0),Side=u.Side})
                    elseif sword(u) and sword(enemy) then
                        exchange(u,enemy)
                    elseif sword(u) then
                        u.Cooldown=Config.MeleeInterval;u.AttackUntil=self.Time+.55
                        self:QueueHit(enemy,Config.MeleeImpactDelay,'Kill');pending[enemy.Id]=true
                    else
                        u.Cooldown=stats.Interval;u.AttackUntil=self.Time+.3
                        self:QueueHit(enemy,.3,'Damage',self:Damage(enemy,stats.Damage,false))
                    end
                end
                continue
            elseif not mounted and u.Kind~='Archer' and not (u.Formation and u.Formation.Hold) and not (u.Kind=='Peasant' and u.Formation and u.Formation.HasMelee) and inFront(u) and u.State~='Overflow' and (u.State~='Defending' or length(host.Position,enemy.Position)&lt;29) then
                -- Melee fighters close the last gap. Archers only advance on their road.
                u.Position+=u.Heading*math.min(stats.Speed*dt,math.max(0,dist-range))
                continue
            end
        end
        if not mounted then self:Advance(u,dt,spatial) end
        if u.State=='Overflow' then
            local site=self.Sites[u.Target]
            if site and site.Owner==u.Side and self:Population(site)&lt;self:Capacity(site) then self:Deposit(u,site) end
        end
    end
end
function Engine:BotPower(site,filter)
    local power=0
    for _,u in self:Available(site,filter or 'All') do power+=({Peasant=.2,Defender=1.2,Archer=.9,Runner=.75})[u.Kind] end
    return power
end
function Engine:Bot()
    local owned={}
    for _,site in self.Sites do if site.Owner==2 then table.insert(owned,site) end end
    local foodDemand,foodIncome,farm=0,0,nil
    for _,u in self.Units do if u.Side==2 and u.Kind~='Peasant' then foodDemand+=1 end end
    for _,s in owned do
        if s.Kind=='Farm' then
            foodIncome+=Config.Food.Production[s.Level]*Config.Food.ConsumptionInterval/Config.Food.FarmInterval
            if s.Level&lt;3 and not s.UpgradeUntil then farm=s end
        end
    end
    local farmVillage=nil
    if farm and self.Difficulty~='Easy' and (foodDemand&gt;foodIncome or self.Food[2]&lt;foodDemand) then
        local nearest=math.huge
        for _,s in owned do if s.Kind=='Village' then local d=length(s.Position,farm.Position);if d&lt;nearest then nearest=d;farmVillage=s.Id end end end
    end
    -- Supply routes use earned villagers and the same queues as the human player.
    for _,site in owned do
        if site.Kind=='Village' and self:Counts(site).Peasant&gt;=12 then
            local best,score=nil,math.huge
            for _,target in owned do
                if Config.Buildings[target.Kind].Recruit and target.Kind~='Village' and target.Id~=site.Id then
                    local d=length(site.Position,target.Position)+self:Population(target)*1.2
                    if d&lt;score then best,score=target,d end
                end
            end
            if site.Id==farmVillage then best=farm end
            if best then self:SetSupply(2,site.Id,best.Id,6,'Peasant') end
        end
    end
    local missions={}
    for _,site in self.Sites do
        if site.Owner==2 then continue end
        if self.Time&lt;Config.PrepTime and site.Zone~=2 then continue end
        local assigned=0
        for _,u in self.Units do if u.Side==2 and u.Target==site.Id and (u.State=='Marching' or u.State=='Deploying') then assigned+=({Peasant=.2,Defender=1.2,Archer=.9,Runner=.75})[u.Kind] end end
        local defense=self:BotPower(site)*(1+Config.Defense[site.Level])
        if assigned&gt;defense*1.2+4 then continue end
        local value=site.Kind=='Village' and 95 or (site.Kind=='Tower' and 74 or 68)
        if site.Zone==2 then value+=25 end
        if site.Owner==1 then value+=8 end
        local supply=self.Difficulty=='Hard' and site.Supply and 30 or 0
        table.insert(missions,{Site=site,Defense=defense,Value=value+supply})
    end
    table.sort(missions,function(a,b) return a.Value&gt;b.Value end)
    for _,mission in missions do
        local target=mission.Site
        local sources={}
        for _,site in owned do
            local path=self:RouteForSide(2,site.Id,target.Id,'Auto')
            local power=self:BotPower(site)
            if path and power&gt;5 then table.insert(sources,{Site=site,Power=power,Distance=length(site.Position,target.Position)}) end
        end
        table.sort(sources,function(a,b) return a.Distance&lt;b.Distance end)
        local selected,total,fullPower={},0,0
        for _,source in sources do
            table.insert(selected,source.Site.Id)
            total+=source.Power*.65
            fullPower+=source.Power
            if total&gt;mission.Defense*1.4+5 then break end
        end
        if total&gt;mission.Defense*1.4+5 and #selected&gt;0 then
            local share=math.clamp((mission.Defense*1.4+9)/fullPower*100,20,65)
            self:Send(2,selected,target.Id,share,'All','Auto')
            self.LastBotTarget=target.Id
            break
        end
    end
    -- Upgrade only with a reserve and no nearby assault; no extra resources.
    for _,site in owned do
        if site.Level&gt;=3 or site.UpgradeUntil then continue end
        local cost=Config.UpgradeCost[site.Level+1]
        if self:Population(site)&lt;cost+(site.Kind=='Farm' and 0 or 25) then continue end
        local threatened=false
        for _,u in self.Active do if u.Side==1 and length(u.Position,site.Position)&lt;38 then threatened=true break end end
        if not threatened then self:Upgrade(2,site.Id) break end
    end
end
function Engine:CheckVictory()
    local alive={[1]=false,[2]=false}
    for _,site in self.Sites do if site.Owner~=0 then alive[site.Owner]=true end end
    for _,u in self.Units do if u.Side~=0 then alive[u.Side]=true end end
    if not alive[1] or not alive[2] then
        self.Phase='Ended'
        self.Winner=alive[1] and 1 or (alive[2] and 2 or 0)
    end
end
function Engine:Step(dt,skipBot)
    if self.Phase=='Waiting' or self.Phase=='Ended' then return end
    self.Time+=dt
    if self.Time&gt;=Config.PrepTime then self.Phase='Battle' end
    self:Produce(dt)
    self:WakeGuards()
    self:CombatAndMove(dt)
    self.BotClock+=dt
    if self.BotClock&gt;=(Config.BotInterval[self.Difficulty] or 2.5) and not skipBot then self.BotClock=0;self:Bot() end
    self:CheckVictory()
end
function Engine:Snapshot()
    local sites,units,totals={}, {},{roster(),roster()}
    local owned={0,0}
    for _,site in self.Sites do
        local counts=self:Counts(site,true)
        local inside=self:Counts(site)
        sites[site.Id]={Owner=site.Owner,Level=site.Level,Counts=counts,Inside=inside,Population=self:Population(site),Capacity=self:Capacity(site),Upgrade=site.UpgradeUntil and math.max(0,site.UpgradeUntil-self.Time),Supply=site.Supply and {Target=site.Supply.Target,Reserve=site.Supply.Reserve,Filter=site.Supply.Filter},Health=site.Health}
        if site.Owner~=0 then owned[site.Owner]+=1 end
    end
    for _,u in self.Units do
        if u.Side~=0 then totals[u.Side][u.Kind]+=1 end
        if self.Active[u.Id] then
            table.insert(units,{u.Id,u.Kind,u.Side,u.Position.X,u.Position.Z,u.Health,u.Heading.X,u.Heading.Z,self.Time&lt;u.AttackUntil,u.State,u.Height or .25})
        end
    end
    local events=self.Events
    self.Events={}
    return {Time=self.Time,Phase=self.Phase,Winner=self.Winner,Sites=sites,Units=units,Totals=totals,Owned=owned,Events=events,Difficulty=self.Difficulty,Map=self.Map.Definition,Food={self.Food[1],self.Food[2]}}
end
return Engine
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXGlobalMatchmaker"><Properties><string name="Name">GlobalMatchmaker</string><ProtectedString name="Source">-- Server-only queue shared by every public lobby in the experience.
-- Services are injected so cross-server races and failures can be tested locally.
local Matchmaker={};Matchmaker.__index=Matchmaker
function Matchmaker.new(services)
    return setmetatable({S=services,LocalTickets={}},Matchmaker)
end
function Matchmaker.QueueKey(ticket)
    if ticket.Mode=='Ranked'then return 'Ranked_'..math.floor((ticket.Rank or 0)/100)end
    local level=ticket.Level or 1;return 'PvP_'..(level&lt;10 and 1 or level&lt;25 and 2 or level&lt;50 and 3 or 4)
end
function Matchmaker:Queue(ticket)return self.S.QueueFor and self.S.QueueFor(Matchmaker.QueueKey(ticket))or self.S.Queue end
function Matchmaker.Compatible(a,b,now)
    local modeA,modeB=a.Mode or 'PvP',b.Mode or 'PvP'
    if modeA~=modeB then return false end
    if modeA=='Ranked'then
        local age=math.max(now-a.JoinedAt,now-b.JoinedAt)
        local window=age&gt;=60 and 300 or age&gt;=30 and 200 or 100
        return math.abs((a.Rank or 0)-(b.Rank or 0))&lt;=window
    end
    local function band(level)return level&lt;10 and 1 or level&lt;25 and 2 or level&lt;50 and 3 or 4 end
    return band(a.Level or 1)==band(b.Level or 1)
end
function Matchmaker:Join(userId,jobId,profile,mode)
    local s=self.S;local key=tostring(userId)
    local ticket={UserId=userId,JobId=jobId,Token=s.Guid(),JoinedAt=s.Now(),State='Queued',Mode=mode=='Ranked'and 'Ranked'or 'PvP',Rank=profile and profile.Rank or 0,Level=profile and profile.Level or 1}
    s.Tickets:SetAsync(key,ticket,90)
    self:Queue(ticket):SetAsync(key,ticket,90,ticket.JoinedAt);self.LocalTickets[userId]=ticket
    return ticket.Token
end
function Matchmaker:Renew(userId,token)
    local s=self.S;local key=tostring(userId)
    local value=s.Tickets:UpdateAsync(key,function(old)
        if not old or old.Token~=token then return nil end
        if old.State=='Claimed' and old.ClaimUntil&lt;s.Now()then old.State='Queued';old.MatchId=nil;old.ClaimUntil=nil end
        return old
    end,90)
    if value and value.Token==token and value.State=='Queued'then self:Queue(value):SetAsync(key,value,90,value.JoinedAt)end
    return value
end
function Matchmaker:Cancel(userId,token)
    local s=self.S;local key=tostring(userId)
    local value=s.Tickets:UpdateAsync(key,function(old)
        if not old or old.Token~=token or old.State~='Queued'then return nil end
        old.State='Cancelled';return old
    end,15)
    if value and value.Token==token and value.State=='Cancelled'then self:Queue(value):RemoveAsync(key);self.LocalTickets[userId]=nil;return true end
    return false
end
function Matchmaker:Claim(ticket,matchId)
    local s=self.S
    local value=s.Tickets:UpdateAsync(tostring(ticket.UserId),function(old)
        if not old or old.Token~=ticket.Token or old.State~='Queued'then return nil end
        old.State='Claimed';old.MatchId=matchId;old.ClaimUntil=s.Now()+60;return old
    end,90)
    return value and value.Token==ticket.Token and value.State=='Claimed'and value.MatchId==matchId
end
function Matchmaker:Release(ticket,matchId)
    local s=self.S
    s.Tickets:UpdateAsync(tostring(ticket.UserId),function(old)
        if not old or old.Token~=ticket.Token or old.MatchId~=matchId then return nil end
        old.State='Queued';old.MatchId=nil;old.ClaimUntil=nil;old.AccessCode=nil;old.PrivateId=nil;return old
    end,90)
end
function Matchmaker:Allocate(metadata)
    local s=self.S;local code,privateId=s.Reserve()
    metadata.PrivateId=privateId;metadata.CreatedAt=s.Now()
    s.Matches:SetAsync(privateId,metadata,7200)
    return code,privateId
end
function Matchmaker:Pair(a,b,matchId)
    local s=self.S
    local metadata={MatchId=matchId,Mode=a.Mode or 'PvP',MapId=s.RandomMap(),Users={a.UserId,b.UserId},State='Committing'}
    local code,privateId
    local ok=pcall(function()
        code,privateId=self:Allocate(metadata)
        for _,ticket in {a,b}do
            local value=s.Tickets:UpdateAsync(tostring(ticket.UserId),function(old)
                if not old or old.Token~=ticket.Token or old.MatchId~=matchId or old.State~='Claimed'then return nil end
                old.State='Matched';old.AccessCode=code;old.PrivateId=privateId;return old
            end,180)
            assert(value and value.MatchId==matchId and value.State=='Matched','Queue changed before commit')
        end
        metadata.State='Ready';s.Matches:SetAsync(privateId,metadata,7200)
    end)
    if not ok then
        -- Neither lobby teleports until both tickets have committed.
        for _,ticket in {a,b}do pcall(function()self:Release(ticket,matchId)end)end
        return false
    end
    for _,ticket in {a,b}do pcall(function()self:Queue(ticket):RemoveAsync(tostring(ticket.UserId))end)end
    return true
end
function Matchmaker:Pump()
    local candidates={}
    if self.S.QueueFor then
        local keys,seen={},{}
        for _,ticket in self.LocalTickets do
            if ticket.Mode=='Ranked'then local band=math.floor(ticket.Rank/100);for offset=-3,3 do if band+offset&gt;=0 then keys['Ranked_'..(band+offset)]=true end end
            else keys[Matchmaker.QueueKey(ticket)]=true end
        end
        for key in keys do for _,item in self.S.QueueFor(key):GetRangeAsync(Enum.SortDirection.Ascending,100)do
            if not seen[item.key]then table.insert(candidates,item);seen[item.key]=true end
        end end
        table.sort(candidates,function(a,b)return a.value.JoinedAt&lt;b.value.JoinedAt or a.value.JoinedAt==b.value.JoinedAt and a.value.UserId&lt;b.value.UserId end)
    else candidates=self.S.Queue:GetRangeAsync(Enum.SortDirection.Ascending,100)end
    local used={};local now=self.S.Now()
    for i,item in candidates do
        local a=item.value;if used[a.UserId]then continue end
        local best,distance=nil,math.huge
        for j=i+1,#candidates do
            local b=candidates[j].value
            if not used[b.UserId]and a.UserId~=b.UserId and Matchmaker.Compatible(a,b,now)then
                local gap=math.abs((a.Rank or 0)-(b.Rank or 0))
                if gap&lt;distance then best,distance=b,gap end
            end
        end
        if best then
            local matchId=self.S.Guid()
            if self:Claim(a,matchId)then
                used[a.UserId]=true
                if self:Claim(best,matchId)then used[best.UserId]=true;self:Pair(a,best,matchId)else self:Release(a,matchId)end
            end
        end
    end
end
function Matchmaker:Assignment(userId,token)
    local value=self.S.Tickets:GetAsync(tostring(userId))
    if value and value.Token==token and value.State=='Matched'then
        local metadata=self.S.Matches:GetAsync(value.PrivateId)
        if metadata and metadata.MatchId==value.MatchId and metadata.State=='Ready'then self.LocalTickets[userId]=nil;return value end
    end
    return nil
end
function Matchmaker:Solo(userId,definition,mapId,difficulty)
    local metadata={MatchId=self.S.Guid(),Mode='AI',Definition=definition,MapId=mapId,Difficulty=difficulty,Users={userId},State='Ready'}
    local code,privateId=self:Allocate(metadata)
    return {AccessCode=code,PrivateId=privateId,MatchId=metadata.MatchId}
end
return Matchmaker
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXLobbyDirectory"><Properties><string name="Name">LobbyDirectory</string><ProtectedString name="Source">-- Shared level-band lobbies with capacity claims and a short creation lease.
local P=require(script.Parent.Progression)
local Directory={};Directory.__index=Directory
function Directory.new(services)return setmetatable({S=services},Directory)end
function Directory:Claim(id,userId,band)
    local s=self.S;local now=s.Now();local accepted=false
    local entry=s.Registry:UpdateAsync(id,function(old)
        accepted=false;if not old or old.Band~=band or old.Expires&lt;=now then return nil end
        old.Pending=old.Pending or {};for key,expiry in old.Pending do if expiry&lt;=now then old.Pending[key]=nil end end
        local count=old.Count or 0;for _ in old.Pending do count+=1 end
        local key=tostring(userId)
        if not old.Pending[key] and count&gt;=old.Capacity then return nil end
        old.Pending[key]=now+45;accepted=true;return old
    end,90)
    return accepted and entry or nil
end
function Directory:Find(level,userId)
    local s=self.S;local band=P.Band(level)
    for _,item in s.Registry:GetRangeAsync(Enum.SortDirection.Ascending,100)do
        local value=item.value
        if value.Band==band then local found=self:Claim(item.key,userId,band);if found then return found end end
    end
    local token=s.Guid();local acquired=false
    s.Locks:UpdateAsync(band,function(old)
        acquired=false;if old and old.Until&gt;s.Now()then return nil end
        acquired=true;return {Token=token,Until=s.Now()+15}
    end,20)
    if not acquired then return nil end
    local ok,entry=pcall(function()
        local code,id=s.Reserve();local value={Mode='Lobby',Band=band,PrivateId=id,AccessCode=code,Capacity=s.Capacity,Count=0,Pending={[tostring(userId)]=s.Now()+45},Expires=s.Now()+60,State='Ready'}
        s.Matches:SetAsync(id,value,7200);s.Registry:SetAsync(id,value,90,s.Now());return value
    end)
    s.Locks:UpdateAsync(band,function(old)if old and old.Token==token then old.Until=0;return old end;return nil end,1)
    if not ok then error(entry)end;return entry
end
function Directory:Advertise(metadata,users)
    local s=self.S;local now=s.Now()
    local entry=s.Registry:UpdateAsync(metadata.PrivateId,function(old)
        local value=old or table.clone(metadata);value.Pending=value.Pending or {}
        for key,expiry in value.Pending do if expiry&lt;=now or users[tonumber(key)]then value.Pending[key]=nil end end
        local count=0;for _ in users do count+=1 end
        value.Count=count;value.Expires=now+45;return value
    end,90)
    s.Matches:SetAsync(metadata.PrivateId,metadata,7200)
    return entry
end
return Directory
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMapCatalog"><Properties><string name="Name">MapCatalog</string><ProtectedString name="Source">local Network=require(script.Parent.MapNetwork)
local Catalog={Items={{Id='TwoBridges',Name='Two Crossings'},{Id='LandFrontiers',Name='Land Frontiers'},{Id='RiverPass',Name='River Pass'}}}
function Catalog.Definition(id)
    local d=Network.DefaultDefinition()
    if id=='LandFrontiers' then
        d.Name='Land Frontiers';d.River=false
        for _,n in d.Nodes do
            if n.Kind=='Castle' or n.Kind=='Farm' then n.Z=1
            elseif n.Kind=='Camp' then n.Z=-1 end
            if n.Id=='NorthTower' then n.X=0;n.Z=-2
            elseif n.Id=='NorthEast' then n.X=2;n.Z=-2
            elseif n.Id=='SouthTower' then n.X=0;n.Z=2
            elseif n.Id=='SouthWest' then n.X=-2;n.Z=2 end
        end
    elseif id=='RiverPass' then
        d.Name='River Pass'
        for _,n in d.Nodes do
            if n.Id=='NorthTower' then n.X=-1;n.Z=0
            elseif n.Id=='NorthEast' then n.X=1;n.Z=0
            elseif n.Id=='SouthTower' then n.X=2;n.Z=2
            elseif n.Id=='SouthWest' then n.X=-2;n.Z=2 end
        end
        for i=#d.Roads,1,-1 do
            local e=d.Roads[i]
            if e[1]=='SouthWest' and e[2]=='SouthTower' then table.remove(d.Roads,i) end
        end
        table.insert(d.Roads,{'SouthWest','NorthTower'})
        table.insert(d.Roads,{'NorthEast','SouthTower'})
    end
    return d
end
function Catalog.Create(id)return Network.Create(Catalog.Definition(id))end
function Catalog.Random(random)
    local item=Catalog.Items[(random or Random.new()):NextInteger(1,#Catalog.Items)]
    return assert(Catalog.Create(item.Id)),item.Id
end
return Catalog
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMapData"><Properties><string name="Name">MapData</string><ProtectedString name="Source">local Network=require(script.Parent.MapNetwork)
local Map=assert(Network.Create(Network.DefaultDefinition()))
Map.Create=Network.Create
Map.DefaultDefinition=Network.DefaultDefinition
return Map
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMapEditor"><Properties><string name="Name">MapEditor</string><ProtectedString name="Source">local Http=game:GetService('HttpService')
local Network=require(script.Parent.MapNetwork)
local Config=require(script.Parent.Config)
local Editor={};Editor.__index=Editor
local function copy(d)return Http:JSONDecode(Http:JSONEncode(d))end
function Editor.new(definition,changed,notify)
    return setmetatable({Definition=copy(definition),History={},Kind='Castle',Tool='Place',Owner=1,From=nil,Moving=nil,Changed=changed,Notify=notify,Counter=0,GeometryRevision=0},Editor)
end
function Editor:Find(id)for _,n in self.Definition.Nodes do if n.Id==id then return n end end end
function Editor:Cell(x,z)for _,n in self.Definition.Nodes do if n.X==x and n.Z==z then return n end end end
function Editor:Remember()
    table.insert(self.History,copy(self.Definition));if #self.History&gt;50 then table.remove(self.History,1)end
end
function Editor:Refresh(mapChanged,compiled)
    if mapChanged then self.GeometryRevision+=1 end
    self.Changed(self.Definition,self:Hint(),self.GeometryRevision,compiled)
end
function Editor:Hint()
    if self.Tool=='Road'then return self.From and 'Road: select the second point. Right-click to cancel.' or 'Road: select the first point, then the second.'
    elseif self.Tool=='Move'then return self.Moving and 'Move: select an empty cell.' or 'Move: select a building.'
    elseif self.Tool=='Erase'then return 'Delete: select an object. Its connected roads will also be removed.' end
    local name=self.Kind=='Junction'and 'Road Junction' or Config.Buildings[self.Kind].Name
    return name..' · '..({'Blue','Red','Neutral'})[self.Owner==0 and 3 or self.Owner]..' · select an empty cell'
end
function Editor:SetKind(kind)self.Kind=kind;self.Tool='Place';self.From=nil;self.Moving=nil;self:Refresh()end
function Editor:SetTool(tool)self.Tool=tool;self.From=nil;self.Moving=nil;self:Refresh()end
function Editor:CycleOwner()self.Owner=self.Owner==1 and 2 or self.Owner==2 and 0 or 1;self:Refresh()end
function Editor:CanPlace(x,z,ignore)
    local b=Network.Bounds
    if self.Definition.River~=false and x==0 or x&lt;b.MinX or x&gt;b.MaxX or z&lt;b.MinZ or z&gt;b.MaxZ then return false end
    local n=self:Cell(x,z);return not n or n.Id==ignore
end
function Editor:Click(id,x,z)
    if self.Tool=='Road'then
        if not id or not self:Find(id)then self.Notify('Select a building or a road junction.');return end
        if not self.From then self.From=id;self:Refresh();return end
        if self.From==id then self.From=nil;self:Refresh();return end
        for _,e in self.Definition.Roads do if e[1]==id and e[2]==self.From or e[2]==id and e[1]==self.From then self.From=nil;self:Refresh();return end end
        local nextMap=copy(self.Definition);table.insert(nextMap.Roads,{self.From,id})
        local valid,reason=Network.Create(nextMap,{AllowIncomplete=true})
        if not valid then self.Notify(reason);return end
        self:Remember();self.Definition=valid.Definition;self.From=nil;self:Refresh(true,valid)
    elseif self.Tool=='Erase'then
        if not id or not self:Find(id)then return end;self:Remember()
        for i=#self.Definition.Nodes,1,-1 do if self.Definition.Nodes[i].Id==id then table.remove(self.Definition.Nodes,i)end end
        for i=#self.Definition.Roads,1,-1 do local e=self.Definition.Roads[i];if e[1]==id or e[2]==id then table.remove(self.Definition.Roads,i)end end
        self:Refresh(true)
    elseif self.Tool=='Move'then
        if not self.Moving then if id then self.Moving=id;self:Refresh()end;return end
        if not self:CanPlace(x,z,self.Moving)then self.Notify('This cell is occupied or in the river.');return end
        local moving=self:Find(self.Moving)
        if moving and moving.X==x and moving.Z==z then self.Moving=nil;self:Refresh();return end
        local nextMap=copy(self.Definition)
        for _,n in nextMap.Nodes do if n.Id==self.Moving then n.X=x;n.Z=z end end
        local valid,reason=Network.Create(nextMap,{AllowIncomplete=true});if not valid then self.Notify(reason);return end
        self:Remember();self.Definition=valid.Definition;self.Moving=nil;self:Refresh(true,valid)
    else
        if not self:CanPlace(x,z)then self.Notify('Select an empty cell on land.');return end
        if self.Kind=='Castle' and self.Owner~=0 then for _,n in self.Definition.Nodes do if n.Kind=='Castle'and n.Owner==self.Owner then self.Notify('This team already has a castle. Move it or select another team.');return end end end
        if #self.Definition.Nodes&gt;=80 then self.Notify('The map has reached its object limit.');return end
        repeat self.Counter+=1 until not self:Find('N'..self.Counter)
        self:Remember();table.insert(self.Definition.Nodes,{Id='N'..self.Counter,Kind=self.Kind,X=x,Z=z,Owner=self.Owner});self:Refresh(true)
    end
end
function Editor:Undo()
    local last=table.remove(self.History);if last then self.Definition=last;self.From=nil;self.Moving=nil;self:Refresh(true)end
end
function Editor:New()self:Remember();self.Definition={Name='My Map',River=self.Definition.River~=false,Nodes={},Roads={}};self.From=nil;self.Moving=nil;self:Refresh(true)end
function Editor:ToggleRiver()
    local nextMap=copy(self.Definition);nextMap.River=self.Definition.River==false
    local valid,reason=Network.Create(nextMap,{AllowIncomplete=true})
    if not valid then self.Notify('Move objects out of the central column first. '..reason);return false end
    self:Remember();self.Definition=valid.Definition;self.From=nil;self.Moving=nil;self:Refresh(true,valid);return true
end
function Editor:Validate()return Network.Create(self.Definition)end
function Editor:Export()return Http:JSONEncode(self.Definition)end
function Editor:Import(text)
    if #text&gt;40000 then return false,'Map code is too large.' end
    local ok,d=pcall(function()return Http:JSONDecode(text)end);if not ok then return false,'Could not read the map code.' end
    local map,reason=Network.Create(d,{AllowIncomplete=true});if not map then return false,reason end
    self:Remember();self.Definition=map.Definition;self.From=nil;self.Moving=nil;self:Refresh(true,map);return true
end
return Editor

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMapNetwork"><Properties><string name="Name">MapNetwork</string><ProtectedString name="Source">-- Buildings occupy cells. Streets use empty cells and perimeter lanes.
local Config=require(script.Parent.Config)
local Map={CellSize=32,Bounds={MinX=-8,MaxX=8,MinZ=-5,MaxZ=5}}
local initial={Castle={Defender=50,Peasant=20},Village={Peasant=8},Barracks={Defender=12},Archery={Archer=12},Camp={Runner=12},Tower={Archer=15},Farm={}}
Map.EntranceRadius={Castle=13,Village=8,Barracks=8,Archery=8,Camp=8,Tower=4.5,Farm=8}
local dirs={{1,0},{0,1},{-1,0},{0,-1}}
local function integer(n)return typeof(n)=='number' and n==n and n%1==0 end
local function cell(x,z)return x..':'..z end
local function positionKey(p)return string.format('%.2f:%.2f',p.X,p.Z) end
local function gridPath(a,b,occupied,river)
    local start,finish=cell(a.X,a.Z),cell(b.X,b.Z)
    local costs={[start]=0};local positions={[start]={a.X,a.Z}};local previous,closed={},{}
    while true do
        local current,best=nil,math.huge
        for key,cost in costs do
            local p=positions[key]
            local score=cost+math.abs(p[1]-b.X)+math.abs(p[2]-b.Z)
            if not closed[key] and (score&lt;best or score==best and (not current or key&lt;current)) then current,best=key,score end
        end
        if not current then return nil end
        if current==finish then break end
        closed[current]=true
        local p=positions[current]
        for _,d in dirs do
            local x,z=p[1]+d[1],p[2]+d[2]
            local key=cell(x,z)
            local inside=x&gt;=Map.Bounds.MinX and x&lt;=Map.Bounds.MaxX and z&gt;=Map.Bounds.MinZ and z&lt;=Map.Bounds.MaxZ
            local landStep=not river or p[1]~=0 or d[2]==0
            local intoRiver=not river or x~=0 or d[2]==0
            if inside and landStep and intoRiver and (not occupied[key] or key==finish or key==start) then
                local cost=costs[current]+1
                if cost&lt;(costs[key] or math.huge) then costs[key]=cost;positions[key]={x,z};previous[key]=current end
            end
        end
    end
    local result={positions[finish]};local key=finish
    while key~=start do key=previous[key];table.insert(result,1,positions[key]) end
    return result
end
local function compile(definition,options)
    local incomplete=options and options.AllowIncomplete
    if typeof(definition)~='table' or typeof(definition.Nodes)~='table' or typeof(definition.Roads)~='table' then return nil,'Buildings and roads are required.' end
    if #definition.Nodes&gt;80 or #definition.Roads&gt;160 then return nil,'The map is too large.' end
    local river=definition.River~=false
    local M={Sites={},Points={},Edges={},Bridges={},River=river,CellSize=Map.CellSize,Bounds=Map.Bounds,Definition={Name=typeof(definition.Name)=='string' and string.sub(definition.Name,1,60) or 'My Map',River=river,Nodes={},Roads={}}}
    local known,occupied,buildings={}, {},{}
    local castles={}
    for _,n in definition.Nodes do
        if typeof(n)~='table' or typeof(n.Id)~='string' or #n.Id&gt;40 or not n.Id:match('^[%w_]+$') or known[n.Id] then return nil,'Each point must have a unique ID.' end
        if not integer(n.X) or not integer(n.Z) or n.X&lt;Map.Bounds.MinX or n.X&gt;Map.Bounds.MaxX or n.Z&lt;Map.Bounds.MinZ or n.Z&gt;Map.Bounds.MaxZ then return nil,'Place the object in a cell within the map.' end
        if river and n.X==0 then return nil,'Only road bridges can cross the riverbed.' end
        if n.Kind~='Junction' and not Config.Buildings[n.Kind] then return nil,'Unknown building type.' end
        local key=cell(n.X,n.Z)
        if occupied[key] then return nil,'This cell is already occupied.' end
        local owner=n.Owner or 0
        if owner~=0 and owner~=1 and owner~=2 then return nil,'Unknown team.' end
        local copy={Id=n.Id,Kind=n.Kind,X=n.X,Z=n.Z,Owner=owner}
        table.insert(M.Definition.Nodes,copy);known[n.Id]=copy;occupied[key]=true
        local center=Vector3.new(n.X*Map.CellSize,0,n.Z*Map.CellSize)
        M.Points[n.Id]=center
        if n.Kind~='Junction' then
            buildings[key]=true
            local entrance=center+Vector3.new(0,0,Map.EntranceRadius[n.Kind])
            M.Points[n.Id]=entrance
            table.insert(M.Sites,{Id=n.Id,Kind=n.Kind,Position=center,Entrance=entrance,Owner=owner,Zone=n.X&lt;0 and 1 or 2,Initial=initial[n.Kind]})
            if n.Kind=='Castle' and owner~=0 then
                if castles[owner] and not incomplete then return nil,'Each team needs exactly one castle.' end
                castles[owner]=n.Id
            end
        end
    end
    if not incomplete then
        local counts={0,0}
        for _,s in M.Sites do if s.Kind=='Castle' and s.Owner~=0 then counts[s.Owner]+=1 end end
        if counts[1]~=1 or counts[2]~=1 then return nil,'Place one Blue castle and one Red castle.' end
    end
    local vertices,adjacency,segments,bridgeKeys={},{},{},{}
    local raw={}
    local roads={};M.Roads=roads;M.Crossings={}
    local function append(points,p)if not points[#points] or (points[#points]-p).Magnitude&gt;.01 then table.insert(points,p)end end
    local function distance(points)local n=0;for i=2,#points do n+=(points[i]-points[i-1]).Magnitude end;return n end
    local function approach(n,port)
        if n.Kind=='Junction'then return {port}end
        local c=Vector3.new(n.X*32,0,n.Z*32)
        local offsets={{0,16},{16,16},{16,0},{16,-16},{0,-16},{-16,-16},{-16,0},{-16,16}}
