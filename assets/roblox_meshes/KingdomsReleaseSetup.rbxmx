        end
    end
    local function armyCamera(cam)cam.CFrame=CFrame.lookAt(Vector3.new(0,2.2,6),Vector3.new(0,1.15,0));cam.FieldOfView=36 end
    local function owns(id)return m.Profile~=nil and m.Profile.Skins[id]==true end
