        v.Ambient=Color3.fromRGB(196,209,219);v.LightColor=Color3.fromRGB(255,242,211);v.LightDirection=Vector3.new(-1,-1,-1);v.Parent=parent;round(v,10)
        -- A gradient on ViewportFrame also tints its rendered models.
