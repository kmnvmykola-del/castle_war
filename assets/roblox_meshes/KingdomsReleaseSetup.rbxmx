imum"]={-0.135,0.22,0.2705},["Joint"]={0.0,1.1200000047683716,-0.0},["Tint"]=true,["Team"]=false,["Neutral"]=false},["Veteran_Runner_LeftArm"]={["Minimum"]={-0.125,-0.62625,-0.15},["Maximum"]={0.135,0.02,0.15},["Joint"]={-0.4399999976158142,1.3899999856948853,-0.0},["Tint"]=false,["Team"]=true,["Neutral"]=false},["Veteran_Runner_LeftLeg"]={["Minimum"]={-0.15,-0.8025,-0.16},["Maximum"]={0.15,0.005,0.255},["Joint"]={-0.18000000715255737,0.8199999928474426,-0.0},["Tint"]=false,["Team"]=true,["Neutral"]=false},["Veteran_Runner_RightArm"]={["Minimum"]={-0.16,-0.645,-0.15},["Maximum"]={0.15,0.495,0.15},["Joint"]={0.4399999976158142,1.3899999856948853,-0.0},["Tint"]=false,["Team"]=true,["Neutral"]=false},["Veteran_Runner_RightLeg"]={["Minimum"]={-0.15,-0.8025,-0.16},["Maximum"]={0.15,0.005,0.255},["Joint"]={0.18000000715255737,0.8199999928474426,-0.0},["Tint"]=false,["Team"]=true,["Neutral"]=false},["Veteran_Runner_Torso"]={["Minimum"]={-0.35,-0.34,-0.2},["Maximum"]={0.35,0.37,0.308},["Joint"]={0.0,1.1200000047683716,-0.0},["Tint"]=false,["Team"]=true,["Neutral"]=false},["Village_Base"]={["Minimum"]={-5.1,0.0,-4.16},["Maximum"]={4.43749,6.49,4.16},["Joint"]={0.0,0.0,-0.0},["Tint"]=false,["Team"]=false,["Neutral"]=false},["Village_Upgrade2"]={["Minimum"]={-5.18,-0.24,-4.68},["Maximum"]={6.505,7.0288,4.68},["Joint"]={0.0,0.0,-0.0},["Tint"]=false,["Team"]=false,["Neutral"]=false},["Village_Upgrade3"]={["Minimum"]={-7.145,-0.464,-4.68},["Maximum"]={6.505,7.53168,4.68},["Joint"]={0.0,0.0,-0.0},["Tint"]=false,["Team"]=false,["Neutral"]=false}}}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMetaUI"><Properties><string name="Name">MetaUI</string><ProtectedString name="Source">local UI=require(script.Parent.UI)
local P=require(script.Parent.Progression)
local Meta={}
function Meta.Build(u,hooks)
    local C=UI.Colors;local function call(key,...)if hooks[key]then hooks[key](...)end end
    local m={Skin='Default',Models={},Profile=nil,Boards={}}
    local settings=u.MainButtons[3];table.remove(u.MainButtons,3)
    local profile=UI.Button(u.Main,'Profile','Profile',UDim2.new(1,0,0,44),UDim2.new(),function()call('Profile')end)
    local inventory=UI.Button(u.Main,'Inventory','Inventory · Sets',UDim2.new(1,0,0,44),UDim2.new(),function()call('Inventory')end)
    local shop=UI.Button(u.Main,'Shop','Shop · Skins',UDim2.new(1,0,0,44),UDim2.new(),function()call('Shop')end)
    local leaders=UI.Button(u.Main,'Leaders','Leaderboards',UDim2.new(1,0,0,44),UDim2.new(),function()call('Leaders')end)
    for _,b in {profile,inventory,shop,leaders,settings}do table.insert(u.MainButtons,b)end
    u.Ranked=UI.Button(u.Modes,'Ranked','Ranked · 0',UDim2.new(1,0,0,48),UDim2.fromOffset(0,120),function()call('Ranked')end);u.Ranked.BackgroundColor3=C.Gold;u.Ranked.TextColor3=C.Panel
    m.Pages={}
    for _,name in {'Profile','Shop','Leaders'}do
        local page=Instance.new('ScrollingFrame');page.Name=name;page.Active=true;page.BackgroundTransparency=1;page.BorderSizePixel=0;page.ScrollBarThickness=3;page.Visible=false;page.Parent=u.Card;page.CanvasSize=UDim2.fromOffset(0,name=='Shop'and 438 or 320);m.Pages[name]=page
    end
    m.Back=UI.Button(u.Card,'MetaBack','Back',UDim2.new(1,-40,0,36),UDim2.new(0,20,1,-48),function()call('MetaBack')end);m.Back.Visible=false
    local page=m.Pages.Profile
    m.Stats=UI.Label(page,'Stats','Loading profile…',UDim2.new(1,-8,0,226),UDim2.fromOffset(0,0),15);m.Stats.TextWrapped=true;m.Stats.TextYAlignment=Enum.TextYAlignment.Top
    m.Reward=UI.Label(page,'Reward','',UDim2.new(1,-8,0,62),UDim2.fromOffset(0,230),13);m.Reward.TextWrapped=true;m.Reward.TextColor3=C.Gold
    m.Persistence=UI.Label(page,'Persistence','',UDim2.new(1,-8,0,38),UDim2.fromOffset(0,296),11);m.Persistence.TextWrapped=true;m.Persistence.TextColor3=C.Muted
    UI.Button(page,'Retry','Refresh Profile',UDim2.new(1,-8,0,36),UDim2.fromOffset(0,340),function()call('RefreshProfile')end);page.CanvasSize=UDim2.fromOffset(0,385)
    page=m.Pages.Leaders
    m.RankTab=UI.Button(page,'Rank','Rank',UDim2.new(.5,-8,0,36),UDim2.new(),function()call('Board','Rank')end)
    m.WinsTab=UI.Button(page,'Wins','PvP Wins',UDim2.new(.5,-4,0,36),UDim2.fromScale(.5,0),function()call('Board','Wins')end)
    m.Mine=UI.Label(page,'Mine','Loading leaderboard…',UDim2.new(1,-8,0,48),UDim2.fromOffset(0,43),12);m.Mine.TextWrapped=true;m.Mine.TextColor3=C.Gold
    m.Rows=Instance.new('Frame');m.Rows.Name='Rows';m.Rows.BackgroundTransparency=1;m.Rows.Size=UDim2.new(1,-8,0,1);m.Rows.Position=UDim2.fromOffset(0,98);m.Rows.Parent=page
    function m.Apply(data)
        if data.Profile then
            m.Profile=data.Profile;m.Boards={};local d=m.Profile
            profile.Text='Profile · Lv. '..d.Level..' · '..d.Coins..' coins'
            if m.QueueMode~='Ranked'then u.Ranked.Text='Ranked · '..d.Rank end
            m.Stats.Text='Level: '..d.Level..'   ·   XP: '..d.LevelXP..'/200\nCoins: '..d.Coins..'\n\nRank: '..d.Rank..'\n'..(d.RankedGames&lt;10 and 'Placement matches: '..d.RankedGames..'/10 matches'or 'Rank established')..'\nRanked win streak: '..d.WinStreak..'\n\nPvP: '..d.Wins..' wins / '..d.Losses..' losses\nAI: '..d.AIWins..' wins / '..d.AILosses..' losses\nLevel lobby: '..d.LobbyBand
            m.Persistence.Text=data.Persistent and 'Your profile is saved across servers and sessions.'or 'Studio: your profile lasts until Play stops.'
            m.RefreshShop()
        end
        if data.Reward and not data.Reward.AlreadyApplied then local r=data.Reward;m.Reward.Text=(r.Won and 'Victory!'or 'Defeat')..'  +'..r.XP..' XP\n'..(r.Coins&gt;0 and '+'..r.Coins..' coins from leveling up. 'or '')..(r.Mode=='Ranked'and string.format('Rank: %+d',r.Rank)or '')end
        if data.Board then
            local b=data.Board
            m.Boards[b.Kind]=b
            if m.BoardKind and b.Kind~=m.BoardKind then return end
            m.RankTab.BackgroundColor3=b.Kind=='Rank'and C.Blue or C.Inset;m.WinsTab.BackgroundColor3=b.Kind=='Wins'and C.Blue or C.Inset
            m.Mine.Text=(b.Global and 'Global Top 100'or 'Studio: players in this test session')..'\nYou: '..(b.Mine.Place and '№'..b.Mine.Place or 'outside the Top 100')..' · '..b.Mine.Score
            for _,child in m.Rows:GetChildren()do child:Destroy()end
            for i,entry in b.Entries do
                local row=UI.Label(m.Rows,'Player'..entry.UserId,'#'..entry.Place..'   '..(entry.Name or tostring(entry.UserId)),UDim2.new(1,-62,0,27),UDim2.fromOffset(0,(i-1)*31),12)
                row.TextTruncate=Enum.TextTruncate.AtEnd
                local score=UI.Label(m.Rows,'Score'..i,tostring(entry.Score),UDim2.fromOffset(60,27),UDim2.new(1,-60,0,(i-1)*31),12);score.TextXAlignment=Enum.TextXAlignment.Right
            end
            m.Pages.Leaders.CanvasSize=UDim2.fromOffset(0,100+#b.Entries*31)
        end
    end
    local oldShow,oldLayout=u.Show,u.Layout
    function u.Show(page,inGame)
        local extra=m.Pages[page]~=nil
        oldShow(extra and 'Settings'or page,inGame)
        for name,pane in m.Pages do pane.Visible=name==page end
        m.Back.Visible=extra
        if extra then u.Page=page;u.Settings.Visible=false;u.Title.Text=({Profile='Your Profile',Inventory='Inventory',Shop='Shop',Chests='Kingdom Chest',Leaders='Leaderboards'})[page]end
        u.Layout()
    end
    function u.Layout()
        oldLayout();local v=workspace.CurrentCamera.ViewportSize;local short=v.Y&lt;480
        local collection=u.Page=='Inventory'or u.Page=='Shop'or u.Page=='Chests'
        local wanted=collection and 760 or u.Page=='Profile'and 580 or u.Page=='Leaders'and 580 or u.Page=='Mode'and 470 or u.Page=='Main'and (u.Return.Visible and 580 or 540)
        if wanted then local limit=v.Y-(collection and short and 76 or 80);local h=math.min(collection and short and limit or short and 300 or wanted,limit);local width=collection and math.min(1040,v.X-48)or u.Card.Size.X.Offset;u.Card.Size=UDim2.fromOffset(width,h);u.Card.Position=UDim2.new(.5,-width/2,.5,-h/2+(collection and short and 26 or 0))end
        local top=collection and (short and 48 or 70) or short and 54 or 90
        if collection then
            u.Title.Position=UDim2.fromOffset(24,short and 10 or 16);u.Title.Size=UDim2.new(1,-48,0,short and 30 or 40);u.Title.TextSize=short and 24 or 28;u.Title.TextColor3=C.Text
            u.Card.BackgroundColor3=Color3.fromRGB(15,25,37)
            if u.Divider then u.Divider.Position=UDim2.fromOffset(20,short and 42 or 62)end
        else u.Card.BackgroundColor3=C.Panel;u.Title.TextSize=short and 22 or 29 end
        for _,pane in m.Pages do pane.Position=UDim2.fromOffset(20,top+5);pane.Size=UDim2.new(1,-40,1,-top-64)end
        if short then
            for i,b in u.MainButtons do b.Size=UDim2.new(.5,-4,0,36);b.Position=UDim2.new((i-1)%2*.5,0,0,math.floor((i-1)/2)*43)end
        end
        u.Return.Position=UDim2.fromOffset(0,short and 175 or 364)
        if short then
            for i,b in {u.Modes.AI,u.Online,u.Ranked}do b.Size=UDim2.new(1/3,-4,0,42);b.Position=UDim2.new((i-1)/3,0,0,0);b.TextSize=11 end
            u.QueueStatus.Position=UDim2.fromOffset(0,50);u.Modes.Back.Position=UDim2.fromOffset(0,110)
        else
            u.Ranked.Size=UDim2.new(1,0,0,48);u.Ranked.Position=UDim2.fromOffset(0,120);u.QueueStatus.Position=UDim2.fromOffset(0,178);u.Modes.Back.Position=UDim2.fromOffset(0,234)
        end
        if m.CollectionLayout then m.CollectionLayout()end
    end
    require(script.Parent.CollectionUI).Build(u,m,hooks)
    u.Layout()
    return m
end
return Meta
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMusic"><Properties><string name="Name">Music</string><ProtectedString name="Source">local SoundService=game:GetService('SoundService')
local Run=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local ContentProvider=game:GetService('ContentProvider')
local Catalog=require(script.Parent.AudioCatalog)
local Music={}
function Music.Start()
    assert(Run:IsClient(),'Game audio must be created on the local client.')
    local old=SoundService:FindFirstChild('KingdomsAudio');if old then old:Destroy()end
    local legacy=SoundService:FindFirstChild('KingdomsMusic');if legacy then legacy:Destroy()end
    local folder=Instance.new('Folder');folder.Name='KingdomsAudio';folder.Parent=SoundService
    local musicGroup=Instance.new('SoundGroup');musicGroup.Name='Music';musicGroup.Volume=.22;musicGroup.Parent=folder
    local effectsGroup=Instance.new('SoundGroup');effectsGroup.Name='Interface';effectsGroup.Volume=.55;effectsGroup.Parent=folder
    local controller={Folder=folder,MusicGroup=musicGroup,EffectsGroup=effectsGroup,Tracks={},Effects={},Tweens={},LastEffect={},Serial=0}
    for name,track in Catalog.Music do
        local sound=Instance.new('Sound');sound.Name=name;sound.SoundId='rbxassetid://'..(track.Id&gt;0 and track.Id or track.FallbackId)
        sound.Volume=0;sound.Looped=true;sound.SoundGroup=musicGroup;sound.Parent=folder
        controller.Tracks[name]=sound
        -- Loading runs independently of UI and editor updates. A revoked or
        -- unavailable track falls back without blocking gameplay.
        task.spawn(function()
            local failed=false
            local ok=pcall(function()ContentProvider:PreloadAsync({sound},function(_,status)
                if status~=Enum.AssetFetchStatus.Success then failed=true end
            end)end)
            if (not ok or failed)and not controller.Destroyed and sound.Parent then
                warn('Kingdoms audio: could not load '..track.Name..'; using the fallback track.')
                sound.SoundId='rbxassetid://'..Catalog.FallbackMusic
                if controller.Context==name then sound:Play()end
            end
        end)
    end
    for name,effect in Catalog.Effects do
        local sound=Instance.new('Sound');sound.Name=name;sound.SoundId='rbxassetid://'..(effect.Id&gt;0 and effect.Id or effect.FallbackId)
        sound.Volume=effect.Gain;sound.PlaybackSpeed=effect.Id&gt;0 and 1 or effect.Speed;sound.SoundGroup=effectsGroup;sound.Parent=folder
        controller.Effects[name]=sound
    end
    function controller.SetVolume(value)musicGroup.Volume=math.clamp(value,0,1)end
    function controller.SetEffectsVolume(value)effectsGroup.Volume=math.clamp(value,0,1)end
    function controller.PlayEffect(name)
        local sound=controller.Effects[name];local effect=Catalog.Effects[name]
        if controller.Destroyed or not sound or effectsGroup.Volume&lt;=0 then return false end
        local now=os.clock()
        if now-(controller.LastEffect[name]or -math.huge)&lt;effect.Gap or now-(controller.LastAnyEffect or -math.huge)&lt;.06 then return false end
        controller.LastEffect[name]=now;controller.LastAnyEffect=now
        -- This API plays only for this player; no sound request is sent to
        -- the server, buildings, or the opponent's client.
        SoundService:PlayLocalSound(sound)
        return true
    end
    function controller.SetContext(name)
        name=name=='Battle'and 'Battle'or 'Menu'
        if controller.Destroyed or controller.Context==name then return end
        controller.Context=name;controller.Serial+=1;local serial=controller.Serial
        for key,sound in controller.Tracks do
            if controller.Tweens[key]then controller.Tweens[key]:Cancel()end
            if key==name and not sound.IsPlaying then sound:Play()end
            local target=key==name and Catalog.Music[key].Gain or 0
            local tween=Tween:Create(sound,TweenInfo.new(.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Volume=target})
            controller.Tweens[key]=tween;tween:Play()
            if key~=name then task.delay(.85,function()
                if not controller.Destroyed and controller.Serial==serial and controller.Context~=key then sound:Stop()end
            end)end
        end
    end
    function controller.Destroy()
        if controller.Destroyed then return end
        controller.Destroyed=true;controller.Serial+=1
        for _,tween in controller.Tweens do tween:Cancel()end
        folder:Destroy()
    end
    controller.SetContext('Menu')
    return controller
end
return Music
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPlayerData"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source">-- Atomic profile changes preserve maps/preferences and deduplicate matches and receipts.
local P=require(script.Parent.Progression)
local Data={};Data.__index=Data
local function copy(d)return game:GetService('HttpService'):JSONDecode(game:GetService('HttpService'):JSONEncode(d))end
function Data.new(options)
    return setmetatable({S=options or {},Profiles={},Busy={},Errors={},BoardCache={}},Data)
end
function Data:Load(userId,force)
    if self.Profiles[userId]and not force then return self.Profiles[userId]end
    while self.Busy[userId]do task.wait()end;self.Busy[userId]=true
    local ok,value=true,nil
    if self.S.Store then ok,value=pcall(function()local options=Instance.new('DataStoreGetOptions');options.UseCache=false;return self.S.Store:GetAsync('Player_'..userId,options)end)
    elseif force then value=self.Profiles[userId]end
    self.Busy[userId]=nil
    if not ok then self.Errors[userId]='Could not load your profile. Please try again.';return nil,self.Errors[userId]end
    local d=P.Normalize(value);self.Profiles[userId]=d;self.Errors[userId]=nil;return d
end
function Data:Update(userId,change)
    if not self.Profiles[userId]then return false,self.Errors[userId]or 'Your profile is still loading.'end
    while self.Busy[userId]do task.wait()end
    self.Busy[userId]=true;local outcome,rejected
    local ok,value=pcall(function()
        local function transform(old)
            outcome,rejected=nil,nil
            local d=P.Normalize(copy(old or self.Profiles[userId]));local accepted,result=change(d)
            if not accepted then rejected=result;return nil end
            outcome=result;if typeof(result)~='table'or not result.AlreadyApplied then d.Revision+=1 end;return d
        end
        if self.S.Store then return self.S.Store:UpdateAsync('Player_'..userId,transform)end
        return transform(self.Profiles[userId])
    end)
    self.Busy[userId]=nil
    if not ok then return false,'Saving is temporarily unavailable. No changes were applied.'end
    if rejected then return false,rejected end
    if value then self.Profiles[userId]=value end
    return true,outcome
end
function Data:Result(userId,result)
    return self:Update(userId,function(d)
        local reward=P.Apply(d,result);return true,reward or {AlreadyApplied=true}
    end)
end
function Data:Buy(userId,skinId)
    local skin=P.Skin(skinId);if not skin or skin.Price&lt;=0 or skin.RobuxPrice or skin.ChestOnly then return false,'This set cannot be purchased with coins.'end
    return self:Update(userId,function(d)
        if d.Skins[skinId]then return false,'You already own this set.'end
        if d.Coins&lt;skin.Price then return false,'Not enough coins.'end
        d.Coins-=skin.Price;d.Skins[skinId]=true;return true,'Set purchased. Find it in your inventory.'
    end)
end
function Data:Equip(userId,skinId)
    if not P.Skin(skinId)then return false,'Unknown set.'end
    return self:Update(userId,function(d)
        if not d.Skins[skinId]then return false,'Unlock this set first.'end
        d.Equipped=skinId;return true,'Set selected for your next match.'
    end)
end
function Data:OpenChest(userId,requestId,signature)
    if typeof(requestId)~='string'or #requestId&gt;64 or #requestId&lt;8 then return false,'Invalid request.'end
    local roll=self.S.Roll and self.S.Roll()or Random.new():NextNumber()
    return self:Update(userId,function(d)
        if d.Chests[requestId]then
            local previous=d.Chests[requestId]
            local result=typeof(previous)=='table'and copy(previous)or {Skin=previous}
            result.AlreadyApplied=true;return true,result
        end
        local pool,current=P.ChestPool(d)
        if P.CollectionCount(d)==#P.Skins then return false,'You already own every set.'end
        if signature~=current then return false,'The reward list changed. Review the updated odds.'end
        if d.Coins&lt;P.ChestPrice then return false,'Not enough coins.'end
        local id=P.DrawChest(roll);local duplicate=d.Skins[id]==true
        local refund=duplicate and P.Skin(id).DuplicateCoins or 0
        local result={Skin=id,Coins=P.ChestPrice,Duplicate=duplicate,Refund=refund}
        d.Coins=d.Coins-P.ChestPrice+refund;d.Skins[id]=true;d.Chests[requestId]=copy(result)
        return true,result
    end)
end
-- This method is called only after MarketplaceService verifies pass ownership.
function Data:GrantPass(userId,skinId)
    local skin=P.Skin(skinId);if not skin or not skin.RobuxPrice then return false,'Unknown premium set.'end
    return self:Update(userId,function(d)
        if d.Skins[skinId]then return true,{AlreadyApplied=true}end
        d.Skins[skinId]=true;return true,{Skin=skinId}
    end)
end
function Data:Receipt(userId,purchaseId,coins)
    return self:Update(userId,function(d)
        if d.Receipts[purchaseId]then return true,{AlreadyApplied=true}end
        d.Coins+=coins;d.Receipts[purchaseId]=true;return true,{Coins=coins}
    end)
end
function Data:Field(userId,key,value)
    if key~='Map' and key~='Prefs'then return false,'Unknown field.'end
    return self:Update(userId,function(d)d[key]=value;return true,true end)
end
function Data:Deliver(userId,result)
    if self.S.Inbox then
        local queued=pcall(function()self.S.Inbox:UpdateAsync(tostring(userId),function(old)local d=old or {};d[result.Id]=result;return d end)end)
        if not queued then return false,'Your reward is waiting to be saved.'end
    end
    local ok,reward=self:Result(userId,result)
    if ok and self.S.Inbox then pcall(function()self.S.Inbox:UpdateAsync(tostring(userId),function(old)if old then old[result.Id]=nil end;return old end)end)end
    return ok,reward
end
function Data:Recover(userId)
    if not self.S.Inbox then return true end
    local ok,results=pcall(function()return self.S.Inbox:GetAsync(tostring(userId))end)
    if not ok then return false end
    local list={};for _,result in results or {}do table.insert(list,result)end
    table.sort(list,function(a,b)return (a.At or 0)&lt;(b.At or 0)end)
    for _,result in list do if not self:Deliver(userId,result)then return false end end
    return true
end
function Data:Project(userId)
    local d=self.Profiles[userId];if not d then return end
    -- Embed a monotonic profile revision in the ordered score to reject late writes.
    -- Rank is the primary sort field; revision only breaks equal-score ties.
    local scale=100000000
    for name,store in {Wins=self.S.Wins,Rank=self.S.Rank}do
        if store then pcall(function()
            local incoming=d[name]*scale+d.Revision
            store:UpdateAsync(tostring(userId),function(old)
                if old and old%scale&gt;d.Revision then return nil end;return incoming
            end)
        end)end
    end
    self.BoardCache={}
end
function Data:Board(kind,userId)
    kind=kind=='Rank' and 'Rank' or 'Wins';local now=os.clock();local cached=self.BoardCache[kind]
    if not cached or now-cached.At&gt;30 then
        local entries={};local store=self.S[kind]
        if store then
            local ok,pages=pcall(function()return store:GetSortedAsync(false,100)end)
            if not ok then return nil,'The leaderboard is temporarily unavailable.'end
            for i,v in pages:GetCurrentPage()do table.insert(entries,{Place=i,UserId=tonumber(v.key),Score=math.floor(v.value/100000000)})end
        else
            for id,d in self.Profiles do table.insert(entries,{UserId=id,Score=d[kind]})end
            table.sort(entries,function(a,b)return a.Score&gt;b.Score or a.Score==b.Score and a.UserId&lt;b.UserId end)
            for i,v in entries do v.Place=i end
        end
        cached={At=now,Entries=entries};self.BoardCache[kind]=cached
    end
    local mine=self.Profiles[userId];local place
    for _,entry in cached.Entries do if entry.UserId==userId then place=entry.Place;break end end
    local store=self.S[kind]
    if not place and store and mine then
        local ok,position=pcall(function()
            local score=store:GetAsync(tostring(userId));if score==nil then return nil end
            local pages=store:GetSortedAsync(false,100,score+1);local count=0
            while true do
                count+=#pages:GetCurrentPage()
                if pages.IsFinished then return count+1 end
                pages:AdvanceToNextPageAsync()
            end
        end)
        if ok then place=position end
    end
    return {Kind=kind,Entries=copy(cached.Entries),Mine={Place=place,Score=mine and mine[kind]or 0},Global=self.S.Store~=nil}
end
return Data
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXProgression"><Properties><string name="Name">Progression</string><ProtectedString name="Source">-- Approved progression and cosmetic economy. Combat never reads these values.
local P={XPPerLevel=200,CoinsPerLevel=100,CalibrationMatches=10,CalibrationWin=100,CalibrationLoss=25,RankWin=25,RankLoss=25}
local Styles=require(script.Parent.SkinStyles)
P.Skins=Styles.Items
P.Rarities=Styles.Rarities
P.ChestPrice=300
-- Developer products belonging to Frontier Kingdoms (universe 10769541065).
P.Products={{Id='Small',Coins=500,Price=49,ProductId=3716851182},{Id='Medium',Coins=1500,Price=129,ProductId=3716851330},{Id='Large',Coins=3500,Price=249,ProductId=3716851499}}
local function number(value,default)
    return typeof(value)=='number' and value==value and value~=math.huge and value~=-math.huge and math.max(0,math.floor(value)) or default or 0
end
function P.Skin(id)for _,skin in P.Skins do if skin.Id==id then return skin end end end
function P.Product(id)for _,product in P.Products do if product.Id==id then return product end end end
function P.Band(level)
    level=number(level,1);return level&lt;10 and '1–9' or level&lt;25 and '10–24' or level&lt;50 and '25–49' or '50+'
end
function P.Normalize(d)
    d=typeof(d)=='table' and d or {}
    for _,key in {'XP','Coins','Rank','RankedGames','WinStreak','Wins','Losses','RankedWins','AIWins','AILosses','Revision'}do d[key]=number(d[key])end
    d.Level=1+math.floor(d.XP/P.XPPerLevel)
    d.Skins=typeof(d.Skins)=='table' and d.Skins or {};d.Skins.Default=true
    d.Equipped=P.Skin(d.Equipped) and d.Skins[d.Equipped]==true and d.Equipped or 'Default'
    d.Matches=typeof(d.Matches)=='table' and d.Matches or {};d.Receipts=typeof(d.Receipts)=='table' and d.Receipts or {};d.Chests=typeof(d.Chests)=='table'and d.Chests or {}
    return d
end
function P.Public(d)
    local result={};for _,key in {'XP','Level','Coins','Rank','RankedGames','WinStreak','Wins','Losses','RankedWins','AIWins','AILosses','Equipped','Revision'}do result[key]=d[key]end
    result.LevelXP=d.XP%P.XPPerLevel;result.LobbyBand=P.Band(d.Level);result.Skins=table.clone(d.Skins);return result
end
function P.ChestPool(d)
    -- Odds stay fixed when the inventory changes; owning commons never makes
    -- a mythic guaranteed. Duplicates give the advertised coin compensation.
    local pool,signature,total={}, {'v013',tostring(P.ChestPrice)},0
    for _,skin in P.Skins do if skin.Id~='Default'then
        table.insert(pool,skin.Id);table.insert(signature,skin.Id..':'..skin.Weight..':'..skin.DuplicateCoins);total+=skin.Weight
    end end
    return pool,table.concat(signature,'|'),total
end
function P.CollectionCount(d)
    local count=0;for _,skin in P.Skins do if d.Skins[skin.Id]==true then count+=1 end end;return count
end
function P.ChestRewards(d)
    local pool,signature,total=P.ChestPool(d);local rewards={}
    for _,id in pool do local skin=P.Skin(id);table.insert(rewards,{Id=id,Weight=skin.Weight,Total=total,Chance=skin.Weight/total*100,Owned=d.Skins[id]==true,Refund=skin.DuplicateCoins})end
    return rewards,signature
end
function P.DrawChest(roll)
    local pool,_,total=P.ChestPool();local cursor=math.clamp(roll,0,1)*total
    for _,id in pool do cursor-=P.Skin(id).Weight;if cursor&lt;0 then return id end end
    return pool[#pool]
end
function P.Apply(d,result)
    if d.Matches[result.Id]then return nil end
    local beforeLevel,beforeRank=d.Level,d.Rank;local won=result.Won==true;local xp=0
    if result.Mode=='AI'then
        if won then d.AIWins+=1;xp=({Easy=20,Normal=35,Hard=50})[result.Difficulty]or 50 else d.AILosses+=1 end
    else
        if won then d.Wins+=1;xp=100 else d.Losses+=1;xp=result.Forfeit and 0 or 40 end
        if result.Mode=='Ranked'then
            local calibrating=d.RankedGames&lt;P.CalibrationMatches
            d.RankedGames+=1;d.WinStreak=won and d.WinStreak+1 or 0
            if won then
                d.RankedWins+=1
                local gain=calibrating and P.CalibrationWin or d.WinStreak&gt;=5 and 50 or d.WinStreak==4 and 45 or d.WinStreak==3 and 35 or P.RankWin
                d.Rank+=gain
            else d.Rank=math.max(0,d.Rank-(calibrating and P.CalibrationLoss or P.RankLoss))end
        end
    end
    d.XP+=xp;d.Level=1+math.floor(d.XP/P.XPPerLevel)
    local coins=(d.Level-beforeLevel)*P.CoinsPerLevel;d.Coins+=coins;d.Matches[result.Id]=true
    return {XP=xp,Coins=coins,Levels=d.Level-beforeLevel,Rank=d.Rank-beforeRank,Won=won,Mode=result.Mode}
end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXRoadCosmetics"><Properties><string name="Name">RoadCosmetics</string><ProtectedString name="Source">-- Appearance only. This never changes the path graph or combat rules.
local R={}
function R.Owners(map,sites)
    local named={};for _,node in map.Definition.Nodes do named[node.Id]=node end
    local neighbors={};for _,road in map.Roads do
        neighbors[road.A]=neighbors[road.A]or {};neighbors[road.B]=neighbors[road.B]or {}
        table.insert(neighbors[road.A],road.B);table.insert(neighbors[road.B],road.A)
    end
    local endpoint={}
    local function owner(id)
        if endpoint[id]~=nil then return endpoint[id]end
        if sites[id]then endpoint[id]=sites[id].Owner;return endpoint[id]end
        local seen,queue,result={[id]=true},{id},nil
        for _,key in queue do
            for _,nextId in neighbors[key]or {}do
                if sites[nextId]then
                    local side=sites[nextId].Owner
                    if side==0 or result and result~=side then endpoint[id]=0;return 0 end
                    result=side
                elseif not seen[nextId]then seen[nextId]=true;table.insert(queue,nextId)end
            end
        end
        endpoint[id]=result or 0;return endpoint[id]
    end
    local claimed={}
    for _,road in map.Roads do local a,b=owner(road.A),owner(road.B);claimed[road]=a&gt;0 and a==b and a or 0 end
    local result={}
    for i,edge in map.Edges do
        local side=nil
        for _,road in edge.Roads do local o=claimed[road];if o==0 or side and side~=o then side=0;break end;side=o end
        for _,id in edge.Controls do if not sites[id]or sites[id].Owner~=side then side=0;break end end
        result[i]=side or 0
    end
    return result
end
return R
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXScene"><Properties><string name="Name">Scene</string><ProtectedString name="Source">local Config=require(script.Parent.Config)
local Map=require(script.Parent.MapData)
local Art=require(script.Parent.Art)
local RoadCosmetics=require(script.Parent.RoadCosmetics)
local Scene={}
local function buildingRoot(position,ground)
    return CFrame.new(position.X,ground,position.Z)*CFrame.Angles(0,Config.BuildingYaw,0)
end
local function part(parent,name,size,cf,color,material)
    local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=parent;return p
end
local function buildNode(folder,site,viewerSide)
    local model=Instance.new('Model');model.Name=site.Id;model:SetAttribute('SiteId',site.Id);model.Parent=folder
    local foundation=part(model,'Foundation',Vector3.new(27,.16,27),CFrame.new(site.Position.X,.035,site.Position.Z),Color3.fromRGB(157,157,128),Enum.Material.Cobblestone)
    local teamColor=Config.TeamColor(site.Owner,viewerSide)
    local borders={}
    for _,edge in {{0,-13.15,27,.7},{0,13.15,27,.7},{-13.15,0,.7,27},{13.15,0,.7,27}}do
        table.insert(borders,part(model,'Team Border',Vector3.new(edge[3],.06,edge[4]),CFrame.new(site.Position.X+edge[1],.145,site.Position.Z+edge[2]),teamColor))
    end
    foundation.Color=Color3.fromRGB(157,157,140):Lerp(teamColor,.18)
    local base=Art.Bounds(site.Kind..'_Base');local ground=.115-base.Minimum.Y
    local root=buildingRoot(site.Position,ground)
    local pick=part(model,'Selection',Vector3.new(29,Config.Buildings[site.Kind].Height,29),CFrame.new(site.Position.X,Config.Buildings[site.Kind].Height/2,site.Position.Z),Color3.new(1,1,1))
    pick.Transparency=1;pick.CanQuery=true;pick:SetAttribute('SiteId',site.Id);model.PrimaryPart=pick
    local pieces,roots,heights={},{},{}
    for level=1,3 do
        local name=site.Kind..(level==1 and '_Base' or '_Upgrade'..level)
        local template=Art.Bounds(name);local min,max=template.Minimum,template.Maximum
        roots[level]=buildingRoot(site.Position,.115-min.Y);heights[level]=.115+max.Y-min.Y
        if level==1 then local mesh=Art.Clone(name,model,roots[level]);mesh:SetAttribute('RequiredLevel',level);table.insert(pieces,mesh)end
    end
    pick.Size=Vector3.new(29,heights[3]+4,29);pick.CFrame=CFrame.new(site.Position.X,(heights[3]+4)/2,site.Position.Z)
    local ruins=site.Kind=='Tower' and Art.Clone('Tower_Ruins',model,root) or nil;if ruins then ruins.Transparency=1 end
    local height=heights[1]
    local pole=Art.Clone('FlagPole',model,CFrame.new(site.Position.X,height-.9,site.Position.Z))
    local flag=Art.Clone('FlagCloth',model,CFrame.new(site.Position.X,height+1.4,site.Position.Z),teamColor)
    local labelPoint=site.Position+Vector3.new(0,height+4,0)
    return {Owner=site.Owner,Model=model,Pick=pick,Parts=pieces,Level=1,Flag=flag,Pole=pole,Heights=heights,Kind=site.Kind,Ruins=ruins,Position=site.Position,LabelPoint=labelPoint,Foundation=foundation,Borders=borders}
end
local function buildRoads(folder,activeMap)
    local gates={}
    local roads=Instance.new('Folder');roads.Name='Roads';roads.Parent=folder
    local roadRecords={}
    for index,edge in activeMap.Edges do
        local a,c=activeMap.GraphPoints[edge[1]],activeMap.GraphPoints[edge[2]]
        local center=(a+c)/2+Vector3.new(0,.075,0)
        local road=part(roads,'Road',Vector3.new(4.6,.12,(a-c).Magnitude+.08),CFrame.lookAt(center,c+Vector3.new(0,.075,0)),Color3.fromRGB(202,183,137),Enum.Material.Sand)
        road:SetAttribute('From',edge[1]);road:SetAttribute('To',edge[2])
        roadRecords[index]={Base=road,Edge=edge,A=a,B=c,Parts={},Skin=nil}
    end
    for _,p in activeMap.GraphPoints do
        part(roads,'Junction',Vector3.new(4.6,.12,4.6),CFrame.new(p.X,.075,p.Z),Color3.fromRGB(202,183,137),Enum.Material.Sand)
    end
    for _,bridge in activeMap.Bridges do
        Art.Clone('Bridge',roads,CFrame.new(bridge.Position.X,-.1,bridge.Position.Z))
        local gate=part(roads,'Crossing',Vector3.new(1.1,4.2,7),CFrame.new(bridge.Position.X,2,bridge.Position.Z),Color3.fromRGB(83,53,32),Enum.Material.WoodPlanks);gate:SetAttribute('Gate',true);table.insert(gates,gate)
    end
    return roads,roadRecords,gates
end
local function buildJunction(folder,n)
    local pick=part(folder,n.Id,Vector3.new(8,.35,8),CFrame.new(n.X*32,.15,n.Z*32),Color3.fromRGB(211,191,143),Enum.Material.Cobblestone)
    pick.CanQuery=true;pick:SetAttribute('SiteId',n.Id);pick:SetAttribute('CellX',n.X);pick:SetAttribute('CellZ',n.Z)
    return pick
end
local function samePosition(a,b)return a.X==b.X and a.Y==b.Y and a.Z==b.Z end
local function sameRoutes(a,b)
    if #a.Edges~=#b.Edges or #a.Bridges~=#b.Bridges then return false end
    for i,edge in a.Edges do
        local other=b.Edges[i]
        if edge[1]~=other[1] or edge[2]~=other[2] or edge.Crossing~=other.Crossing then return false end
    end
    for id,p in a.GraphPoints do if not b.GraphPoints[id] or not samePosition(p,b.GraphPoints[id])then return false end end
    for id in b.GraphPoints do if not a.GraphPoints[id]then return false end end
    for i,bridge in a.Bridges do if not samePosition(bridge.Position,b.Bridges[i].Position)then return false end end
    return true
end
local function buildScene(folder,activeMap,viewerSide)
    local grid=Instance.new('Folder');grid.Name='Grid';grid.Parent=folder
    local h=activeMap.CellSize/2;local b=activeMap.Bounds
    local extent=(b.MaxX+.5)*activeMap.CellSize;local depth=(b.MaxZ-b.MinZ+1)*activeMap.CellSize
    if activeMap.River then for _,side in {-1,1} do
        part(folder,'Riverbank',Vector3.new(extent-h,3,depth),CFrame.new(side*(extent+h)/2,-1.5,0),Color3.fromRGB(120,147,92),Enum.Material.Grass)
    end
    local water=part(folder,'River',Vector3.new(activeMap.CellSize,.15,depth),CFrame.new(0,-.12,0),Color3.fromRGB(77,143,164),Enum.Material.Glass);water.Transparency=.12
    else part(folder,'Plain',Vector3.new(extent*2,3,depth),CFrame.new(0,-1.5,0),Color3.fromRGB(120,147,92),Enum.Material.Grass)end
    for x=b.MinX,b.MaxX do for z=b.MinZ,b.MaxZ do
        if activeMap.River and x==0 then continue end
        local shade=(x+z)%2==0 and Color3.fromRGB(149,170,121) or Color3.fromRGB(130,154,107)
        local tile=part(grid,'Cell',Vector3.new(activeMap.CellSize-.35,.025,activeMap.CellSize-.35),CFrame.new(x*32,.017,z*32),shade)
        tile:SetAttribute('CellX',x);tile:SetAttribute('CellZ',z);tile.Transparency=1
    end end
    local roads,roadRecords,gates=buildRoads(folder,activeMap)
    local nodes={}
    for _,site in activeMap.Sites do nodes[site.Id]=buildNode(folder,site,viewerSide)end
    local junctions={}
    for _,n in activeMap.Definition.Nodes do
        if n.Kind=='Junction' then
            junctions[n.Id]=buildJunction(folder,n)
        end
    end
    for i=1,34 do
        local side=i%2==0 and -1 or 1
        Art.Clone('Tree',folder,CFrame.new(side*(42+(i*43)%220),0,(i%3==0 and -1 or 1)*(146+(i*7)%19))*CFrame.Angles(0,i*1.23,0))
    end
    for _,p in {{-244,-145},{244,145},{-220,160},{220,-160},{-24,-161},{24,161}} do Art.Clone('Rock',folder,CFrame.new(p[1],0,p[2])) end
    local units=Instance.new('Folder');units.Name='Armies';units.Parent=folder
    return {Folder=folder,Nodes=nodes,Junctions=junctions,Units=units,Grid=grid,Map=activeMap,ViewerSide=viewerSide or 1,Roads=roads,RoadRecords=roadRecords,Gates=gates}
end
-- Keep the displayed scene alive until its replacement is complete.
function Scene.Build(parent,activeMap,viewerSide)
    activeMap=activeMap or Map;Art.Prepare()
    for _,p in parent:GetChildren()do
        if p:IsA('SpawnLocation') or p.Name=='Baseplate' and p:IsA('BasePart')then
            p.Transparency=1;p.CanCollide=false;p.CanQuery=false
            for _,d in p:GetDescendants()do if d:IsA('Decal') or d:IsA('Texture')then d.Transparency=1 end end
        end
    end
    local old=parent:FindFirstChild('KingdomsScene')
    local folder=Instance.new('Folder');folder.Name='KingdomsScene'
    local ok,result=pcall(buildScene,folder,activeMap,viewerSide or 1)
    if not ok then folder:Destroy();Art.Prune();error(result)end
    folder.Parent=parent
    if old then old:Destroy()end
    Art.Prune()
    return result
end
-- Editor edits retain scenery, grid, unchanged buildings and unchanged roads.
-- Stage new objects first so failed mesh allocation leaves the map usable.
function Scene.SyncEditor(scene,activeMap)
    local before=scene.Map
    local a,b=before.Bounds,activeMap.Bounds
    if before.River~=activeMap.River or before.CellSize~=activeMap.CellSize
        or a.MinX~=b.MinX or a.MaxX~=b.MaxX or a.MinZ~=b.MinZ or a.MaxZ~=b.MaxZ then
        return Scene.Build(scene.Folder.Parent,activeMap,scene.ViewerSide)
    end
    local staging=Instance.new('Folder')
    local nodes,junctions={},{}
    local roads,records,gates
    local ok,reason=pcall(function()
        for _,site in activeMap.Sites do
            local existing=scene.Nodes[site.Id]
            if existing and existing.Kind==site.Kind and existing.Owner==site.Owner and samePosition(existing.Position,site.Position)then
                nodes[site.Id]=existing
            else nodes[site.Id]=buildNode(staging,site,scene.ViewerSide)end
        end
        for _,n in activeMap.Definition.Nodes do if n.Kind=='Junction'then
            local existing=scene.Junctions[n.Id]
            if existing and existing:GetAttribute('CellX')==n.X and existing:GetAttribute('CellZ')==n.Z then junctions[n.Id]=existing
            else junctions[n.Id]=buildJunction(staging,n)end
        end end
        if not sameRoutes(before,activeMap)then roads,records,gates=buildRoads(staging,activeMap)end
    end)
    if not ok then staging:Destroy();Art.Prune();error(reason)end
    for id,n in nodes do if scene.Nodes[id]~=n then n.Model.Parent=scene.Folder end end
    for id,n in scene.Nodes do if nodes[id]~=n then n.Model:Destroy()end end
    for id,p in junctions do if scene.Junctions[id]~=p then p.Parent=scene.Folder end end
    for id,p in scene.Junctions do if junctions[id]~=p then p:Destroy()end end
    if roads then
        roads.Parent=scene.Folder;scene.Roads:Destroy()
        scene.Roads=roads;scene.RoadRecords=records;scene.Gates=gates;scene.RoadAppearance=nil
    end
    staging:Destroy()
    scene.Nodes=nodes;scene.Junctions=junctions;scene.Map=activeMap
    Art.Prune()
    return scene
end
function Scene.GridVisible(scene,visible)
    for _,p in scene.Grid:GetChildren() do p.Transparency=visible and .5 or 1 end
end
function Scene.Update(scene,state)
    for id,s in state.Sites do
        local n=scene.Nodes[id];if not n then continue end
        local color=Config.TeamColor(s.Owner,scene.ViewerSide);n.Flag.Color=color
        n.Foundation.Color=Color3.fromRGB(157,157,140):Lerp(color,.18)
        for _,p in n.Borders do p.Color=color end
        local collapsed=n.Kind=='Tower' and s.Health and s.Health&lt;=0
        if n.Level~=s.Level then
            for _,p in n.Parts do p:Destroy()end;n.Parts={};n.Level=s.Level
            local name=n.Kind..(s.Level==1 and '_Base'or '_Upgrade'..s.Level);local bounds=Art.Bounds(name)
            local mesh=Art.Clone(name,n.Model,buildingRoot(n.Position,.115-bounds.Minimum.Y));mesh:SetAttribute('RequiredLevel',s.Level);table.insert(n.Parts,mesh)
        end
        for _,p in n.Parts do p.Transparency=not collapsed and p:GetAttribute('RequiredLevel')==s.Level and 0 or 1 end
        local height=collapsed and 1.8 or n.Heights[s.Level]
        local skin=s.Owner&gt;0 and state.Skins and state.Skins[s.Owner]or 'Default'
        local appearance=skin..':'..s.Owner..':'..s.Level..':'..tostring(collapsed)
        if n.Appearance~=appearance then
            if n.Decor then n.Decor:Destroy()end;if n.Styled then n.Styled:Destroy();n.Styled=nil end
            if skin~='Default'and not collapsed then
                for _,p in n.Parts do p.Transparency=1 end
                local name=n.Kind..(s.Level==1 and '_Base'or '_Upgrade'..s.Level)
                local template=Art.Bounds(name);local ground=.115-template.Minimum.Y
                n.Styled=Art.Clone(name,n.Model,buildingRoot(n.Position,ground),nil,skin)
            end
            n.Decor=Instance.new('Folder');n.Decor.Name='Cosmetics';n.Decor.Parent=n.Model
            if s.Owner&gt;0 and not collapsed then
                local front=({Village=3.32,Castle=s.Level==1 and 5.50 or 9.75,Barracks=3.82,Archery=2.4,Camp=2.3,Tower=2.78,Farm=.25})[n.Kind]
                local dx=n.Kind=='Archery'and 1 or n.Kind=='Farm'and 2 or 0
                local y=n.Kind=='Castle'and (s.Level==1 and 4.3 or 3.0)or n.Kind=='Tower'and 4.1 or n.Kind=='Camp'and 2.3 or 2.1
                local plaque=Art.Clone(skin..'_Herald',n.Decor,buildingRoot(n.Position+Vector3.new(dx,0,front),y))
                plaque.Name='Heraldry'
                Art.Clone(skin..'_RoofCrest',n.Decor,buildingRoot(n.Position,height-.1))
                if Art.Modules[skin..'_Gateway']then
                    local offset=Config.DoorOffsets[n.Kind];if typeof(offset)=='table'then offset=offset[s.Level]end
                    local gate=Art.Clone(skin..'_Gateway',n.Decor,buildingRoot(n.Position+offset+Vector3.new(0,0,.28),.12))
                    gate.Name='Premium Gateway'
                end
            end
            n.Appearance=appearance
        elseif n.Styled then for _,p in n.Parts do p.Transparency=1 end end
        n.Pole.CFrame=CFrame.new(n.Position.X,height-.9,n.Position.Z)*CFrame.new(Art.Cache.FlagPole:GetAttribute('Center'))*(n.Pole:GetAttribute('MeshRotation')or CFrame.identity)
        n.Flag.CFrame=CFrame.new(n.Position.X,height+1.4,n.Position.Z)*CFrame.new(Art.Cache.FlagCloth:GetAttribute('Center'))*(n.Flag:GetAttribute('MeshRotation')or CFrame.identity)
        n.LabelPoint=n.Position+Vector3.new(0,height+4,0)
        if n.Ruins then n.Ruins.Transparency=collapsed and 0 or 1 end
    end
    local signature={};for _,site in scene.Map.Sites do local s=state.Sites[site.Id];table.insert(signature,site.Id..':'..(s and s.Owner or 0))end
    for side=1,2 do table.insert(signature,state.Skins and state.Skins[side]or 'Default')end
    signature=table.concat(signature,'|')
    if scene.RoadAppearance~=signature then
        local owners=RoadCosmetics.Owners(scene.Map,state.Sites)
        for i,record in scene.RoadRecords do
            local side=owners[i];local skin=side&gt;0 and not record.Edge.Crossing and (state.Skins and state.Skins[side]or 'Default')or nil
            if record.Skin~=skin or record.Owner~=side then
                for _,p in record.Parts do p:Destroy()end;record.Parts={};record.Base.Transparency=skin and 1 or 0
                if skin then
                    local length=(record.B-record.A).Magnitude;local count=math.max(1,math.ceil(length/4))
                    for tile=1,count do
                        local position=record.A:Lerp(record.B,(tile-.5)/count)+Vector3.new(0,.08,0)
                        local p=Art.Clone(skin..'_RoadTile',scene.Roads,CFrame.lookAt(position,position+(record.B-record.A)))
                        p.Size=Vector3.new(4.60,p.Size.Y,length/count+.055);p.Name='Owned Road';p:SetAttribute('Owner',side)
                        table.insert(record.Parts,p)
                    end
                end
                record.Skin=skin;record.Owner=side
            end
        end
        scene.RoadAppearance=signature
    end
    for _,p in scene.Gates do p.Transparency=state.Time&gt;=Config.PrepTime and 1 or 0 end
end
return Scene

</ProtectedString></Properties></Item><Item class="Script" referent="RBXServer"><Properties><string name="Name">Server</string><ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Http=game:GetService('HttpService')
game:GetService('SoundService').RespectFilteringEnabled=true
local root=RS:WaitForChild('Kingdoms')
local Engine=require(root.Engine)
local Config=require(root.Config)
local Default=require(root.MapData)
local Network=require(root.MapNetwork)
local Catalog=require(root.MapCatalog)
local MatchLobby=require(root.MatchLobby)
local ServerNetwork=require(root.ServerNetwork)
local Progression=require(root.Progression)
local Account=require(root.AccountServer)
Players.CharacterAutoLoads=false
local lighting=game:GetService('Lighting')
lighting.ClockTime=14.5;lighting.Brightness=2
lighting.Ambient=Color3.fromRGB(130,135,119);lighting.OutdoorAmbient=Color3.fromRGB(156,163,148);lighting.GlobalShadows=true
local function remote(name)local r=root:FindFirstChild(name)or Instance.new('RemoteEvent');r.Name=name;r.Parent=root;return r end
local command,update,feedback,editorData=remote('Command'),remote('Snapshot'),remote('Feedback'),remote('EditorData')
local ready,throttles,profiles={}, {},{}
local account=Account.new(root,function(p,text)if p.Parent then feedback:FireClient(p,text)end end)
local lobby=MatchLobby.new({SharedLobby=not Run:IsStudio(),Profile=function(p)return account:Profile(p)end,Completed=function(session)account:Complete(session)end,SetSide=function(p,side)p:SetAttribute('KingdomSide',side)end,Notify=function(p,text)feedback:FireClient(p,text)end})
local network,privateSession,tryPrivate
local function snapshot(session,recipient)
    for _,s in session and {session} or lobby:Sessions()do
        local data=s.State:Snapshot();data.MapRevision=s.Revision;data.Mode=s.Mode;data.Skins=s.Skins
        for player,side in recipient and {[recipient]=s.Members[recipient]}or s.Members do if ready[player]then
            data.ViewerSide=side;data.Queueing=lobby:IsQueued(player);data.Connecting=false;data.PrivateMatch=false;data.Studio=Run:IsStudio()
            data.QueueMode=lobby.QueueInfo[player]and lobby.QueueInfo[player].Mode
            if network and not network.Studio then data.Queueing,data.Connecting=network:Status(player);data.PrivateMatch=network.Reserved and not network.IsHub;data.QueueMode=network.QueueMode and network.QueueMode[player]end
            local profile=account:Profile(player);data.LobbyBand=network and network.IsHub and network.Metadata.Band or profile and Progression.Band(profile.Level)
            update:FireClient(player,data)
        end end
    end
end
tryPrivate=function()
    if not network or not network.Reserved or network.IsHub or privateSession then return end
    local metadata=network.Metadata;if not metadata then return end
    local members={}
    for side,userId in metadata.Users do
        local player=Players:GetPlayerByUserId(userId)
        if not player or not ready[player]or not account:Profile(player)then return end
        members[player]=side
    end
    local map=metadata.Definition and Network.Create(metadata.Definition) or Catalog.Create(metadata.MapId)
    if not map then return end
    for p in members do lobby:Leave(p,true)end
    privateSession=lobby:NewSession(members,map,metadata.Mode,metadata.Difficulty);privateSession.Id=metadata.MatchId;privateSession.State:Start();snapshot(privateSession)
end
network=ServerNetwork.new(function(p,text)feedback:FireClient(p,text)end,function(p)
    if not p.Parent then return end
    if network and network.Reserved and network.MetadataLoaded then
        if not network.Metadata or not network.IsHub and not table.find(network.Metadata.Users,p.UserId)then p:Kick('This server is reserved for the players in one match.');return end
        tryPrivate()
    end
    if network and ready[p]then network:EnsureLobby(p,account:Profile(p))end
    if lobby.Players[p]then snapshot(lobby.Players[p],p)end
end)
local function register(player)
    local d=account:Load(player);if not player.Parent then return end
    profiles[player]=d;lobby:Register(player)
    if ready[player]and d then
        editorData:FireClient(player,{Map=d.Map,Prefs=d.Prefs,Persistent=account.Data.S.Store~=nil})
        if network then network:EnsureLobby(player,d)end;tryPrivate()
        snapshot(lobby.Players[player],player)
    end
end
Players.PlayerAdded:Connect(register);for _,p in Players:GetPlayers()do register(p)end
Players.PlayerRemoving:Connect(function(p)ready[p]=nil;throttles[p]=nil;profiles[p]=nil;network:Remove(p);lobby:Leave(p,true);task.defer(function()account:Release(p)end);if network.Studio or network.Reserved then snapshot()end end)
command.OnServerEvent:Connect(function(player,action,payload)
    if typeof(action)~='string' or typeof(payload)~='table' then return end
    if action=='Ready'then
        if network.Reserved and network.MetadataLoaded and (not network.Metadata or not network.IsHub and not table.find(network.Metadata.Users,player.UserId))then player:Kick('This server is reserved for the players in one match.');return end
        ready[player]=true
        local d=account:Profile(player)or account:Load(player);if not d then return end
        account:Publish(player);tryPrivate();snapshot(lobby:Register(player),player);editorData:FireClient(player,{Map=d.Map,Prefs=d.Prefs,Persistent=account.Data.S.Store~=nil})
        network:EnsureLobby(player,d)
        return
    end
    if not ready[player]then return end
    if not account:Profile(player)then feedback:FireClient(player,'Your profile is still loading.');return end
    local now=os.clock();throttles[player]=throttles[player]or {}
    if now-(throttles[player][action]or 0)&lt;.12 then return end;throttles[player][action]=now
    if action=='Prefs'then
        local data={}
        for _,k in {'Music','Effects','Camera','Zoom'}do local v=payload[k];if typeof(v)=='number'and v==v then local audio=k=='Music'or k=='Effects';data[k]=math.clamp(v,audio and 0 or .5,audio and 1 or 2)end end
        data.Grid=payload.Grid==true;data.Labels=payload.Labels~=false
        data.BattleTutorialDone=payload.BattleTutorialDone==true
        local ok,message=account.Data:Field(player.UserId,'Prefs',data);if not ok then feedback:FireClient(player,message)end;return
    elseif action=='SaveMap'then
        local map,reason=Network.Create(payload.Definition)
        if not map then feedback:FireClient(player,reason);return end
        local ok,message=account.Data:Field(player.UserId,'Map',map.Definition)
        if not ok then feedback:FireClient(player,message);return end
        editorData:FireClient(player,{Map=map.Definition,Persistent=account.Data.S.Store~=nil,Saved=true})
        return
    end
    local ok,message=false,'Unknown command.'
    local session=lobby:Register(player);local state=session.State;local side=session.Members[player]
    if action=='Start'then
        if state.Phase=='Waiting'or state.Phase=='Ended'then
            local map=Default
            if payload.Definition then
                local reason;map,reason=Network.Create(payload.Definition)
                if not map then feedback:FireClient(player,reason);return end
            elseif payload.MapId=='Random'then map=Catalog.Random()
            elseif payload.MapId then
                local known=false;for _,item in Catalog.Items do if item.Id==payload.MapId then known=true;break end end
                if not known then feedback:FireClient(player,'Select an existing map.');return end
                map=assert(Catalog.Create(payload.MapId))
            end
            local difficulty=Config.BotInterval[payload.Difficulty]and payload.Difficulty or 'Hard'
            if network.Studio then ok,message=lobby:StartAI(player,map,difficulty)
            else
                local mapId='TwoBridges';for _,item in Catalog.Items do if item.Name==map.Definition.Name then mapId=item.Id;break end end
                ok,message=network:Solo(player,payload.Definition and map.Definition or nil,mapId,difficulty)
            end
        else message='A battle is already in progress.'end
    elseif action=='JoinPvP'or action=='JoinRanked'then
        local mode=action=='JoinRanked'and 'Ranked'or 'PvP'
        if network.Studio then ok,message=lobby:Join(player,mode)else ok,message=network:Join(player,account:Profile(player),mode)end
    elseif action=='CancelPvP'then if network.Studio then lobby:CancelQueue(player);ok=true;message='Search cancelled.'else ok,message=network:Cancel(player)end
    elseif action=='ReturnMenu'then
        if network.Reserved and not network.IsHub then lobby:Leave(player,false);account:Await(player);local profile=account:Profile(player);if player.Parent then network:Return(player,profile and profile.Level)end;ok=true;message='Returning to the lobby…'
        elseif network.Studio then lobby:Leave(player,false);ok=true;message='Match ended.'
        else ok,message=network:Cancel(player)end
    elseif action=='Send'then ok,message=state:Send(side,payload.Sources,payload.Target,payload.Percent,payload.Filter,payload.Route)
    elseif action=='Upgrade'then ok,message=state:Upgrade(side,payload.Site)
    end
    feedback:FireClient(player,message,ok);if network.Studio or network.Reserved then snapshot()else snapshot(lobby.Players[player],player)end
end)
local accumulator,sync=0,0
Run.Heartbeat:Connect(function(dt)
    accumulator+=math.min(dt,.5);sync+=dt;local steps=0
    while accumulator&gt;=Config.Step and steps&lt;5 do accumulator-=Config.Step;lobby:Step(Config.Step);steps+=1 end
    if sync&gt;=Config.SnapshotInterval then sync=0;if next(ready)then
        for _,s in lobby:Sessions()do if s.State.Phase~='Waiting'then snapshot(s)end end
    end end
end)
if network.Reserved then task.delay(90,function()
    if not privateSession and not network.IsHub then for _,p in Players:GetPlayers()do feedback:FireClient(p,'The second player did not connect. Returning to the lobby.');network:Return(p,account:Profile(p)and account:Profile(p).Level)end end
end)end
if Run:IsStudio()then _G.KingdomsLobby=lobby;_G.KingdomsAccount=account end

</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="ModuleScript" referent="RBXServerNetwork"><Properties><string name="Name">ServerNetwork</string><ProtectedString name="Source">local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local Teleport=game:GetService('TeleportService')
local Http=game:GetService('HttpService')
local Catalog=require(script.Parent.MapCatalog)
local Global=require(script.Parent.GlobalMatchmaker)
local Directory=require(script.Parent.LobbyDirectory)
local Progression=require(script.Parent.Progression)
local Network={};Network.__index=Network
function Network.new(notify,changed)
    local self=setmetatable({Studio=Run:IsStudio(),Reserved=game.PrivateServerId~=''and game.PrivateServerOwnerId==0,Tokens={},Connections={},Notify=notify,Changed=changed,Metadata=nil,Closed=false},Network)
    if self.Studio then return self end
    local memory=game:GetService('MemoryStoreService')
    self.Core=Global.new({Queue=memory:GetSortedMap('KingdomsQueueV1'),Tickets=memory:GetHashMap('KingdomsTicketsV1'),Matches=memory:GetHashMap('KingdomsMatchesV1'),Now=os.time,Guid=function()return Http:GenerateGUID(false)end,Reserve=function()return Teleport:ReserveServerAsync(game.PlaceId)end,RandomMap=function()return Catalog.Items[Random.new():NextInteger(1,#Catalog.Items)].Id end})
    self.Core.S.QueueFor=function(key)return memory:GetSortedMap('KingdomsQueueV2_'..key)end
    self.Directory=Directory.new({Registry=memory:GetSortedMap('KingdomsLobbiesV1'),Locks=memory:GetHashMap('KingdomsLobbyLocksV1'),Matches=self.Core.S.Matches,Now=os.time,Guid=self.Core.S.Guid,Reserve=self.Core.S.Reserve,Capacity=Players.MaxPlayers})
    Teleport.TeleportInitFailed:Connect(function(player,_,_,_,options)
        local connection=self.Connections[player]
        if connection then connection.InFlight=false;connection.Options=options;connection.NextAttempt=os.clock()+3;self.Notify(player,'Connection delayed. Retrying…')end
    end)
    if self.Reserved then
        task.spawn(function()
            for _=1,3 do
                local ok,data=pcall(function()return self.Core.S.Matches:GetAsync(game.PrivateServerId)end)
                if ok and data and data.State=='Ready'then self.Metadata=data;self.IsHub=data.Mode=='Lobby';break end
                task.wait(2)
            end
            self.MetadataLoaded=true
            for _,p in Players:GetPlayers()do self.Changed(p)end
            if self.IsHub then
                while not self.Closed do
                    local users={};for _,p in Players:GetPlayers()do users[p.UserId]=true end
                    pcall(function()self.Directory:Advertise(self.Metadata,users)end);task.wait(10)
                end
            end
        end)
    end
    do
        task.spawn(function()
            local renewAt=0
            while not self.Closed do
                local renew=os.clock()&gt;=renewAt;if renew then renewAt=os.clock()+10 end
                if next(self.Tokens)then pcall(function()self.Core:Pump()end)end
                for player,token in self.Tokens do
                    if player.Parent and not self.Connections[player]then
                        local ok,assignment=pcall(function()
                            if renew and not self.Core:Renew(player.UserId,token)then self.Tokens[player]=nil;self.Notify(player,'Your search expired. Start a new search.');self.Changed(player);return nil end
                            return self.Core:Assignment(player.UserId,token)
                        end)
                        if ok and assignment then self:Connect(player,assignment)end
                    end
                end
                task.wait(2)
            end
        end)
    end
    task.spawn(function()
        while not self.Closed do
            for player,c in self.Connections do
                if c.InFlight and c.SentAt and os.clock()-c.SentAt&gt;30 then c.InFlight=false;c.NextAttempt=os.clock()end
                if player.Parent and not c.InFlight and os.clock()&gt;=c.NextAttempt then self:Attempt(player,c)end
            end
            task.wait(1)
        end
    end)
    game:BindToClose(function()self.Closed=true;for p,token in self.Tokens do pcall(function()self.Core:Cancel(p.UserId,token)end)end end)
    return self
end
function Network:Status(player)
    return self.Tokens[player]~=nil,self.Connections[player]~=nil
end
function Network:Attempt(player,c)
    if c.Attempts&gt;=5 then
        self.Connections[player]=nil;self.Notify(player,'Could not connect. Retry the connection or return to the lobby.');self.Changed(player);return
    end
    c.Attempts+=1;c.InFlight=true;c.SentAt=os.clock()
    local ok=pcall(function()Teleport:TeleportAsync(game.PlaceId,{player},c.Options)end)
    if not ok then c.InFlight=false;c.NextAttempt=os.clock()+3 end
end
function Network:Connect(player,assignment)
    if self.Connections[player]then return end
    local options=Instance.new('TeleportOptions');options.ReservedServerAccessCode=assignment.AccessCode
    local c={Options=options,Attempts=0,InFlight=false,NextAttempt=0};self.Connections[player]=c
    self.Notify(player,'Match ready. Connecting to a dedicated server…');self.Changed(player);self:Attempt(player,c)
end
function Network:Join(player,profile,mode)
    if self.Reserved and not self.IsHub then return false,'Return to the lobby to find a new match.'end
    if self.Connections[player]then return false,'Already connecting to a match.'end
    if self.Tokens[player]then
        local ok,assignment=pcall(function()return self.Core:Assignment(player.UserId,self.Tokens[player])end)
        if ok and assignment then self:Connect(player,assignment);return true,'Retrying the connection.'end
        return true,'Finding an opponent across all lobbies…'
    end
    local ok,token=pcall(function()return self.Core:Join(player.UserId,game.JobId,profile,mode)end)
    if not ok then return false,'Matchmaking is temporarily unavailable. Please try again.'end
    self.QueueMode= self.QueueMode or {};self.QueueMode[player]=mode=='Ranked'and 'Ranked'or 'PvP'
    self.Tokens[player]=token;self.Changed(player);return true,'Finding an opponent across all lobbies…'
end
function Network:Cancel(player)
    if self.Connections[player]then return false,'Your match is ready. Connecting…'end
    local token=self.Tokens[player];if not token then return true,'Search cancelled.'end
    local ok,cancelled=pcall(function()return self.Core:Cancel(player.UserId,token)end)
    if ok and cancelled then self.Tokens[player]=nil;self.Changed(player);return true,'Search cancelled.'end
    return false,'Opponent found. Waiting for the connection.'
end
function Network:Solo(player,definition,mapId,difficulty)
    if self.Reserved and not self.IsHub then return false,'Return to the lobby for a new match.'end
    if self.Connections[player]then return false,'Already connecting to a match.'end
    local cancelled,message=self:Cancel(player);if not cancelled then return false,message end
    self.Connections[player]={Attempts=0,InFlight=true,NextAttempt=math.huge}
    self.Changed(player)
    local ok,assignment=pcall(function()return self.Core:Solo(player.UserId,definition,mapId,difficulty)end)
    self.Connections[player]=nil
    if not ok then self.Changed(player);return false,'Could not create the match server. Please try again.'end
    self:Connect(player,assignment);return true,'Connecting to an AI match…'
end
function Network:EnterLobby(player,level)
    if self.Studio then return true end
    if self.Connections[player]then return true end
    self.Connections[player]={Attempts=0,InFlight=true,NextAttempt=math.huge};self.Changed(player)
    task.spawn(function()
        local assignment
        for _=1,5 do
            local ok,value=pcall(function()return self.Directory:Find(level,player.UserId)end)
            if ok and value then assignment=value;break end
            task.wait(2)
        end
        self.Connections[player]=nil
        if not player.Parent then return end
        if assignment then self:Connect(player,assignment)else self.Notify(player,'The lobby is temporarily unavailable. You can retry.');self.Changed(player)end
    end)
    return true
end
function Network:EnsureLobby(player,profile)
    if not self.Studio and profile and (not self.Reserved or self.IsHub and self.Metadata.Band~=Progression.Band(profile.Level))then return self:EnterLobby(player,profile.Level)end
    return false
end
function Network:Return(player,level)
    self.Tokens[player]=nil
    return self:EnterLobby(player,level or 1)
end
function Network:Remove(player)
    local token=self.Tokens[player]
    if token and not self.Connections[player]then pcall(function()self.Core:Cancel(player.UserId,token)end)end
    self.Tokens[player]=nil;self.Connections[player]=nil
end
return Network
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSkinStyles"><Properties><string name="Name">SkinStyles</string><ProtectedString name="Source">local S={Items={{Id="Default",Name="Standard Army",Price=0,Cloth="#704E38",Armor="#ADAB9C",Trim="#B69159",Motif="cross"},{Id="Veteran",Name="Veterans",Cloth="#526347",Armor="#7D8780",Trim="#B88445",Motif="harness",Price=400,ChestOnly=false},{Id="Royal",Name="Royal Guard",Cloth="#ECE3C3",Armor="#CBD3D7",Trim="#DAB053",Motif="crown",Price=800,ChestOnly=false},{Id="Dark",Name="Dark Knights",Cloth="#342F45",Armor="#414D60",Trim="#B1ADB9",Motif="raven",Price=1200,ChestOnly=false},{Id="Forest",Name="Forest Wardens",Cloth="#355942",Armor="#879B72",Trim="#D0AF74",Motif="leaf",Price=0,ChestOnly=true},{Id="Sun",Name="Order of the Sun",Cloth="#A95330",Armor="#D7C8A0",Trim="#E5B54C",Motif="sun",Price=0,ChestOnly=true},{Id="Moon",Name="Moon Watch",Cloth="#454B76",Armor="#A7B3CB",Trim="#D1CFEB",Motif="moon",Price=0,ChestOnly=true},{Id="Frost",Name="Frost Guard",Cloth="#66A5B2",Armor="#CCE4E5",Trim="#89C7DC",Motif="ice",Price=0,ChestOnly=true},{Id="Ember",Name="Ashen Legion",Cloth="#733928",Armor="#595052",Trim="#E8944E",Motif="flame",Price=0,ChestOnly=true},{Id="Grove",Name="Oak Guard",Cloth="#6C7744",Armor="#9B9A72",Trim="#A57C4C",Motif="antler",Price=0,ChestOnly=true},{Id="Storm",Name="Storm Knights",Cloth="#3D6479",Armor="#9AB4C4",Trim="#EBD172",Motif="bolt",Price=0,ChestOnly=true},{Id="Iron",Name="Iron Bastion",Cloth="#68635B",Armor="#7C8587",Trim="#C6B39A",Motif="rivets",Price=0,ChestOnly=true},{Id="Rose",Name="Order of the Rose",Cloth="#86495D",Armor="#CDC1B8",Trim="#E5AA99",Motif="rose",Price=0,ChestOnly=true},{Id="Sapphire",Name="Sapphire Crown",Cloth="#294D79",Armor="#ADBCCF",Trim="#D4C2A3",Motif="gem",Price=0,ChestOnly=true},{Id="Amber",Name="Amber Guard",Cloth="#95663B",Armor="#AC9A80",Trim="#E8B450",Motif="amber",Price=0,ChestOnly=true},{Id="Raven",Name="Raven Cloaks",Cloth="#34383F",Armor="#6C7886",Trim="#B8BEC6",Motif="feathers",Price=0,ChestOnly=true},{Id="Lion",Name="Lion Guard",Cloth="#8A3C33",Armor="#C8B494",Trim="#E0BC59",Motif="lion",Price=0,ChestOnly=true},{Id="Griffin",Name="Griffin Wardens",Cloth="#667986",Armor="#D7D5C5",Trim="#D6AD66",Motif="wings",Price=0,ChestOnly=true},{Id="Dragon",Name="Dragon Order",Cloth="#506452",Armor="#738780",Trim="#C09851",Motif="scales",Price=0,ChestOnly=true},{Id="Rune",Name="Rune Keepers",Cloth="#5B5277",Armor="#939CAD",Trim="#C2B2D2",Motif="runes",Price=0,ChestOnly=true},{Id="Oracle",Name="Star Keepers",Cloth="#605482",Armor="#C3B9CF",Trim="#E2CCA2",Motif="star",Price=0,ChestOnly=true},{Id="Crusader",Name="White Banners",Cloth="#DFD5BE",Armor="#B9C5CE",Trim="#AA8960",Motif="cross",Price=0,ChestOnly=true},{Id="Mariner",Name="Coastal Guard",Cloth="#3E6D74",Armor="#91A8A6",Trim="#D6B078",Motif="anchor",Price=0,ChestOnly=true},{Id="Nomad",Name="Steppe Riders",Cloth="#AB7950",Armor="#9E8D73",Trim="#DCCCA5",Motif="scarf",Price=0,ChestOnly=true},{Id="Stag",Name="Silver Stag",Cloth="#597067",Armor="#D4DCD2",Trim="#C4CFB7",Motif="stag",Price=0,ChestOnly=true}}}
S.Rarities={
    Default={Name='Starter',Color='#AEB7BC',Weight=0,Price=0,Refund=0},
    Common={Name='Common',Color='#AEB7BC',Weight=7200,Price=400,Refund=100},
    Rare={Name='Rare',Color='#66ABEB',Weight=3150,Price=800,Refund=150},
    Epic={Name='Epic',Color='#BC8BE4',Weight=1260,Price=1200,Refund=200},
    Mythic={Name='Mythic',Color='#E9BD61',Price=0,Refund=250},
}
local tiers={
    Common={'Veteran','Forest','Grove','Iron','Amber','Mariner','Nomad'},
    Rare={'Royal','Sun','Moon','Frost','Rose','Raven','Crusader','Stag'},
    Epic={'Dark','Ember','Sapphire','Lion','Griffin','Rune'},
}
local premium={Storm={Price=199,Weight=420,GamePassId=2006883740},Dragon={Price=399,Weight=252,GamePassId=2005989756},Oracle={Price=699,Weight=168,GamePassId=2005239786}}
for _,skin in S.Items do
    skin.Rarity='Default'
    for tier,ids in tiers do if table.find(ids,skin.Id)then skin.Rarity=tier;break end end
    local offer=premium[skin.Id]
    if offer then
        skin.Rarity='Mythic';skin.RobuxPrice=offer.Price;skin.Weight=offer.Weight
        -- Permanent cosmetic passes for Frontier Kingdoms, universe 10769541065.
        skin.GamePassId=offer.GamePassId
    end
    local rarity=S.Rarities[skin.Rarity]
    skin.Price=rarity.Price;skin.Weight=skin.Weight or rarity.Weight;skin.DuplicateCoins=rarity.Refund
    skin.ChestOnly=false
end
S.Items[1].Name='Standard Set'
function S.Get(id)for _,v in S.Items do if v.Id==id then return v end end;return S.Items[1]end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXUI"><Properties><string name="Name">UI</string><ProtectedString name="Source">local UIS=game:GetService('UserInputService')
local UI={}
UI.Colors={Panel=Color3.fromRGB(24,35,42),Inset=Color3.fromRGB(40,54,59),Text=Color3.fromRGB(240,235,213),Muted=Color3.fromRGB(163,179,180),Gold=Color3.fromRGB(204,172,102),Blue=Color3.fromRGB(68,128,158),Line=Color3.fromRGB(76,94,97)}
local C=UI.Colors
local function corner(p,r)local x=Instance.new('UICorner');x.CornerRadius=UDim.new(0,r or 5);x.Parent=p end
local function border(p,color)local x=Instance.new('UIStroke');x.Color=color or C.Line;x.Transparency=.4;x.Thickness=1;x.Parent=p end
function UI.Frame(parent,name,size,pos,color)
    local f=Instance.new('Frame');f.Name=name;f.Size=size;f.Position=pos;f.BackgroundColor3=color or C.Panel;f.BorderSizePixel=0;f.Parent=parent;return f
end
function UI.Label(parent,name,text,size,pos,fontSize)
    local l=Instance.new('TextLabel');l.Name=name;l.Size=size;l.Position=pos;l.Text=text;l.TextColor3=C.Text;l.TextSize=fontSize or 14;l.Font=Enum.Font.Gotham;l.BackgroundTransparency=1;l.TextXAlignment=Enum.TextXAlignment.Left;l.Parent=parent;return l
end
function UI.Button(parent,name,text,size,pos,fn)
    local b=Instance.new('TextButton');b.Name=name;b.Size=size;b.Position=pos;b.Text=text;b.TextColor3=C.Text;b.TextSize=14;b.Font=Enum.Font.GothamMedium;b.BackgroundColor3=C.Inset;b.BorderSizePixel=0;b.Parent=parent;corner(b,5)
    b.Activated:Connect(function()
        if b.Active==false then return end
        if UI.PlaySound then UI.PlaySound('Click')end
        fn()
    end)
    return b
end
function UI.TextBox(parent,name,text,size,pos)
    local b=Instance.new('TextBox');b.Name=name;b.Size=size;b.Position=pos;b.Text=text;b.TextColor3=C.Text;b.TextSize=14;b.Font=Enum.Font.Gotham;b.BackgroundColor3=C.Inset;b.BorderSizePixel=0;b.ClearTextOnFocus=false;b.Parent=parent;corner(b,5);return b
end
function UI.Slider(parent,name,title,pos,initial,callback)
    local f=UI.Frame(parent,name,UDim2.new(1,0,0,55),pos);f.BackgroundTransparency=1
    local l=UI.Label(f,'Label',title,UDim2.new(1,-64,0,20),UDim2.fromOffset(0,0),13)
    local value=UI.Label(f,'Value','',UDim2.fromOffset(60,20),UDim2.new(1,-60,0,0),13);value.TextXAlignment=Enum.TextXAlignment.Right
    local hit=UI.Frame(f,'Hit',UDim2.new(1,0,0,32),UDim2.fromOffset(0,22));hit.BackgroundTransparency=1;hit.Active=true
    local track=UI.Frame(hit,'Track',UDim2.new(1,0,0,4),UDim2.new(0,0,.5,-2),C.Line);corner(track,2)
    local fill=UI.Frame(track,'Fill',UDim2.new(initial,0,1,0),UDim2.fromOffset(0,0),C.Gold);corner(fill,2)
    local thumb=UI.Frame(hit,'Thumb',UDim2.fromOffset(24,24),UDim2.new(initial,-12,.5,-12),C.Gold);corner(thumb,12);thumb.Active=true
    local input=nil
    local object={Frame=f,Hit=hit,Value=initial,Text=value}
    function object.Set(v)
        object.Value=math.clamp(v,0,1);fill.Size=UDim2.new(object.Value,0,1,0);local radius=thumb.Size.X.Offset/2;thumb.Position=UDim2.new(object.Value,-radius,.5,-radius);value.Text=math.floor(object.Value*100+.5)..'%'
    end
    local function change(x)object.Set((x-hit.AbsolutePosition.X)/hit.AbsoluteSize.X);callback(object.Value,false)end
    local function begin(i)if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then input=i;change(i.Position.X)end end
    hit.InputBegan:Connect(begin);thumb.InputBegan:Connect(begin)
    UIS.InputChanged:Connect(function(i)if input and (i==input or i.UserInputType==Enum.UserInputType.MouseMovement)then change(i.Position.X)end end)
    UIS.InputEnded:Connect(function(i)if input and (i==input or i.UserInputType==Enum.UserInputType.MouseButton1)then input=nil;callback(object.Value,true);if UI.PlaySound then UI.PlaySound('Click')end end end)
    object.Set(initial);return object
end
function UI.Build(player,hooks)
    local function call(k,...)if hooks[k] then hooks[k](...)end end
    local gui=Instance.new('ScreenGui');gui.Name='KingdomsUI';gui.AutoLocalize=false;gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.DisplayOrder=10;gui.Parent=player.PlayerGui
    local overlay=Instance.new('ScreenGui');overlay.Name='KingdomsOverlay';overlay.AutoLocalize=false;overlay.ResetOnSpawn=false;overlay.IgnoreGuiInset=true;overlay.ScreenInsets=Enum.ScreenInsets.None;overlay.ClipToDeviceSafeArea=false;overlay.DisplayOrder=20;overlay.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;overlay.Parent=player.PlayerGui
    local u={Gui=gui,Overlay=overlay,Page='Main'}
    local hud=UI.Frame(gui,'HUD',UDim2.fromScale(1,1),UDim2.fromScale(0,0));hud.BackgroundTransparency=1;hud.Visible=false;u.HUD=hud
    u.MenuButton=UI.Button(hud,'Menu','',UDim2.fromOffset(44,44),UDim2.fromOffset(12,10),function()call('Menu')end)
    for i=1,3 do UI.Frame(u.MenuButton,'Line'..i,UDim2.fromOffset(22,2),UDim2.fromOffset(11,12+i*6),C.Text)end
    local info=UI.Frame(hud,'Information',UDim2.fromOffset(220,104),UDim2.new(0,12,1,-116));corner(info);border(info);info.Active=true;u.Information=info
    u.Summary=UI.Label(info,'Summary','',UDim2.new(1,-24,1,-16),UDim2.fromOffset(12,8),14);u.Summary.TextWrapped=true;u.Summary.TextYAlignment=Enum.TextYAlignment.Center
    u.InfoToggle=UI.Button(hud,'Info','i',UDim2.fromOffset(44,44),UDim2.new(0,12,1,-56),function()call('Info')end);u.InfoToggle.TextSize=22;u.InfoExpanded=false
    local toast=UI.Frame(gui,'Feedback',UDim2.fromOffset(420,34),UDim2.new(.5,-210,0,64));corner(toast);toast.Visible=false
    u.Toast=toast;u.ToastText=UI.Label(toast,'Text','',UDim2.new(1,-20,1,0),UDim2.fromOffset(10,0),12);u.ToastText.TextXAlignment=Enum.TextXAlignment.Center;u.ToastText.TextWrapped=true
    local panel=UI.Frame(gui,'Orders',UDim2.fromOffset(310,192),UDim2.new(0,16,1,-208));corner(panel);border(panel);panel.Visible=false;panel.Active=true;u.Panel=panel
    u.Building=UI.Label(panel,'Building','',UDim2.new(1,-58,0,24),UDim2.fromOffset(12,9),16);u.Building.Font=Enum.Font.GothamMedium
    u.CloseSelection=UI.Button(panel,'Close','×',UDim2.fromOffset(30,28),UDim2.new(1,-40,0,7),function()call('Deselect')end)
    u.Roster={}
    for i,name in {'Peasant','Defender','Archer','Runner'} do u.Roster[name]=UI.Label(panel,name,'',UDim2.new(.5,-16,0,22),UDim2.new((i-1)%2*.5,12,0,37+math.floor((i-1)/2)*24),12)end
    u.Percent=UI.Slider(panel,'Slider','Send',UDim2.fromOffset(12,88),.5,function(v)call('Percent',math.floor(v*100+.5))end);u.Percent.Frame.Size=UDim2.new(1,-24,0,47)
    local dock=UI.Frame(gui,'SendPercentage',UDim2.fromOffset(600,88),UDim2.new(.5,-300,1,-100));corner(dock);border(dock);dock.Active=true;dock.Visible=false;u.Dock=dock
    u.Upgrade=UI.Button(panel,'Upgrade','Upgrade · 50 troops',UDim2.new(1,-24,0,40),UDim2.fromOffset(12,142),function()call('Upgrade')end)
    u.TouchOrder=UI.Button(panel,'Order','Order →',UDim2.fromOffset(98,28),UDim2.new(1,-138,0,7),function()call('TouchOrder')end);u.TouchOrder.Visible=UIS.TouchEnabled
    local selection=UI.Frame(gui,'SelectionBox',UDim2.fromOffset(0,0),UDim2.fromOffset(0,0),C.Blue);selection.BackgroundTransparency=.85;border(selection,C.Gold);selection.Visible=false;u.SelectionBox=selection
    toast.Parent=overlay;toast.ZIndex=20
    local menu=UI.Frame(overlay,'Menu',UDim2.fromScale(1,1),UDim2.fromScale(0,0));menu.BackgroundTransparency=.25;menu.Active=true;u.Menu=menu
    local card=UI.Frame(menu,'Card',UDim2.fromOffset(420,378),UDim2.new(.5,-210,.5,-189));corner(card,10);border(card,C.Gold);u.Card=card
    u.Title=UI.Label(card,'Title','Frontier\nKingdoms',UDim2.new(1,-40,0,68),UDim2.fromOffset(20,18),29);u.Title.Font=Enum.Font.GothamMedium
    local divider=UI.Frame(card,'Divider',UDim2.new(1,-40,0,1),UDim2.fromOffset(20,87),C.Gold);divider.BackgroundTransparency=.45;u.Divider=divider
    local main=UI.Frame(card,'Main',UDim2.new(1,-40,1,-108),UDim2.fromOffset(20,96));main.BackgroundTransparency=1;u.Main=main
    local buttons={}
    buttons[1]=UI.Button(main,'Play','Play',UDim2.new(1,0,0,44),UDim2.fromOffset(0,0),function()call('Play')end);buttons[1].BackgroundColor3=C.Blue
    buttons[2]=UI.Button(main,'Editor','Map Editor',UDim2.new(1,0,0,44),UDim2.fromOffset(0,94),function()call('Editor')end)
    buttons[3]=UI.Button(main,'Settings','Settings',UDim2.new(1,0,0,44),UDim2.fromOffset(0,146),function()call('Settings')end)
    u.MainButtons=buttons;u.Play=buttons[1];u.EditorButton=buttons[2]
    u.Return=UI.Button(main,'Return','End Match &amp; Exit',UDim2.new(1,0,0,34),UDim2.fromOffset(0,248),function()call('Return')end);u.Return.Visible=false
    u.Result=UI.Label(card,'Result','Loading models…',UDim2.new(1,-40,0,22),UDim2.new(0,20,1,-30),11);u.Result.TextColor3=C.Muted
    local dif=UI.Frame(card,'Difficulties',UDim2.new(1,-40,1,-110),UDim2.fromOffset(20,80));dif.BackgroundTransparency=1;dif.Visible=false;u.Difficulties=dif
    u.MapChoice=UI.Button(dif,'Map','Map: Two Crossings  ▾',UDim2.new(1,0,0,34),UDim2.fromOffset(0,0),function()call('MapChoice')end);u.MapChoice.TextSize=13
    local modes=UI.Frame(card,'Modes',UDim2.new(1,-40,1,-110),UDim2.fromOffset(20,96));modes.BackgroundTransparency=1;modes.Visible=false;u.Modes=modes
    UI.Button(modes,'AI','Vs AI',UDim2.new(1,0,0,48),UDim2.fromOffset(0,0),function()call('AI')end).BackgroundColor3=C.Blue
    u.Online=UI.Button(modes,'Player','PvP · 1v1',UDim2.new(1,0,0,48),UDim2.fromOffset(0,60),function()call('Online')end)
    u.QueueStatus=UI.Label(modes,'Status','PvP matches use a random map.',UDim2.new(1,0,0,46),UDim2.fromOffset(0,120),12);u.QueueStatus.TextWrapped=true;u.QueueStatus.TextColor3=C.Muted
    UI.Button(modes,'Back','Back',UDim2.new(1,0,0,38),UDim2.fromOffset(0,180),function()call('Back')end)
    local maps=Instance.new('ScrollingFrame');maps.Name='Maps';maps.Size=UDim2.new(1,-40,1,-110);maps.Position=UDim2.fromOffset(20,96);maps.BackgroundTransparency=1;maps.BorderSizePixel=0;maps.ScrollBarThickness=3;maps.CanvasSize=UDim2.fromOffset(0,300);maps.Visible=false;maps.Parent=card;u.Maps=maps
    u.MapButtons={}
    for i,pair in {{'TwoBridges','Two Crossings'},{'LandFrontiers','Land Frontiers'},{'RiverPass','River Pass'},{'Random','Random Map'},{'Custom','Saved Map'}}do
        u.MapButtons[pair[1]]=UI.Button(maps,pair[1],pair[2],UDim2.new(1,-6,0,40),UDim2.fromOffset(0,(i-1)*48),function()call('SelectMap',pair[1])end)
    end
    UI.Button(maps,'Back','Back',UDim2.new(1,-6,0,36),UDim2.fromOffset(0,244),function()call('Back')end)
    for i,pair in {{'Easy','Easy'},{'Normal','Normal'},{'Hard','Hard'}}do
        local b=UI.Button(dif,pair[1],pair[2],UDim2.new(1,0,0,48),UDim2.fromOffset(0,(i-1)*58),function()call('Start',pair[1])end);if pair[1]=='Hard'then b.BackgroundColor3=C.Blue end
    end
    UI.Button(dif,'Back','Back',UDim2.new(1,0,0,38),UDim2.fromOffset(0,181),function()call('Back')end)
    local settings=Instance.new('ScrollingFrame');settings.Name='Settings';settings.Size=UDim2.new(1,-40,1,-94);settings.Position=UDim2.fromOffset(20,76);settings.BackgroundTransparency=1;settings.BorderSizePixel=0;settings.ScrollBarThickness=3;settings.CanvasSize=UDim2.fromOffset(0,395);settings.Visible=false;settings.Parent=card;u.Settings=settings
    u.Music=UI.Slider(settings,'Music','Music Volume',UDim2.fromOffset(0,0),.22,function(v,done)call('Music',v,done)end)
    u.Effects=UI.Slider(settings,'Effects','Sound Effects Volume',UDim2.fromOffset(0,66),.55,function(v,done)call('Effects',v,done)end)
    u.Camera=UI.Slider(settings,'Camera','Camera Speed',UDim2.fromOffset(0,132),1/3,function(v,done)call('Camera',.5+v*1.5,done)end)
    u.Zoom=UI.Slider(settings,'Zoom','Zoom Speed',UDim2.fromOffset(0,198),1/3,function(v,done)call('Zoom',.5+v*1.5,done)end)
    u.Grid=UI.Button(settings,'Grid','Grid: Off',UDim2.new(1,0,0,40),UDim2.fromOffset(0,269),function()call('Grid')end)
    u.Labels=UI.Button(settings,'Labels','Building Counts: On',UDim2.new(1,0,0,40),UDim2.fromOffset(0,318),function()call('Labels')end)
    UI.Button(settings,'Back','Done',UDim2.new(1,0,0,40),UDim2.fromOffset(0,367),function()call('Back')end)
    UI.Button(settings,'BattleGuide','Replay Battle Guide',UDim2.new(1,0,0,40),UDim2.fromOffset(0,416),function()call('BattleGuideReplay')end)
    local credits=UI.Label(settings,'Credits','Original music: Frontier Dawn / March of the Banners\nOriginal game sound effects\nFallback audio: APM Music · Creator Store / 0FFZ3TI',UDim2.new(1,0,0,48),UDim2.fromOffset(0,466),10);credits.TextColor3=C.Muted;credits.TextWrapped=true;settings.CanvasSize=UDim2.fromOffset(0,522)
    local editor=UI.Frame(gui,'Editor',UDim2.fromScale(1,1),UDim2.fromScale(0,0));editor.BackgroundTransparency=1;editor.Visible=false;u.Editor=editor
    local toolbar=UI.Frame(editor,'Toolbar',UDim2.new(1,-24,0,98),UDim2.fromOffset(12,10));corner(toolbar);border(toolbar);toolbar.Active=true
    u.MapName=UI.TextBox(toolbar,'Name','My Map',UDim2.new(1,-274,0,36),UDim2.fromOffset(10,8));u.MapName.TextXAlignment=Enum.TextXAlignment.Left
    UI.Button(toolbar,'Save','Save',UDim2.fromOffset(84,36),UDim2.new(1,-254,0,8),function()call('SaveMap')end)
    UI.Button(toolbar,'Test','Play',UDim2.fromOffset(78,36),UDim2.new(1,-162,0,8),function()call('TestMap')end).BackgroundColor3=C.Blue
    UI.Button(toolbar,'Back','Menu',UDim2.fromOffset(66,36),UDim2.new(1,-76,0,8),function()call('ExitEditor')end)
    local tools=Instance.new('ScrollingFrame');tools.Name='Tools';tools.Active=true;tools.Size=UDim2.new(1,-20,0,42);tools.Position=UDim2.fromOffset(10,50);tools.BackgroundTransparency=1;tools.BorderSizePixel=0;tools.ScrollBarThickness=2;tools.ScrollingDirection=Enum.ScrollingDirection.X;tools.CanvasSize=UDim2.fromOffset(780,0);tools.Parent=toolbar
    local x=0
    for _,pair in {{'Road','Roads',82},{'Move','Move',92},{'Erase','Delete',82},{'Owner','Team: Blue',142},{'River','River: On',106},{'New','New',72},{'Undo','Undo',78},{'Export','Map Code',88},{'Import','Import',88}}do
        local b=UI.Button(tools,pair[1],pair[2],UDim2.fromOffset(pair[3],36),UDim2.fromOffset(x,0),function()call('EditorTool',pair[1])end);x+=pair[3]+6;if pair[1]=='Owner'then u.Owner=b end
    end
    local palette=UI.Frame(editor,'Palette',UDim2.new(1,-24,0,86),UDim2.new(0,12,1,-98));corner(palette);border(palette);palette.Active=true;u.Palette=palette
    u.EditorHint=UI.Label(palette,'Hint','',UDim2.new(1,-20,0,23),UDim2.fromOffset(10,4),12);u.EditorHint.TextColor3=C.Gold
    local scroll=Instance.new('ScrollingFrame');scroll.Name='Buildings';scroll.Active=true;scroll.Size=UDim2.new(1,-20,0,50);scroll.Position=UDim2.fromOffset(10,29);scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.ScrollBarThickness=2;scroll.ScrollingDirection=Enum.ScrollingDirection.X;scroll.CanvasSize=UDim2.fromOffset(808,0);scroll.Parent=palette
    u.KindButtons={}
    for i,pair in {{'Castle','Castle'},{'Village','Village'},{'Barracks','Barracks'},{'Archery','Archery Range'},{'Camp','Camp'},{'Tower','Tower'},{'Farm','Farm'},{'Junction','Road Junction'}}do
        u.KindButtons[pair[1]]=UI.Button(scroll,pair[1],pair[2],UDim2.fromOffset(94,42),UDim2.fromOffset((i-1)*101,0),function()call('EditorKind',pair[1])end);u.KindButtons[pair[1]].TextSize=12
    end
    local code=UI.Frame(overlay,'MapCode',UDim2.fromScale(1,1),UDim2.fromScale(0,0));code.BackgroundTransparency=.18;code.Visible=false;code.Active=true;u.Code=code
    local codeCard=UI.Frame(code,'Card',UDim2.fromOffset(600,340),UDim2.new(.5,-300,.5,-170));corner(codeCard);border(codeCard);u.CodeCard=codeCard
    u.CodeTitle=UI.Label(codeCard,'Title','Map Code',UDim2.new(1,-30,0,28),UDim2.fromOffset(15,12),19)
    u.CodeHint=UI.Label(codeCard,'Hint','',UDim2.new(1,-30,0,40),UDim2.fromOffset(15,47),12);u.CodeHint.TextWrapped=true
